#!/usr/bin/env python3
"""One-command installer for Longhand (`tools/install`).

Idempotent setup, on Omarchy:
  1. Symlinks CLI helpers into ~/.local/bin (pomo, longhand-agent,
     longhand-check, longhand-read, longhand-doctor).
  2. Copies config.example.json to ~/.config/longhand/config.json if absent.
  3. Installs desktop entry & icon for the app launcher.
  4. Runs tools/install-plugins (passing --restart if requested).
  5. Runs `longhand-agent install` if config.json points at an existing vault.
  6. Runs tools/doctor to verify the installation.

On Windows (`python tools\\install`), the same steps as Windows has them:
  1. A Python of Longhand's own (the repo's .venv, made if absent; or the
     virtual environment this runs in), and `pip install -e windows` into
     it: PySide6, and the commands as .exe files beside its python.exe.
  2. The config, as above.
  3. `longhand install`: the Start menu entry, and Longhand started with the
     session (`--no-autostart` leaves that out).
  4. (Omarchy's shell plugins: nothing; the page's host stands in for them.)
  5. `longhand-agent install`, as above.
  6. The doctor; `--tools` then installs with winget what it found missing
     (pandoc, MiKTeX, poppler, gitleaks, Node), and says the rest.

`--vault PATH` writes the vault into a config this makes (never into one
that is there).
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
WINDOWS = os.name == "nt"

# What the doctor names as missing, and the winget package that brings it
# (README → Windows, windows/README.md). tesseract and qpdf have none that
# brings them whole: said, not installed.
WINGET = {
    "pandoc": "JohnMacFarlane.Pandoc",
    "xelatex": "MiKTeX.MiKTeX",
    "pdftotext": "oschwartz10612.Poppler",
    "pdfinfo": "oschwartz10612.Poppler",
    "pdftoppm": "oschwartz10612.Poppler",
    "gitleaks": "Gitleaks.Gitleaks",
    "node": "OpenJS.NodeJS.LTS",
}


def link(src: pathlib.Path, dst: pathlib.Path) -> None:
    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.is_symlink() or dst.exists():
        if dst.is_symlink() and dst.resolve() == src.resolve():
            return
        dst.unlink()
    dst.symlink_to(src)
    print(f"linked {dst} → {src}")


def scaffold_config(cfg_path: pathlib.Path, vault: str) -> None:
    """config.example.json, if there is no config; with the vault given."""
    if cfg_path.exists():
        if vault:
            print(f"{cfg_path} is there already: \"vault\" left as it is")
        return
    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    if vault:
        cfg = json.loads((ROOT / "config.example.json").read_text(encoding="utf-8"))
        # Written with "/": the page and the agent read a path that way on
        # every system (windows/README.md, "Your own vault").
        cfg["vault"] = pathlib.Path(os.path.expanduser(vault)).resolve().as_posix()
        cfg_path.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        print(f"created {cfg_path}, the vault {cfg['vault']}")
    else:
        shutil.copy2(ROOT / "config.example.json", cfg_path)
        print(f"created {cfg_path} — edit \"vault\" to point at your Obsidian folder")


def agent_install(cfg_path: pathlib.Path, python: str, env: dict | None = None) -> None:
    """`longhand-agent install`, when the config's vault is there."""
    try:
        cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
        vault = pathlib.Path(os.path.expanduser(str(cfg.get("vault") or "")))
        if vault.is_dir():
            subprocess.run([python, str(ROOT / "agent" / "longhand-agent"), "install"], check=False, env=env)
        else:
            print(f"the vault in {cfg_path} is not there yet: `longhand-agent install` once it is")
    except (OSError, ValueError):
        pass


def omarchy(args) -> int:
    home = pathlib.Path.home()
    xdg_cfg = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    xdg_data = pathlib.Path(os.environ.get("XDG_DATA_HOME") or home / ".local" / "share")
    bindir = home / ".local" / "bin"

    # 1. CLI helpers
    for dst_name, rel in (
        ("pomo", "cli/pomo"),
        ("longhand-agent", "agent/longhand-agent"),
        ("longhand-check", "cli/longhand-check"),
        ("longhand-read", "cli/longhand-read"),
        ("longhand-doctor", "tools/doctor"),
    ):
        link(ROOT / rel, bindir / dst_name)

    # 2. Config scaffold (never overwrites existing config.json)
    cfg_path = xdg_cfg / "longhand" / "config.json"
    scaffold_config(cfg_path, args.vault)

    # 3. App launcher entry & icon
    link(ROOT / "launcher" / "longhand.desktop", xdg_data / "applications" / "longhand.desktop")
    link(ROOT / "launcher" / "longhand.svg", xdg_data / "icons" / "hicolor" / "scalable" / "apps" / "longhand.svg")

    # 4. Omarchy shell plugins
    cmd = [sys.executable, str(ROOT / "tools" / "install-plugins")]
    if args.restart:
        cmd.append("--restart")
    subprocess.run(cmd, check=True)

    # 5. Scaffold vault & agent prompts if vault already exists
    agent_install(cfg_path, sys.executable)

    # 6. Health check
    print("\n--- longhand doctor ---")
    r = subprocess.run([sys.executable, str(ROOT / "tools" / "doctor")])
    return r.returncode


def in_venv() -> bool:
    return sys.prefix != getattr(sys, "base_prefix", sys.prefix)


def windows(args) -> int:
    # Said in UTF-8 whatever the console's code page ("→" stopped a first
    # run whose output went into a pipe).
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(encoding="utf-8", errors="replace")
    # 1. A Python of Longhand's own: this one when it is a virtual
    # environment, else the repo's .venv (made when absent), and the
    # install run again from there.
    if not in_venv():
        venv = ROOT / ".venv"
        python = venv / "Scripts" / "python.exe"
        if not python.is_file():
            print(f"making {venv}")
            subprocess.run([sys.executable, "-m", "venv", str(venv)], check=True)
        return subprocess.call([str(python), str(pathlib.Path(__file__).resolve()), *sys.argv[1:]])
    print(f"pip install -e windows → {pathlib.Path(sys.executable).parent}")
    r = subprocess.run([sys.executable, "-m", "pip", "install", "--quiet", "-e", str(ROOT / "windows")])
    if r.returncode != 0:
        print("pip install failed: Longhand's commands are not there")
        return r.returncode
    scripts = pathlib.Path(sys.executable).parent
    # What the launchers give every script they start (longhand_launch.py):
    # the stand-ins on Python's path, UTF-8.
    old = os.environ.get("PYTHONPATH", "")
    env = dict(os.environ, PYTHONUTF8="1", PYTHONIOENCODING="utf-8",
               PYTHONPATH=str(ROOT / "windows" / "pyshim") + (os.pathsep + old if old else ""),
               PATH=str(scripts) + os.pathsep + os.environ.get("PATH", ""))

    # 2. Config scaffold (never overwrites existing config.json)
    xdg_cfg = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config")
    cfg_path = xdg_cfg / "longhand" / "config.json"
    scaffold_config(cfg_path, args.vault)

    # 3. The Start menu, and the start with the session
    sys.path.insert(0, str(ROOT / "windows"))
    import shortcuts
    shortcuts.install(with_autostart=not args.no_autostart)

    # 5. Scaffold vault & agent prompts if vault already exists
    agent_install(cfg_path, sys.executable, env)

    # 6. Health check, and what it found missing
    print("\n--- longhand doctor ---")
    r = subprocess.run([sys.executable, str(ROOT / "tools" / "doctor")], env=env, capture_output=True,
                       text=True, encoding="utf-8", errors="replace")
    print(r.stdout, end="")
    missing = [line.split()[1].split(":", 1)[1] for line in r.stdout.splitlines()
               if line.startswith("WARN") and line.split()[1].startswith("optional:")]
    if not shutil.which("node", path=env["PATH"]):
        missing.append("node")
    packages = list(dict.fromkeys(WINGET[m] for m in missing if m in WINGET))
    unsaid = [m for m in missing if m not in WINGET]
    if packages and args.tools:
        for p in packages:
            print(f"\nwinget install {p}")
            subprocess.run(["winget", "install", "--id", p, "-e", "--silent",
                            "--accept-package-agreements", "--accept-source-agreements"], check=False)
        if "MiKTeX.MiKTeX" in packages:
            print("MiKTeX fetches the LaTeX packages an export needs by itself:")
            subprocess.run(["initexmf", "--set-config-value=[MPM]AutoInstall=1"], check=False)
        print("\nopen a new terminal for PATH to have them")
    elif packages:
        print("\nnot installed, and optional (`--tools` installs them):")
        for p in packages:
            print(f"  winget install {p}")
    if unsaid:
        print(f"no winget package brings {', '.join(unsaid)} (reading a scanned PDF): see their own sites")
    return r.returncode


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--vault", default="", help="the vault folder, written into a config this makes")
    if WINDOWS:
        ap.add_argument("--no-autostart", action="store_true", help="not started with the session")
        ap.add_argument("--tools", action="store_true", help="install the optional tools the doctor finds missing, with winget")
    else:
        ap.add_argument("--restart", action="store_true", help="restart omarchy-shell after installing plugins")
    args = ap.parse_args()
    return windows(args) if WINDOWS else omarchy(args)


if __name__ == "__main__":
    sys.exit(main())
