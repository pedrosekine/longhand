#!/usr/bin/env python3
"""Install Longhand's three plugins into the shell (2026-10-30).

Each plugin folder is copied to its place in ~/.config/omarchy/plugins, as
`cp -r` did, and the files the page and the popup share are put beside the
popup too: an Omarchy plugin is a folder of its own, and the plugin folder
refuses symlinks, so a file both read is a copy in each. The one kept in the
repo is the page's (SHARED below). Then each install is compared with the
repo, file by file.

Run: tools/install-plugins             copy, and say whether each install matches
     tools/install-plugins --restart   …then restart the shell (`omarchy restart shell`)
     tools/install-plugins --to DIR    into DIR instead of the shell's folder (the tests)
"""
import argparse
import filecmp
import os
import pathlib
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
PLUGINS = {                       # repo folder -> the shell's plugin id
    "plugin-page": "longhand.page",
    "plugin": "longhand.pomo",
    "plugin-deadline": "longhand.deadline",
}
# Files one plugin keeps and another reads too: repo folder -> [kept in the repo at].
SHARED = {
    "plugin-deadline": ["plugin-page/Store.js"],     # the deadline store, as the plugins read it
}
SKIP = shutil.ignore_patterns("__pycache__", "*.pyc")


def wanted(folder: str) -> dict:
    """What an install of `folder` holds: its path inside -> the repo file."""
    src = ROOT / folder
    out = {}
    for p in src.rglob("*"):
        if p.is_file() and "__pycache__" not in p.parts and p.suffix != ".pyc":
            out[p.relative_to(src).as_posix()] = p
    for rel in SHARED.get(folder, []):
        out[pathlib.Path(rel).name] = ROOT / rel
    return out


def install(dest: pathlib.Path) -> bool:
    ok = True
    for folder, pid in PLUGINS.items():
        to = dest / pid
        shutil.copytree(ROOT / folder, to, dirs_exist_ok=True, ignore=SKIP)
        for rel in SHARED.get(folder, []):
            shutil.copy2(ROOT / rel, to / pathlib.Path(rel).name)
        files = wanted(folder)
        differ = [k for k, v in sorted(files.items()) if not (to / k).is_file() or not filecmp.cmp(v, to / k, shallow=False)]
        print(f"{'same' if not differ else 'DIFFERS'}  {pid}  ({len(files)} files)" + (f": {', '.join(differ)}" if differ else ""))
        ok = ok and not differ
    return ok


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--to", type=pathlib.Path, help="install here instead of ~/.config/omarchy/plugins")
    ap.add_argument("--restart", action="store_true", help="restart the shell afterwards")
    a = ap.parse_args()
    home = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config")
    dest = a.to or home / "omarchy" / "plugins"
    dest.mkdir(parents=True, exist_ok=True)
    ok = install(dest)
    if ok and a.restart:
        subprocess.run(["omarchy", "restart", "shell"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("restarted the shell")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
