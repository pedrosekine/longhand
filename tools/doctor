#!/usr/bin/env python3
"""Health check for a Longhand installation (`tools/doctor` / `longhand-doctor`).

Read-only: inspects config.json, vault folders and daily template, CLI helpers
on PATH, Omarchy shell plugins, agent route binary, and optional PDF/search
tools, reporting a crisp checklist with actionable fixes.
"""
from __future__ import annotations

import json
import os
import pathlib
import shutil
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent


def _cfg_path() -> pathlib.Path:
    base = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config")
    return pathlib.Path(os.environ.get("LONGHAND_CONFIG") or base / "longhand" / "config.json")


def _bin_found(name: str, extra_path: str = "") -> str:
    if extra_path:
        p = pathlib.Path(os.path.expanduser(extra_path))
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
    found = shutil.which(name)
    if found:
        return found
    local = pathlib.Path.home() / ".local" / "bin" / name
    if local.is_file() and os.access(local, os.X_OK):
        return str(local)
    return ""


def diagnose() -> tuple[list[tuple[str, str, str]], bool]:
    """Return ([(status, label, detail)], ok) where status is ok|warn|fail."""
    rows: list[tuple[str, str, str]] = []
    cfg_p = _cfg_path()
    cfg: dict | None = None

    # 1. config.json
    if not cfg_p.is_file():
        rows.append(("fail", "config.json", f"missing at {cfg_p} — copy config.example.json or run tools/install"))
    else:
        try:
            cfg = json.loads(cfg_p.read_text())
            if not isinstance(cfg, dict) or not cfg.get("vault") or not (cfg.get("daily") or {}).get("dir"):
                rows.append(("fail", "config.json", f"{cfg_p} needs \"vault\" and \"daily.dir\""))
                cfg = None
            else:
                rows.append(("ok", "config.json", str(cfg_p)))
        except (OSError, ValueError) as e:
            rows.append(("fail", "config.json", f"invalid JSON at {cfg_p}: {e}"))

    # 2. Vault, daily folder, daily template
    if cfg is not None:
        vault = pathlib.Path(os.path.expanduser(str(cfg["vault"])))
        if not vault.is_dir():
            rows.append(("fail", "vault", f"folder not found: {vault} — update \"vault\" in {cfg_p}"))
        else:
            rows.append(("ok", "vault", str(vault)))
            daily_dir = vault / str(cfg["daily"]["dir"]).strip("/")
            if daily_dir.is_dir():
                rows.append(("ok", "daily folder", str(daily_dir)))
            else:
                rows.append(("warn", "daily folder", f"missing: {daily_dir} — run `longhand-agent install`"))
            tpl = str((cfg.get("daily") or {}).get("template") or "").strip("/")
            if tpl:
                tpl_p = vault / (tpl if tpl.endswith(".md") else tpl + ".md")
                if tpl_p.is_file():
                    rows.append(("ok", "daily template", str(tpl_p)))
                else:
                    rows.append(("warn", "daily template", f"missing: {tpl_p} — run `longhand-agent install`"))

    # 3. Required CLI helpers
    runner_cfg = str((cfg or {}).get("runner") or "")
    read_cfg = str((cfg or {}).get("read") or "")
    for name, custom in (
        ("pomo", ""),
        ("longhand-agent", runner_cfg),
        ("longhand-check", str((cfg or {}).get("check") or "")),
        ("longhand-read", read_cfg),
    ):
        found = _bin_found(name, custom)
        if found:
            rows.append(("ok", f"cli:{name}", found))
        else:
            rows.append(("fail", f"cli:{name}", f"not on PATH or ~/.local/bin — run tools/install"))

    # 4. Agent route binary (based on configured model)
    model = str((cfg or {}).get("model") or "")
    route_bin = (
        "claude" if model.startswith("claude-code/")
        else "codex" if model.startswith("codex/")
        else "antigravity" if model.startswith("antigravity/")
        else "opencode"
    )
    found_route = _bin_found(route_bin)
    if found_route:
        rows.append(("ok", f"model route ({route_bin})", f"{found_route}" + (f" for {model}" if model else "")))
    else:
        rows.append(("warn", f"model route ({route_bin})", f"{route_bin} not found on PATH (needed for agent replies)"))

    # 5. Omarchy plugins & shell.json
    xdg_cfg = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config")
    plugins_dir = xdg_cfg / "omarchy" / "plugins"
    missing_plugins = [pid for pid in ("longhand.page", "longhand.pomo", "longhand.deadline") if not (plugins_dir / pid).is_dir()]
    if not missing_plugins:
        rows.append(("ok", "omarchy plugins", str(plugins_dir)))
    else:
        rows.append(("warn", "omarchy plugins", f"missing {', '.join(missing_plugins)} — run `tools/install-plugins --restart`"))

    shell_json = xdg_cfg / "omarchy" / "shell.json"
    if shell_json.is_file():
        try:
            sh = json.loads(shell_json.read_text())
            # A plugin is switched on in plugins[], or by its widget standing
            # in the bar (bar.layout's left, center and right): the timer and
            # the deadlines are bar widgets, and are listed only there.
            ids = {p.get("id") for p in (sh.get("plugins") or []) if isinstance(p, dict)}
            layout = (sh.get("bar") or {}).get("layout") or {}
            for side in (layout.values() if isinstance(layout, dict) else []):
                ids |= {w.get("id") for w in (side if isinstance(side, list) else []) if isinstance(w, dict)}
            unlisted = [pid for pid in ("longhand.page", "longhand.pomo", "longhand.deadline") if pid not in ids]
            if not unlisted:
                rows.append(("ok", "shell.json", "all 3 plugins enabled"))
            else:
                rows.append(("warn", "shell.json", f"not in plugins[] nor in the bar's layout: {', '.join(unlisted)}"))
        except (OSError, ValueError):
            rows.append(("warn", "shell.json", f"could not parse {shell_json}"))

    # 6. Optional helpers
    for opt, why in (
        ("pandoc", "PDF export"),
        ("xelatex", "PDF export"),
        ("pdftotext", "PDF search & reading"),
        ("gitleaks", "secret scrubbing before agent search"),
    ):
        found = _bin_found(opt)
        if found:
            rows.append(("ok", f"optional:{opt}", found))
        else:
            rows.append(("warn", f"optional:{opt}", f"not installed (optional, used for {why})"))

    ok = not any(st == "fail" for st, _, _ in rows)
    return rows, ok


def main() -> int:
    rows, ok = diagnose()
    marks = {"ok": "ok  ", "warn": "WARN", "fail": "FAIL"}
    for st, label, detail in rows:
        print(f"{marks[st]} {label:22s} {detail}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
