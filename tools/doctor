#!/usr/bin/env python3
"""Health check for a Longhand installation (`tools/doctor` / `longhand-doctor`).

Read-only: inspects config.json, vault folders and daily template, CLI helpers
on PATH, the agent's model programs (model, fallbackModel, planModel), what
starts the page (Omarchy's shell plugins; on Windows the Start menu entry,
the session's start, and whether a new terminal finds the commands by name),
and optional PDF/search/OCR tools, reporting a crisp
checklist with actionable fixes.
"""
from __future__ import annotations

import json
import os
import pathlib
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
WINDOWS = os.name == "nt"
# Where the commands come from: tools/install links them into ~/.local/bin
# on Omarchy; on Windows `pip install -e windows` makes them as .exe files
# beside the Python the host runs on.
INSTALL = "`pip install -e windows` (from the repo, into Longhand's Python)" if WINDOWS else "tools/install"
PLUGINS = ("longhand.page", "longhand.pomo", "longhand.deadline")

# A model route: its prefix, the config key that can name its program, and
# the program's own name (longhand-agent's run_* start these).
ROUTES = (
    ("claude-code/", "claude", "claude"),
    ("codex/", "codex", "codex"),
    ("antigravity/", "antigravity", "agy"),
    ("", "opencode", "opencode"),
)
# What `longhand-agent install` puts where opencode reads its agents.
OPENCODE_AGENTS = ("longhand", "longhand-day", "longhand-plan", "longhand-judge")
# Where Antigravity (agy 1.5.16) keeps its Google sign-in on Windows: a
# generic credential of the Credential Manager (its log: "authenticated via
# keyring"), not a file in the home Longhand gives it.
AGY_CREDENTIAL = "gemini:antigravity"


def _cfg_path() -> pathlib.Path:
    base = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config")
    return pathlib.Path(os.environ.get("LONGHAND_CONFIG") or base / "longhand" / "config.json")


def _bin_found(name: str, extra_path: str = "", strict: bool = False) -> str:
    """Where a program is: the path the config gives (or the name it gives,
    on PATH), else `name` on PATH, else in ~/.local/bin. "" when nowhere.
    `strict`: what the config names is what is started, so only that."""
    if extra_path:
        p = pathlib.Path(os.path.expanduser(extra_path))
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
        if p.name == extra_path and shutil.which(extra_path):     # a program's name, not a path
            return shutil.which(extra_path) or ""
        if strict:
            return ""
    found = shutil.which(name)
    if found:
        return found
    beside = pathlib.Path(sys.executable).with_name(name + ".exe")    # where pip puts Longhand's .exe files
    if WINDOWS and beside.is_file():
        return str(beside)
    local = pathlib.Path.home() / ".local" / "bin" / name
    if local.is_file() and os.access(local, os.X_OK):
        return str(local)
    return ""


def _is_poppler(pdftotext: str) -> bool:
    """Whether a pdftotext is poppler's (the one whose -bbox-layout Longhand
    reads), not xpdf's: Git for Windows' shell carries xpdf's, and it can be
    found first. Unknown counts as poppler's."""
    try:
        r = subprocess.run([pdftotext, "-v"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return True
    said = (r.stdout + r.stderr).lower()
    return "poppler" in said or ("glyph & cog" not in said and "xpdf" not in said)


def diagnose() -> tuple[list[tuple[str, str, str]], bool]:
    """Return ([(status, label, detail)], ok) where status is ok|warn|fail."""
    rows: list[tuple[str, str, str]] = []
    cfg_p = _cfg_path()
    cfg: dict | None = None

    # 1. config.json
    if not cfg_p.is_file():
        rows.append(("fail", "config.json", f"missing at {cfg_p} — copy config.example.json"
                                            + ("" if WINDOWS else " or run tools/install")))
    else:
        try:
            cfg = json.loads(cfg_p.read_text(encoding="utf-8"))
            if not isinstance(cfg, dict) or not cfg.get("vault") or not (cfg.get("daily") or {}).get("dir"):
                rows.append(("fail", "config.json", f"{cfg_p} needs \"vault\" and \"daily.dir\""))
                cfg = None
            else:
                rows.append(("ok", "config.json", str(cfg_p)))
        except (OSError, ValueError) as e:
            rows.append(("fail", "config.json", f"invalid JSON at {cfg_p}: {e}"))

    # 2. Vault, daily folder, daily template
    if cfg is not None:
        vault = pathlib.Path(os.path.expanduser(str(cfg["vault"])))
        if not vault.is_dir():
            rows.append(("fail", "vault", f"folder not found: {vault} — update \"vault\" in {cfg_p}"))
        else:
            rows.append(("ok", "vault", str(vault)))
            daily_dir = vault / str(cfg["daily"]["dir"]).strip("/")
            if daily_dir.is_dir():
                rows.append(("ok", "daily folder", str(daily_dir)))
            else:
                rows.append(("warn", "daily folder", f"missing: {daily_dir} — run `longhand-agent install`"))
            tpl = str((cfg.get("daily") or {}).get("template") or "").strip("/")
            if tpl:
                tpl_p = vault / (tpl if tpl.endswith(".md") else tpl + ".md")
                if tpl_p.is_file():
                    rows.append(("ok", "daily template", str(tpl_p)))
                else:
                    rows.append(("warn", "daily template", f"missing: {tpl_p} — run `longhand-agent install`"))

    # 3. Required CLI helpers
    for name, custom in (
        ("pomo", ""),
        ("longhand-agent", str((cfg or {}).get("runner") or "")),
        ("longhand-check", str((cfg or {}).get("check") or "")),
        ("longhand-read", str((cfg or {}).get("read") or "")),
    ):
        found = _bin_found(name, custom)
        if found:
            rows.append(("ok", f"cli:{name}", found))
        else:
            where = "on PATH" if WINDOWS else "on PATH or ~/.local/bin"
            rows.append(("fail", f"cli:{name}", f"not {where} — run {INSTALL}"))

    # 4. The model programs: each route the config names (the model, its
    # fallback, the plan's), by the program the agent starts for it.
    seen: set[str] = set()
    for key in ("model", "fallbackModel", "planModel"):
        model = str((cfg or {}).get(key) or "")
        if key != "model" and not model:
            continue
        _, cfg_key, program = next(r for r in ROUTES if model.startswith(r[0]))
        if program in seen:
            continue
        seen.add(program)
        custom = str((cfg or {}).get(cfg_key) or "")
        found = _bin_found(program, custom, strict=True)
        label = f"model route ({program})"
        if found:
            rows.append(("ok", label, found + (f" for {model}" if model else "")))
            rows += _route_ready(program)
        else:
            named = f"\"{cfg_key}\" in config.json ({custom})" if custom else f"{program} on PATH"
            rows.append(("warn", label, f"{named} not found (needed for {key} {model or 'opencode'})"))

    # 5. What starts the page
    rows += _windows_rows() if WINDOWS else _omarchy_rows()

    # 6. Optional helpers
    for opt, why in (
        ("pandoc", "PDF export"),
        ("xelatex", "PDF export"),
        ("pdftotext", "PDF search & reading"),
        ("pdfinfo", "the Downloads inbox's PDF titles"),
        ("gitleaks", "secret scrubbing before agent search"),
        ("pdftoppm", "reading a scanned PDF (OCR)"),
        ("tesseract", "reading a scanned PDF (OCR)"),
        ("qpdf", "reading a scanned PDF (OCR)"),
    ):
        found = _bin_found(opt)
        if not found:
            rows.append(("warn", f"optional:{opt}", f"not installed (optional, used for {why})"))
        elif opt == "pdftotext" and not _is_poppler(found):
            rows.append(("warn", f"optional:{opt}", f"{found} is xpdf's, not poppler's: put poppler's first on PATH"))
        else:
            rows.append(("ok", f"optional:{opt}", found))

    ok = not any(st == "fail" for st, _, _ in rows)
    return rows, ok


def _route_ready(program: str) -> list[tuple[str, str, str]]:
    """Whether a route whose program is there can run, as far as can be
    told without calling a model: opencode needs Longhand's agents where it
    reads them (`$XDG_CONFIG_HOME/opencode/agent`, on Windows too: opencode
    2.3 reads ~/.config there, not %APPDATA%), or every run fails "Agent not
    found"; Antigravity needs its sign-in, which on Windows it keeps in the
    Credential Manager, whatever home Longhand gives it."""
    if program == "opencode":
        agents = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config") / "opencode" / "agent"
        missing = [n for n in OPENCODE_AGENTS if not (agents / f"{n}.md").is_file()]
        if missing:
            return [("warn", "opencode agents", f"{', '.join(missing)} not in {agents} — run `longhand-agent install`")]
        return [("ok", "opencode agents", str(agents))]
    if program == "agy" and WINDOWS:
        target = os.environ.get("LONGHAND_AGY_CREDENTIAL") or AGY_CREDENTIAL
        signed = _windows_credential(target)
        if signed is None:
            return []
        if not signed:
            return [("warn", "antigravity sign-in", f"none in the Credential Manager ({target}) — run `agy` once "
                                                    "in a terminal and sign in with Google")]
        return [("ok", "antigravity sign-in", f"in the Credential Manager ({target})")]
    return []


def _windows_credential(target: str) -> bool | None:
    """Whether the Credential Manager holds a generic credential `target`;
    None when it could not be asked. The secret is never read out: only
    whether there is one."""
    try:
        import ctypes
        from ctypes import wintypes
        advapi = ctypes.WinDLL("advapi32", use_last_error=True)
        advapi.CredReadW.argtypes = (wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.POINTER(ctypes.c_void_p))
        advapi.CredReadW.restype = wintypes.BOOL
        advapi.CredFree.argtypes = (ctypes.c_void_p,)
        cred = ctypes.c_void_p()
        if advapi.CredReadW(target, 1, 0, ctypes.byref(cred)):          # CRED_TYPE_GENERIC
            advapi.CredFree(cred)
            return True
        return False if ctypes.get_last_error() == 1168 else None      # ERROR_NOT_FOUND
    except (OSError, AttributeError):
        return None


def _omarchy_rows() -> list[tuple[str, str, str]]:
    """Omarchy's shell plugins, and whether shell.json switches them on."""
    rows: list[tuple[str, str, str]] = []
    xdg_cfg = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home() / ".config")
    plugins_dir = xdg_cfg / "omarchy" / "plugins"
    missing_plugins = [pid for pid in PLUGINS if not (plugins_dir / pid).is_dir()]
    if not missing_plugins:
        rows.append(("ok", "omarchy plugins", str(plugins_dir)))
    else:
        rows.append(("warn", "omarchy plugins", f"missing {', '.join(missing_plugins)} — run `tools/install-plugins --restart`"))

    shell_json = xdg_cfg / "omarchy" / "shell.json"
    if shell_json.is_file():
        try:
            sh = json.loads(shell_json.read_text())
            # A plugin is switched on in plugins[], or by its widget standing
            # in the bar (bar.layout's left, center and right): the timer and
            # the deadlines are bar widgets, and are listed only there.
            ids = {p.get("id") for p in (sh.get("plugins") or []) if isinstance(p, dict)}
            layout = (sh.get("bar") or {}).get("layout") or {}
            for side in (layout.values() if isinstance(layout, dict) else []):
                ids |= {w.get("id") for w in (side if isinstance(side, list) else []) if isinstance(w, dict)}
            unlisted = [pid for pid in PLUGINS if pid not in ids]
            if not unlisted:
                rows.append(("ok", "shell.json", "all 3 plugins enabled"))
            else:
                rows.append(("warn", "shell.json", f"not in plugins[] nor in the bar's layout: {', '.join(unlisted)}"))
        except (OSError, ValueError):
            rows.append(("warn", "shell.json", f"could not parse {shell_json}"))
    return rows


def _windows_rows() -> list[tuple[str, str, str]]:
    """What stands in for the shell's plugins on Windows: the page's host
    (longhand.exe), its Start menu entry and the session's start, both
    written by `longhand install` (windows/shortcuts.py)."""
    rows: list[tuple[str, str, str]] = []
    host = _bin_found("longhand")
    if host:
        rows.append(("ok", "page (longhand)", host))
    else:
        rows.append(("fail", "page (longhand)", f"longhand.exe not on PATH — run {INSTALL}"))
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location("longhand_shortcuts", ROOT / "windows" / "shortcuts.py")
        sc = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(sc)
        lnk, started = sc.shortcut_path(), sc.autostart()
        # By name in a terminal opened now (this one's PATH may be older, or
        # the launcher's: the registry's is what a new one gets).
        unreached = [name for name in sc.COMMANDS if not sc.reachable(name)]
        reached = sc.reachable(sc.COMMANDS[0])
    except Exception as e:  # noqa: BLE001 — a check, not a crash
        return rows + [("warn", "start menu", f"could not look: {e}")]
    if not unreached:
        rows.append(("ok", "commands by name", f"on PATH in a new terminal ({pathlib.Path(reached).parent})"))
    else:
        rows.append(("warn", "commands by name", f"not on PATH in a new terminal: {', '.join(unreached)} "
                                                 f"— run `longhand install` (or start them from {pathlib.Path(sys.executable).parent})"))
    if lnk.is_file():
        rows.append(("ok", "start menu", str(lnk)))
    else:
        rows.append(("warn", "start menu", f"no entry at {lnk} — run `longhand install`"))
    if started:
        rows.append(("ok", "with the session", started))
    else:
        rows.append(("warn", "with the session", "not started at sign-in, so its keys work only once it is opened "
                                                 "— run `longhand install`"))
    return rows


def main() -> int:
    rows, ok = diagnose()
    marks = {"ok": "ok  ", "warn": "WARN", "fail": "FAIL"}
    for st, label, detail in rows:
        print(f"{marks[st]} {label:22s} {detail}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
