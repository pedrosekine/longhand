from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "agent"))
import names as namelib  # noqa: E402  (a paper's and a note's shown names)

CONFIG_PATH = Path(os.environ.get("LONGHAND_CONFIG")
                   or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "longhand" / "config.json")
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "longhand"
CACHE = STATE_HOME / "reading"

LINK_RE = re.compile(
    r"^>\s*— \[\[(?P<target>[^\]|#]+)#page=(?P<page>\d+)(?:\|[^\]]*)?\]\]"
    r"(?: · (?P<day>\d{4}-\d{2}-\d{2}))?"
    r"(?: · after “(?P<after>[^”]*)”)?"
    r"(?:\s+\^(?P<id>h\d+))?\s*$")
QUESTION_RE = re.compile(r"^>\s*\[!question\][-+]?\s*$", re.I)
PDF_FIELD_RE = re.compile(r"^pdf:\s*\"?\[\[(?P<target>[^\]|#]+)(?:\|[^\]]*)?\]\]\"?\s*$")
TAG_LINE_RE = re.compile(r"^(?:#[\w/-]+\s*)+$")
TAG_RE = re.compile(r"#([\w/-]+)")


def fail(msg: str) -> None:
    print(f"longhand-read: {msg}", file=sys.stderr)
    sys.exit(1)


def load_config() -> dict:
    try:
        cfg = json.loads(CONFIG_PATH.read_text())
    except (OSError, ValueError) as e:
        fail(f"cannot read {CONFIG_PATH}: {e}")
    if not cfg.get("vault"):
        fail("config.json has no vault")
    return cfg


def notes_root(cfg: dict) -> str:
    notes = cfg.get("notes")
    if notes is None:
        parts = str((cfg.get("daily") or {}).get("dir", "")).strip("/").split("/")
        notes = parts[0] if len(parts) > 1 else ""
    return str(notes).strip("/")


def private_dirs(cfg: dict) -> list[str]:
    """Folders whose PDFs are read but never marked nor talked about with
    the agent: `private` in the config, else the person's Personal folder
    (bank statements, contracts)."""
    if "private" in cfg:
        return [str(d).strip("/") for d in cfg["private"] if str(d).strip("/")]
    notes = notes_root(cfg)
    return [f"{notes}/Personal" if notes else "Personal"]


def is_private(cfg: dict, rel: str) -> bool:
    return any(rel == d or rel.startswith(d + "/") for d in private_dirs(cfg))


def readings_dir(cfg: dict) -> str:
    """The reading notes' folder, from the vault: `readings`, else the
    person's notes (`notes`, else the daily folder's first part) + Readings."""
    if cfg.get("readings"):
        return str(cfg["readings"]).strip("/")
    notes = notes_root(cfg)
    return f"{notes}/Readings" if notes else "Readings"


# ------------------------------------------------------------- the words

def key(s: str) -> str:
    """Letters and digits only, lower case, ligatures and accents undone."""
    s = unicodedata.normalize("NFKD", s).casefold()
    return "".join(c for c in s if c.isalnum())


def key_cased(s: str) -> str:
    """As `key`, its capitals kept: a search typed with a capital in it
    finds only those (ANS, not trANSport)."""
    s = unicodedata.normalize("NFKD", s)
    return "".join(c for c in s if c.isalnum())


def ocr_copy(pdf: Path) -> Path:
    """Where a scanned PDF's copy with a text layer is kept: the state
    folder, by the original's path, size and time (plan.md item 15, step 5).
    The original is never written."""
    st = pdf.stat()
    key = hashlib.sha1(f"{pdf.resolve()}|{st.st_size}|{st.st_mtime_ns}".encode()).hexdigest()
    return CACHE / "ocr" / f"{key}.pdf"


def words_of(pdf: Path) -> list[list[dict]]:
    """Every page's words with their boxes — the PDF's own, else, for a scan
    read with `ocr`, its copy's."""
    pages = own_words(pdf)
    if not any(pages):
        copy = ocr_copy(pdf)
        if copy.is_file():
            return own_words(copy)
    return pages


TESSERACT = {"english": "eng", "german": "deu", "portuguese": "por", "spanish": "spa", "french": "fra", "italian": "ita"}


def ocr_languages(cfg: dict) -> str:
    """The person's languages (`languages` in the config) that tesseract
    has, English when none of them is there."""
    try:
        have = set(subprocess.run(["tesseract", "--list-langs"], capture_output=True, text=True, timeout=20).stdout.split()[1:])
    except (OSError, subprocess.TimeoutExpired):
        have = set()
    want = [TESSERACT.get(str(x).lower()) for x in cfg.get("languages") or ["English"]]
    langs = [c for c in want if c and c in have]
    return "+".join(langs or (["eng"] if "eng" in have or not have else sorted(have - {"osd"})[:1]))


def cmd_ocr(cfg: dict, path: Path) -> None:
    """A scanned PDF read: each page drawn (pdftoppm, 300 dpi) and read by
    tesseract into an invisible text layer, laid over the original pages in
    a copy (qpdf) — so the copy looks as the scan does and its words can be
    selected, found and marked. One JSON line per page read, as it goes."""
    if any(own_words(path)):
        fail("this PDF has words already")
    out = ocr_copy(path)
    if out.is_file():
        return
    for tool in ("pdftoppm", "tesseract", "qpdf"):
        if not shutil.which(tool):
            fail(f"{tool} is not installed: a scan cannot be read")
    n = int(subprocess.run(["qpdf", "--show-npages", str(path)], capture_output=True, text=True, timeout=60).stdout.strip() or 0)
    langs = ocr_languages(cfg)
    work = Path(tempfile.mkdtemp(prefix="longhand-ocr-"))
    try:
        layers = []
        for i in range(1, n + 1):
            print(json.dumps({"ocr": {"page": i, "pages": n, "languages": langs}}), flush=True)
            img = work / f"p{i:04d}"
            subprocess.run(["pdftoppm", "-r", "300", "-f", str(i), "-l", str(i), "-singlefile", "-png", str(path), str(img)],
                           capture_output=True, timeout=300, check=True)
            subprocess.run(["tesseract", f"{img}.png", str(img), "-l", langs, "-c", "textonly_pdf=1", "pdf"],
                           capture_output=True, timeout=600, check=True)
            layers.append(f"{img}.pdf")
        text = work / "text.pdf"
        subprocess.run(["qpdf", "--empty", "--pages", *layers, "--", str(text)], capture_output=True, timeout=300, check=True)
        out.parent.mkdir(parents=True, exist_ok=True)
        tmp = out.with_suffix(".tmp")
        subprocess.run(["qpdf", str(path), "--overlay", str(text), "--", str(tmp)], capture_output=True, timeout=300, check=True)
        os.replace(tmp, out)
    except subprocess.CalledProcessError as e:
        fail(f"{e.cmd[0]} failed: {(e.stderr or b'').decode(errors='replace').strip()[:200]}")
    finally:
        shutil.rmtree(work, ignore_errors=True)


def own_words(pdf: Path) -> list[list[dict]]:
    """Every page's words with their boxes, in reading order, from
    `pdftotext -bbox-layout` — kept by the file's size and time."""
    st = pdf.stat()
    sig = f"2|{pdf.resolve()}|{st.st_size}|{st.st_mtime_ns}"
    cached = CACHE / (hashlib.sha1(str(pdf.resolve()).encode()).hexdigest() + ".json")
    try:
        c = json.loads(cached.read_text())
        if c.get("sig") == sig:
            WIDTHS[:] = c.get("widths", [])
            return c["pages"]
    except (OSError, ValueError):
        pass
    try:
        out = subprocess.run(["pdftotext", "-bbox-layout", str(pdf), "-"],
                             capture_output=True, text=True, timeout=120).stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        fail(f"pdftotext: {e}")
    pages: list[list[dict]] = []
    widths: list[float] = []
    line = 0
    for m in re.finditer(r"<page width=\"([\d.]+)\"|<line\b|<word xMin=\"([\d.]+)\" yMin=\"([\d.]+)\" xMax=\"([\d.]+)\" yMax=\"([\d.]+)\">(.*?)</word>", out):
        tok = m.group(0)
        if tok.startswith("<page"):
            pages.append([])
            widths.append(float(m.group(1)))
        elif tok == "<line":
            line += 1
        elif pages:
            pages[-1].append({"t": html.unescape(m.group(6)), "x0": float(m.group(2)), "y0": float(m.group(3)),
                              "x1": float(m.group(4)), "y1": float(m.group(5)), "l": line})
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        tmp = cached.with_suffix(".tmp")
        tmp.write_text(json.dumps({"sig": sig, "pages": pages, "widths": widths}))
        os.replace(tmp, cached)
    except OSError:
        pass
    WIDTHS[:] = widths
    return pages


# Each page's width in points, from the last words_of.
WIDTHS: list[float] = []


def text_span(pages: list[list[dict]]) -> dict | None:
    """Where the text stands across the page, left and right, in points: the
    words' edges, leaving out the outermost few (a page number, a line
    number in the margin), so the page can be fitted by its text rather than
    its paper."""
    x0s = sorted(w["x0"] for p in pages for w in p)
    x1s = sorted(w["x1"] for p in pages for w in p)
    if len(x0s) < 20 or not WIDTHS:
        return None
    left, right = x0s[len(x0s) // 50], x1s[len(x1s) - 1 - len(x1s) // 50]
    width = max(set(WIDTHS), key=WIDTHS.count)
    if right - left < width * 0.3:
        return None
    return {"x0": round(left, 1), "x1": round(right, 1), "w": round(width, 1)}


def page_keys(words: list[dict], keyed=key) -> tuple[str, list[int]]:
    """A page's words as one key string, and for each of its characters the
    word it came from."""
    s, owner = [], []
    for i, w in enumerate(words):
        k = keyed(w["t"])
        s.append(k)
        owner.extend([i] * len(k))
    return "".join(s), owner


def occurrences(hay: str, needle: str) -> list[int]:
    out, at = [], hay.find(needle)
    while at >= 0:
        out.append(at)
        at = hay.find(needle, at + 1)
    return out


def rects(words: list[dict], first: int, last: int) -> list[list[float]]:
    """One rectangle per line the words first..last stand on."""
    out: list[list[float]] = []
    cur = None
    for w in words[first:last + 1]:
        if cur and cur[4] == w["l"]:
            cur[0], cur[1] = min(cur[0], w["x0"]), min(cur[1], w["y0"])
            cur[2], cur[3] = max(cur[2], w["x1"]), max(cur[3], w["y1"])
        else:
            cur = [w["x0"], w["y0"], w["x1"], w["y1"], w["l"]]
            out.append(cur)
    # Lines set close together have boxes that cross (each as tall as its
    # font); drawn see-through, the crossing showed darker. Two lines that
    # cross meet halfway instead.
    for a, b in zip(out, out[1:]):
        if b[1] < a[3] and b[3] > a[3]:
            a[3] = b[1] = (a[3] + b[1]) / 2
    return [[round(r[0], 2), round(r[1], 2), round(r[2] - r[0], 2), round(r[3] - r[1], 2)] for r in out]


def place(pages: list[list[dict]], text: str, page: int, after: str = "", y: float | None = None) -> dict | None:
    """Where `text` is: on its page (from 0), else the pages around it, else
    anywhere; across a page's foot into the next if need be. None when it is
    nowhere. With several on one page: the one after `after`, else the one
    nearest `y`, else the first."""
    q = key(text)
    if not q or not pages:
        return None
    n = len(pages)
    order = [p for d in (0, -1, 1, -2, 2) for p in [page + d] if 0 <= p < n]
    order += [p for p in range(n) if p not in order]
    keys = {}

    def k(p):
        if p not in keys:
            keys[p] = page_keys(pages[p])
        return keys[p]

    for p in order:
        s, owner = k(p)
        hits = occurrences(s, q)
        if hits:
            if len(hits) > 1:
                a = key(after)
                if a:
                    fit = [h for h in hits if s[:h].endswith(a)]
                    hits = fit or hits
                if len(hits) > 1 and y is not None:
                    hits.sort(key=lambda h: abs(pages[p][owner[h]]["y0"] - y))
            h = hits[0]
            first, last = owner[h], owner[h + len(q) - 1]
            return {"page": p, "first": first, "last": last, "many": len(occurrences(s, q)) > 1,
                    "boxes": [{"page": p, "rects": rects(pages[p], first, last)}]}
        # Over the foot of this page into the next.
        if p + 1 < n:
            s2, owner2 = k(p + 1)
            joined = s + s2
            for h in occurrences(joined, q):
                if h < len(s) < h + len(q):
                    first, last = owner[h], owner2[h + len(q) - 1 - len(s)]
                    return {"page": p, "first": first, "last": len(pages[p]) - 1, "many": False,
                            "boxes": [{"page": p, "rects": rects(pages[p], first, len(pages[p]) - 1)},
                                      {"page": p + 1, "rects": rects(pages[p + 1], 0, last)}]}
    return None


SEARCH_LIMIT = 500
HYPHENS = ("-", "\u00ad", "\u2010", "\ufffe")


def search_keys(words: list[dict], keyed) -> tuple[str, list[int]]:
    """A page's words as `page_keys` has them, a space kept between two
    words (a search for "ans" is not in "human sensing"), none after a word
    a line broke with a hyphen ("Auton- omous" is "autonomous")."""
    s, owner = [], []
    for i, w in enumerate(words):
        k = keyed(w["t"])
        s.append(k)
        owner.extend([i] * len(k))
        if k and not w["t"].rstrip().endswith(HYPHENS):
            s.append(" ")
            owner.append(i)
    return "".join(s), owner


def plain(words: list[dict]) -> str:
    """Words for a line of text: what pdftotext keeps of a table's tabs and
    marks between them is a space."""
    text = re.sub(r"[\s\x00-\x1f]+", " ", " ".join(w["t"] for w in words)).strip()
    return re.sub(r"(\w)[-\u00ad] (?=\w)", r"\1-", text)


def search(pages: list[list[dict]], text: str, limit: int = SEARCH_LIMIT) -> dict:
    """Every place `text` is in the paper, page by page (Ctrl+F in a PDF,
    2026-11-17), matched as a mark's words are, loosely: letters and digits
    only, so a word broken over a line, a ligature or an accent never hides
    one; only the spaces between words are kept. All in small letters finds
    any case; a capital typed makes the case count. Each hit: its page
    (from 0), its rectangles, and the words before it, its own, and after,
    for a list of them. The first `limit` are given, and how many there are."""
    words = clean_quote(text)
    cased = any(c.isupper() for c in words)
    keyed = key_cased if cased else key
    q = " ".join(k for k in (keyed(w) for w in words.split()) if k)
    out = {"hits": [], "total": 0, "cased": cased}
    if len(q.replace(" ", "")) < 2:
        return out
    for p, ws in enumerate(pages):
        s, owner = search_keys(ws, keyed)
        at, last_span = s.find(q), None
        while at >= 0:
            first, last = owner[at], owner[at + len(q) - 1]
            # Twice in one word (a word that holds it twice) is one place.
            if (first, last) != last_span:
                last_span = (first, last)
                out["total"] += 1
                if len(out["hits"]) < limit:
                    out["hits"].append({
                        "page": p, "rects": rects(ws, first, last),
                        "before": plain(ws[max(0, first - 6):first]),
                        "match": plain(ws[first:last + 1])[:300],
                        "after": plain(ws[last + 1:last + 7])})
            at = s.find(q, at + len(q))
    return out


def before_words(words: list[dict], first: int, count: int = 3) -> str:
    return " ".join(w["t"] for w in words[max(0, first - count):first])


def clean_quote(text: str) -> str:
    """The selection as one line: Qt marks a hyphen it broke a line at with
    U+FFFE (or a soft hyphen); the word is joined again."""
    text = re.sub("[\ufffe\u00ad]\\s*", "", text)
    text = re.sub(r"(\w)-\r?\n(\w)", r"\1\2", text)
    return re.sub(r"\s+", " ", text).strip()


# ---------------------------------------------------------- acronyms
#
# Hover a paper to have it explained (plan.md, item 18, 2026-11-16): an
# acronym anywhere in the paper says what it stands for and the page that
# said so. The definitions are found in the paper's own text with no model,
# by the Schwartz–Hearst rule ("Long Form (LF)", and "LF (Long Form)" when
# the parenthesis holds several words): each letter of the short form,
# taken backwards, is found in the long form, the first at a word's start.
# Kept in the state folder by the file's size and time, beside the scan's
# copy, so a paper is read for them once.

ACRO_VERSION = 4
OPEN_PUNCT = "([{\"'“‘"
CLOSE_PUNCT = ")]}\"'”’.,;:!?"
ROMAN_RE = re.compile(r"^[IVXLCDM]+$")


# Small words a long form may hold that its short form leaves out.
STOPWORDS = {"of", "and", "the", "in", "for", "on", "to", "a", "an", "with", "by", "at", "from", "&",
             "der", "die", "das", "und", "für", "mit", "von", "vom", "zur", "zum", "im", "auf", "des", "den",
             "dem", "ein", "eine", "de", "la", "le", "et", "du"}
# A heading that starts the paper's references: names in capitals there are
# not acronyms.
REFERENCES = {"references", "reference", "bibliography", "literatur", "literaturverzeichnis", "quellen",
              "quellenverzeichnis", "works cited", "referenzen", "bibliographie"}


def short_ok(s: str) -> bool:
    """Could `s` be a short form: one word, 2 to 10 characters, starting
    with a letter or digit, with two capitals (or one and a digit). Never
    with a dot: "J.M." is someone's initials."""
    if not (2 <= len(s) <= 10) or not s[0].isalnum() or " " in s:
        return False
    if not all(c.isalnum() or c in "-/&" for c in s):
        return False
    caps = sum(c.isupper() for c in s)
    digits = any(c.isdigit() for c in s)
    return caps >= 2 or (caps >= 1 and digits)


def canonical(s: str) -> str:
    """The short form without a plural's s: LLMs → LLM."""
    if len(s) > 2 and s.endswith("s") and short_ok(s[:-1]) and s[:-1].replace("-", "").isupper():
        return s[:-1]
    return s


def best_long_form(short: str, long: str) -> str | None:
    """Schwartz & Hearst (2003): the shortest end of `long` that holds the
    letters of `short` in order, the first at the start of a word."""
    s, li = len(short) - 1, len(long) - 1
    while s >= 0:
        c = short[s].lower()
        if not c.isalnum():
            s -= 1
            continue
        while (li >= 0 and long[li].lower() != c) or (s == 0 and li > 0 and long[li - 1].isalnum()):
            li -= 1
        if li < 0:
            return None
        li -= 1
        s -= 1
    return long[long.rfind(" ", 0, li + 1) + 1:]


def joined(words: list[dict]) -> list[tuple[str, list[int]]]:
    """A page's words as tokens, a word broken across lines by a hyphen
    joined again ("lan-" "guage" → "language"); each with the words it is."""
    out: list[tuple[str, list[int]]] = []
    i = 0
    while i < len(words):
        t, idx = words[i]["t"], [i]
        while (t.endswith("-") and len(t) > 1 and i + 1 < len(words) and words[i + 1]["l"] != words[i]["l"]
               and words[i + 1]["t"][:1].islower()):
            i += 1
            t, idx = t[:-1] + words[i]["t"], idx + [i]
        out.append((t, idx))
        i += 1
    return out


def long_ok(short: str, long: str) -> bool:
    """Schwartz–Hearst's limits, and one more for languages that join words
    (2026-11-16, a German paper: "Der Umstieg auf das Fahrrad … (DStGB)"):
    each of the long form's words, small words aside, starts with a letter
    the short form has — but the last, which may trail ("skin conductance
    response frequency (SCR)")."""
    n = len(long.split())
    if not (len(long) > len(short) and short.lower() not in long.lower()
            and 1 <= n <= min(len(short) + 5, len(short) * 2) and any(c.isalpha() for c in long)):
        return False
    if "@" in long or "://" in long:
        return False
    letters = {c.lower() for c in short if c.isalnum()}
    words = [w.strip(OPEN_PUNCT + CLOSE_PUNCT) for w in long.split()]
    content = [w for w in words if w and w.lower() not in STOPWORDS]
    return all(w[0].lower() in letters for w in content[:-1])


def definitions(pages: list[list[dict]]) -> dict:
    """Every short form the paper spells out, the first time it does:
    short → { short, long, page (from 1), rects (where it is spelled out) }."""
    found: dict = {}
    for pi, words in enumerate(pages):
        toks = joined(words)
        for ti, (t, idx) in enumerate(toks):
            if not t.startswith("("):
                continue
            # The parenthesis: up to its close, at most eight words on.
            inner, end = [], ti
            for tj in range(ti, min(len(toks), ti + 8)):
                inner.append(toks[tj][0])
                end = tj
                if ")" in toks[tj][0]:
                    break
            else:
                continue
            text = " ".join(inner)[1:]
            text = text[:text.index(")")] if ")" in text else text
            text = re.split(r"[;,]", text)[0].strip()
            # Words before it, back to the sentence's start.
            before: list[int] = []
            for tk in range(ti - 1, -1, -1):
                w = toks[tk][0]
                if w[-1:] in ".;:!?)" and tk != ti - 1:
                    break
                before.insert(0, tk)
                if len(before) >= 16:
                    break
            if not before:
                continue
            # "Long Form (LF)"
            if short_ok(text):
                short = text
                window = before[-min(len(short) + 5, len(short) * 2):]
                cand = " ".join(toks[k][0] for k in window).strip(OPEN_PUNCT + CLOSE_PUNCT)
                long = best_long_form(short, cand)
                if not (long and long_ok(short, long)):
                    continue
                # The long form is the window's end, word for word.
                first, last = window[-len(long.split())], end
            # "LF (Long Form)"
            elif len(text.split()) > 1:
                short = toks[before[-1]][0].strip(OPEN_PUNCT + CLOSE_PUNCT)
                if not short_ok(short):
                    continue
                long = best_long_form(short, text)
                first, last = before[-1], end
                if not (long and long_ok(short, long) and len(long.split()) >= len(text.split()) - 1):
                    long = None
            else:
                continue
            if not long:
                continue
            key_ = canonical(short)
            if key_ in found:
                continue
            ws = [w for k in range(first, last + 1) for w in toks[k][1]]
            found[key_] = {"short": key_, "long": re.sub(r"\s+", " ", long).strip(OPEN_PUNCT + CLOSE_PUNCT),
                           "page": pi + 1, "rects": rects(words, ws[0], ws[-1])}
        # A list of abbreviations (an IEEE paper's nomenclature, 2026-11-16):
        # a short form alone on its line, its long form on the same line to
        # its right, read as two lines.
        lines: dict[int, list[int]] = {}
        for i, w in enumerate(words):
            lines.setdefault(w["l"], []).append(i)
        for l, idx in lines.items():
            w = words[idx[0]]
            short = w["t"].strip(OPEN_PUNCT + CLOSE_PUNCT)
            if len(idx) != 1 or not short_ok(short) or canonical(short) in found:
                continue
            beside = [ix for m, ix in lines.items() if m != l and abs(words[ix[0]]["y0"] - w["y0"]) < 1.5
                      and 0 < words[ix[0]]["x0"] - w["x1"] < 120]
            if not beside:
                continue
            row = min(beside, key=lambda ix: words[ix[0]]["x0"])
            long = " ".join(words[i]["t"] for i in row).strip(OPEN_PUNCT + CLOSE_PUNCT)
            got = best_long_form(short, long)
            if not got or len(got.split()) < len(long.split()) or not long_ok(short, long):
                continue
            found[canonical(short)] = {"short": canonical(short), "long": long, "page": pi + 1,
                                       "rects": rects(words, idx[0], idx[0]) + rects(words, row[0], row[-1])}
    return found


def parts(t: str) -> list[tuple[str, int]]:
    """A word's candidate tokens with where each starts in it: the word
    stripped of its punctuation and possessive, and the pieces of a
    compound ("LF-based", "CNN/RNN")."""
    a = len(t) - len(t.lstrip(OPEN_PUNCT))
    core = t[a:].rstrip(CLOSE_PUNCT)
    core = re.sub(r"['’]s$", "", core)
    out = [(core, a)]
    if re.search(r"[-/]", core):
        at = a
        for piece in re.split(r"([-/])", core):
            if piece not in ("-", "/") and piece:
                out.append((piece, at))
            at += len(piece)
    return out


def acronyms(pages: list[list[dict]]) -> dict:
    """The paper's acronyms: those it spells out, those it never does
    (written at least twice in running text, so a heading in capitals is
    not one), and every place each is written, to be hovered."""
    defs = definitions(pages)
    spots: dict[str, list] = {}
    loose: dict[str, list] = {}
    in_refs = False
    for pi, words in enumerate(pages):
        lines: dict[int, bool] = {}
        said: dict[int, list[str]] = {}
        for w in words:
            lines[w["l"]] = lines.get(w["l"], False) or any(c.islower() for c in w["t"])
            said.setdefault(w["l"], []).append(w["t"])
        # Only in the paper's later part: "2 Literature" may open a review.
        refs_from = None if pi < len(pages) * 0.4 else next(
            (l for l, ts in said.items() if " ".join(ts).strip(" .:0123456789").lower() in REFERENCES), None)
        for w in words:
            n = max(1, len(w["t"]))
            width = w["x1"] - w["x0"]

            def box(tok: str, start: int) -> list[float]:
                # Its share of the word's box, by its letters.
                return [round(w["x0"] + width * start / n, 2), round(w["y0"], 2),
                        round(width * len(tok) / n, 2), round(w["y1"] - w["y0"], 2)]
            cands = [(canonical(tok), tok, start) for tok, start in parts(w["t"])]
            hit = next(((c, tok, start) for c, tok, start in cands if c in defs), None)
            if hit:
                spots.setdefault(str(pi), []).append({"r": box(hit[1], hit[2]), "a": hit[0]})
                continue
            if refs_from is not None and w["l"] >= refs_from:
                in_refs = True
            if in_refs or not lines[w["l"]]:
                continue
            for c, tok, start in cands:
                if 2 <= len(c) <= 8 and c.isalnum() and c.isupper() and short_ok(c) and not ROMAN_RE.match(c):
                    loose.setdefault(c, []).append((pi, box(tok, start)))
                    break
    # A word also written in small letters is a word set in capitals
    # (a running head's "STRESS", an author's "MOSER"), not an acronym.
    small = {key(w["t"]) for words in pages for w in words if not w["t"].isupper()}
    undefined = []
    for c, at in sorted(loose.items()):
        if len(at) < 2 or c in defs or c.lower() in small:
            continue
        undefined.append({"short": c, "count": len(at), "page": at[0][0] + 1})
        for pi, r in at:
            spots.setdefault(str(pi), []).append({"r": r, "a": c})
    listed = sorted(defs.values(), key=lambda d: d["short"].lower())
    return {"acronyms": listed, "undefined": undefined, "spots": spots}


def cmd_acronyms(cfg: dict, rel: str, path: Path) -> dict:
    """The paper's acronyms, kept by the file's size and time (and its scan's
    copy, once read)."""
    st = path.stat()
    copy = ocr_copy(path)
    sig = f"{ACRO_VERSION}|{path.resolve()}|{st.st_size}|{st.st_mtime_ns}|{copy.is_file()}"
    cached = CACHE / "acronyms" / (hashlib.sha1(str(path.resolve()).encode()).hexdigest() + ".json")
    try:
        c = json.loads(cached.read_text())
        if c.get("sig") == sig:
            return {"pdf": rel, **c["found"]}
    except (OSError, ValueError, KeyError):
        pass
    found = acronyms(words_of(path))
    try:
        cached.parent.mkdir(parents=True, exist_ok=True)
        tmp = cached.with_suffix(".tmp")
        tmp.write_text(json.dumps({"sig": sig, "found": found}, ensure_ascii=False))
        os.replace(tmp, cached)
    except OSError:
        pass
    return {"pdf": rel, **found}


# -------------------------------------------------------------- the note

class Note:
    """A reading note: its lines, and the marks found in them."""

    def __init__(self, path: Path, lines: list[str]):
        self.path = path
        self.lines = lines

    @staticmethod
    def blank(path: Path, rel: str, pid: str = "") -> "Note":
        return Note(path, ["---", f'pdf: "[[{rel}]]"', f'pdf-path: "{rel}"'] + ([f'pdf-id: "{pid}"'] if pid else [])
                    + ["---", f"# {Path(rel).stem}", ""])

    def field(self, name: str) -> str:
        """A frontmatter field's value, its quotes off; "" when it has none."""
        for line in self.lines[1:self.body_start() - 1] if self.body_start() else []:
            m = re.match(rf"^{re.escape(name)}:\s*(.*?)\s*$", line)
            if m:
                return m.group(1).strip('"').strip("'")
        return ""

    def set_field(self, name: str, value: str) -> None:
        """The field written (quoted), in place, else at the frontmatter's
        end — a frontmatter made when the note has none."""
        line = f'{name}: "{value}"'
        end = self.body_start()
        if not end:
            self.lines[:0] = ["---", line, "---"]
            return
        for i in range(1, end - 1):
            if re.match(rf"^{re.escape(name)}:", self.lines[i]):
                self.lines[i] = line
                return
        self.lines.insert(end - 1, line)

    def marks(self) -> list[dict]:
        """Each mark: where its block starts and ends (its note included)."""
        out, i, L = [], 0, self.lines
        while i < len(L):
            if not L[i].startswith(">"):
                i += 1
                continue
            start = i
            while i < len(L) and L[i].startswith(">"):
                i += 1
            block = L[start:i]
            m = LINK_RE.match(block[-1])
            if not m:
                continue
            kind = "q" if QUESTION_RE.match(block[0]) else "h"
            body = block[1:-1] if kind == "q" else block[:-1]
            text = " ".join(re.sub(r"^>\s?", "", b).strip() for b in body).strip()
            # The person's note: what follows, up to the next quote or heading.
            j = i
            while j < len(L) and not L[j].startswith(">") and not L[j].startswith("#"):
                j += 1
            note = "\n".join(L[i:j]).strip()
            while j > i and L[j - 1].strip() == "":
                j -= 1
            out.append({"id": m.group("id") or "", "kind": kind, "page": int(m.group("page")),
                        "day": m.group("day") or "", "after": m.group("after") or "", "text": text,
                        "note": note, "start": start, "end": j, "target": m.group("target")})
        return out

    def tags(self) -> list[str]:
        body = self.body_start()
        out = []
        for line in self.lines[body:]:
            if line.startswith(">"):
                break
            if TAG_LINE_RE.match(line.strip()):
                out += TAG_RE.findall(line)
        return out

    def body_start(self) -> int:
        if self.lines and self.lines[0] == "---":
            for i in range(1, len(self.lines)):
                if self.lines[i] == "---":
                    return i + 1
        return 0

    def save(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        text = "\n".join(self.lines).rstrip("\n") + "\n"
        fd, tmp = tempfile.mkstemp(dir=self.path.parent, prefix=".longhand-read-")
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, self.path)


def block_lines(kind: str, text: str, rel: str, page: int, day: str, after: str, mid: str) -> list[str]:
    link = f"> — [[{rel}#page={page}|p. {page}]] · {day}" + (f" · after “{after}”" if after else "") + f" ^{mid}"
    return (["> [!question]"] if kind == "q" else []) + [f"> {text}", link]


def find_note(cfg: dict, rel: str) -> Path | None:
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    if not folder.is_dir():
        return None
    for p in sorted(folder.glob("*.md")):
        try:
            with p.open() as f:
                head = [next(f, "") for _ in range(12)]
        except OSError:
            continue
        for line in head:
            m = PDF_FIELD_RE.match(line.strip())
            if m and m.group("target").strip() == rel:
                return p
    return None


def new_note_path(cfg: dict, rel: str) -> Path:
    """The PDF's own name; when that is taken, with its folder added, then a
    number."""
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    stem = Path(rel).stem
    parent = Path(rel).parent.name
    names = [stem] + ([f"{stem} ({parent})"] if parent else [])
    for name in names:
        if not (folder / f"{name}.md").exists():
            return folder / f"{name}.md"
    n = 2
    while (folder / f"{names[-1]} {n}.md").exists():
        n += 1
    return folder / f"{names[-1]} {n}.md"


# ------------------------------------------------------------- moves
#
# A paper moved or renamed (2026-11-16) — by `move` here, in Obsidian, in a
# file manager — keeps everything made about it: its reading note, the
# conversation about it, where it was left, a scan's copy with words. All
# of those go by the PDF's path, so a move re-keys each of them.
#
# The note says which file it is about twice over: `pdf-path`, the path as
# plain text (Obsidian rewrites a link when it moves a file, never plain
# text, so a path that no longer matches the link is a move it made), and
# `pdf-id`, the file's size and the start of its sha1 (a move that left the
# link pointing at nothing is found again by the file's contents). A note
# from before either was kept is matched by its marks: a moved paper's
# quotes are still on their pages.

def pdf_id(path: Path) -> str:
    """The file's size and the start of its sha1, kept by its path, size
    and time in the state folder so a folder of papers is read once."""
    st = path.stat()
    sig = f"{path.resolve()}|{st.st_size}|{st.st_mtime_ns}"
    ids = CACHE / "ids.json"
    try:
        known = json.loads(ids.read_text())
    except (OSError, ValueError):
        known = {}
    if sig in known:
        return known[sig]
    h = hashlib.sha1()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    out = known[sig] = f"{st.st_size}-{h.hexdigest()[:16]}"
    try:
        ids.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=ids.parent, prefix=".ids-")
        with os.fdopen(fd, "w") as f:
            json.dump(dict(list(known.items())[-2000:]), f)
        os.replace(tmp, ids)
    except OSError:
        pass
    return out


def talk_file(cfg: dict, rel: str) -> Path:
    """The conversation about a file: by the md5 of its path (as the runner
    and the page name it)."""
    return Path(cfg["vault"]) / str(cfg.get("agentDir") or "agents/longhand") / "notes" / \
        (hashlib.md5(rel.encode("utf-8")).hexdigest()[:16] + ".json")


def note_target(note: Note) -> str:
    return next((m.group("target").strip() for line in note.lines[:12] for m in [PDF_FIELD_RE.match(line.strip())] if m), "")


def move_talk(cfg: dict, old: str, new: str) -> bool:
    """The conversation about `old` made the one about `new`, never over
    one `new` has already."""
    src, dst = talk_file(cfg, old), talk_file(cfg, new)
    if not src.is_file() or dst.exists():
        return False
    try:
        d = json.loads(src.read_text())
        d["path"] = new
        tmp = dst.with_name(dst.name + ".tmp")
        tmp.write_text(json.dumps(d, ensure_ascii=False, indent=1) + "\n")
        os.replace(tmp, dst)
        src.unlink()
        return True
    except (OSError, ValueError):
        return False


def carry(cfg: dict, old: str, new: str, path: Path) -> list[str]:
    """What went by the old path, re-keyed to the new: the conversation
    (never over one the new path has already), where it was left, a scan's
    copy with words. What was carried, said."""
    said = ["conversation"] if move_talk(cfg, old, new) else []
    places = STATE_HOME / "pdfs.json"
    try:
        p = json.loads(places.read_text())
        if old in p and new not in p:
            p[new] = p.pop(old)
            tmp = places.with_name(places.name + ".tmp")
            tmp.write_text(json.dumps(p) + "\n")
            os.replace(tmp, places)
            said.append("place")
    except (OSError, ValueError):
        pass
    # A scan's copy is named by the original's path, size and time; a move
    # keeps the size and the time.
    st = path.stat()
    was = CACHE / "ocr" / (hashlib.sha1(f"{(Path(cfg['vault']) / old).resolve()}|{st.st_size}|{st.st_mtime_ns}".encode()).hexdigest() + ".pdf")
    if was.is_file() and not ocr_copy(path).exists():
        os.replace(was, ocr_copy(path))
        said.append("ocr")
    return said


def linked_from(cfg: dict, name: str, skip: Path) -> bool:
    """Whether any note in the vault links to the note called `name`."""
    pat = re.compile(r"\[\[(?:[^\]|#]*/)?" + re.escape(name) + r"(?:\.md)?(?:[#|]|\]\])")
    for f in Path(cfg["vault"]).rglob("*.md"):
        if f == skip or any(part.startswith(".") for part in f.relative_to(cfg["vault"]).parts):
            continue
        try:
            if pat.search(f.read_text(errors="replace")):
                return True
        except OSError:
            continue
    return False


def relink(cfg: dict, note: Note, old: str, new: str, path: Path) -> list[str]:
    """The note pointed at the PDF's new path: its `pdf` field and every
    mark's link, `pdf-path` and `pdf-id`; then the rest carried. A note
    named after the old file, as one is made, takes the new file's name when
    that is free and nothing links to it; a name given by the person stays."""
    for i, line in enumerate(note.lines):
        if f"[[{old}" in line:
            note.lines[i] = line.replace(f"[[{old}]]", f"[[{new}]]").replace(f"[[{old}#", f"[[{new}#").replace(f"[[{old}|", f"[[{new}|")
    note.set_field("pdf-path", new)
    note.set_field("pdf-id", pdf_id(path))
    said = carry(cfg, old, new, path)
    o, n = Path(old), Path(new)
    made = {o.stem, f"{o.stem} ({o.parent.name})"}
    if note.path.stem in made and n.stem != o.stem:
        dest = new_note_path(cfg, new)
        if dest.stem in (n.stem, f"{n.stem} ({n.parent.name})") and not linked_from(cfg, note.path.stem, note.path):
            vault = Path(cfg["vault"])
            old_rel = str(note.path.relative_to(vault)) if note.path.is_relative_to(vault) else ""
            for i, line in enumerate(note.lines[note.body_start():], note.body_start()):
                if line.strip() == f"# {o.stem}":
                    note.lines[i] = f"# {n.stem}"
                    break
            note.save()
            os.replace(note.path, dest)
            note.path = dest
            if old_rel:
                move_talk(cfg, old_rel, str(dest.relative_to(vault)))
            said.append("renamed")
            return said
    note.save()
    return said




def reading_notes(cfg: dict) -> list[Note]:
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    out = []
    for f in sorted(folder.glob("*.md")) if folder.is_dir() else []:
        try:
            out.append(Note(f, f.read_text().split("\n")))
        except OSError:
            continue
    return out


def orphans(cfg: dict) -> list[Note]:
    """Reading notes whose PDF is not where they say."""
    vault = Path(cfg["vault"])
    return [n for n in reading_notes(cfg) if (t := note_target(n)) and not (vault / t).is_file()]


def by_marks(note: Note, path: Path) -> bool:
    """A note from before `pdf-id` was kept, matched by its quotes: at
    least two, of 30 letters or more between them (a short phrase two
    papers share is no proof), nearly all of them found in this PDF."""
    marks = note.marks()
    if len(marks) < 2 or sum(len(key(m["text"])) for m in marks) < 30:
        return False
    pages = words_of(path)
    if not any(pages):
        return False
    found = sum(1 for m in marks if place(pages, m["text"], m["page"] - 1, m["after"]))
    return found >= 0.8 * len(marks)


def settle(cfg: dict, rel: str, path: Path, marks: bool = True) -> Note | None:
    """The PDF's note, kept up with a move: one found by its link but with
    another `pdf-path` was moved by Obsidian, so the rest follows it; none
    found, a note whose PDF is gone is looked for by the file's id (and,
    `marks`, by its quotes) and pointed here. A note that says nothing yet
    of its path or id is given both."""
    if is_private(cfg, rel):
        return load_note(cfg, rel)
    note = load_note(cfg, rel)
    if note:
        was = note.field("pdf-path")
        if was and was != rel and not (Path(cfg["vault"]) / was).is_file():
            relink(cfg, note, was, rel, path)
        elif was != rel or not note.field("pdf-id"):
            note.set_field("pdf-path", rel)
            note.set_field("pdf-id", pdf_id(path))
            note.save()
        return note
    lost = orphans(cfg)
    if not lost:
        return None
    pid = pdf_id(path)
    hits = [n for n in lost if n.field("pdf-id") == pid]
    if not hits and marks:
        hits = [n for n in lost if not n.field("pdf-id") and by_marks(n, path)]
    if len(hits) != 1:
        return None
    note = hits[0]
    relink(cfg, note, note_target(note), rel, path)
    return note


def cmd_move(cfg: dict, src: str, to: str) -> dict:
    """A PDF moved within the vault, and all made about it with it. Onto a
    file that is there already: only when it is the same file (its copy),
    which then stays and the moved one goes; never over a paper with marks
    of its own."""
    vault = Path(cfg["vault"])
    rel, path = rel_of(cfg, src)
    dest = Path(to) if to.startswith("/") else vault / to
    if dest.is_dir() or to.endswith("/"):
        dest = dest / path.name
    try:
        new = str(dest.resolve().relative_to(vault.resolve()))
    except ValueError:
        fail(f"not in the vault: {dest}")
    if dest.suffix.lower() != ".pdf":
        fail("the new name must end in .pdf")
    if new == rel:
        fail("that is where it is")
    if is_private(cfg, new) != is_private(cfg, rel):
        fail("not between a private folder and the rest: its marks would be kept, or lost, against the rule")
    note = settle(cfg, rel, path, marks=False)
    if dest.exists():
        if pdf_id(dest) != pdf_id(path):
            fail(f"another file is at {new}")
        if find_note(cfg, new):
            fail(f"{new} has a reading note of its own")
        path.unlink()
    else:
        dest.parent.mkdir(parents=True, exist_ok=True)
        os.rename(path, dest)
    said = relink(cfg, note, rel, new, dest) if note else carry(cfg, rel, new, dest)
    out = state(cfg, new, dest, load_note(cfg, new))
    out["moved"] = {"from": rel, "to": new, "carried": said}
    return out


# -------------------------------------------------------------- commands

def rel_of(cfg: dict, pdf: str) -> tuple[str, Path]:
    vault = Path(cfg["vault"])
    path = Path(pdf) if pdf.startswith("/") else vault / pdf
    try:
        rel = str(path.resolve().relative_to(vault.resolve()))
    except ValueError:
        rel = str(path)
    if not path.is_file():
        fail(f"no PDF at {path}")
    return rel, path


def state(cfg: dict, rel: str, path: Path, note: Note | None) -> dict:
    pages = words_of(path)
    has_text = any(pages)
    scanned = not any(own_words(path))
    copy = ocr_copy(path) if scanned else None
    out = {"pdf": rel, "name": paper_name(cfg, rel), "note": "", "tags": [], "marks": [], "unplaced": 0,
           "text": has_text, "pages": len(pages),
           "span": text_span(pages), "private": is_private(cfg, rel), "scanned": scanned,
           "ocr": str(copy) if copy and copy.is_file() else ""}
    if not note:
        return out
    out["note"] = str(note.path.relative_to(Path(cfg["vault"]))) if note.path.is_relative_to(Path(cfg["vault"])) else str(note.path)
    out["tags"] = note.tags()
    for m in note.marks():
        at = place(pages, m["text"], m["page"] - 1, m["after"]) if has_text else None
        out["marks"].append({"id": m["id"], "kind": m["kind"], "page": m["page"], "day": m["day"], "text": m["text"],
                             "note": m["note"], "placed": at is not None,
                             "found": at["page"] + 1 if at else 0, "boxes": at["boxes"] if at else []})
        if not at:
            out["unplaced"] += 1
    return out


def load_note(cfg: dict, rel: str) -> Note | None:
    p = find_note(cfg, rel)
    return Note(p, p.read_text().split("\n")) if p else None


def next_id(note: Note) -> str:
    nums = [int(m["id"][1:]) for m in note.marks() if m["id"]]
    return f"h{max(nums, default=0) + 1}"


def by_id(note: Note, mid: str) -> dict:
    for m in note.marks():
        if m["id"] == mid:
            return m
    fail(f"no mark {mid} in {note.path.name}")


def cmd_mark(cfg, rel, path, a) -> Note:
    if is_private(cfg, rel):
        fail("private: a PDF in a private folder takes no marks")
    text = clean_quote(a.text)
    if not key(text):
        fail("nothing to mark: no words selected")
    pages = words_of(path)
    at = place(pages, text, a.page - 1, y=a.y)
    after = ""
    if at and at["many"]:
        after = before_words(pages[at["page"]], at["first"])
    page = at["page"] + 1 if at else a.page
    note = load_note(cfg, rel)
    if note is None:
        note = Note.blank(new_note_path(cfg, rel), rel, pdf_id(path))
        if a.tag:
            note.lines += [f"#{a.tag.lstrip('#')}", ""]
    mid = next_id(note)
    day = a.day or dt.date.today().isoformat()
    lines = block_lines(a.kind, text, rel, page, day, after, mid)
    # In page order: after every mark on an earlier page, and those on the
    # same page that stand above it.
    marks = note.marks()
    y_new = pages[at["page"]][at["first"]]["y0"] if at else None
    insert = None
    for m in marks:
        if m["page"] < page:
            insert = m["end"]
        elif m["page"] == page:
            mat = place(pages, m["text"], m["page"] - 1, m["after"]) if y_new is not None else None
            y_m = pages[mat["page"]][mat["first"]]["y0"] if mat else None
            if y_new is None or y_m is None or y_m <= y_new:
                insert = m["end"]
    if insert is None:
        if marks:
            insert = marks[0]["start"]
            lines = lines + [""]
        else:
            insert = len(note.lines)
            while insert > 0 and note.lines[insert - 1].strip() == "":
                insert -= 1
            lines = [""] + lines
    else:
        lines = [""] + lines
    note.lines[insert:insert] = lines
    note.save()
    return note


def cmd_remove(cfg, rel, path, a) -> Note:
    note = load_note(cfg, rel) or fail("no reading note")
    m = by_id(note, a.id)
    start, end = m["start"], m["end"]
    while end < len(note.lines) and note.lines[end].strip() == "":
        end += 1
    if start > 0 and note.lines[start - 1].strip() == "" and end >= len(note.lines):
        start -= 1
    del note.lines[start:end]
    note.save()
    return note


def cmd_kind(cfg, rel, path, a) -> Note:
    note = load_note(cfg, rel) or fail("no reading note")
    m = by_id(note, a.id)
    if m["kind"] != a.kind:
        if a.kind == "q":
            note.lines.insert(m["start"], "> [!question]")
        else:
            del note.lines[m["start"]]
        note.save()
    return note


def cmd_note(cfg, rel, path, a) -> Note:
    note = load_note(cfg, rel) or fail("no reading note")
    m = by_id(note, a.id)
    # The block's quote lines end where its link is.
    link = m["start"]
    while not LINK_RE.match(note.lines[link]):
        link += 1
    new = [""] + a.text.strip().split("\n") if a.text.strip() else []
    note.lines[link + 1:m["end"]] = new
    note.save()
    return note


def cmd_tag(cfg, rel, path, a) -> Note:
    note = load_note(cfg, rel)
    if note is None:
        note = Note.blank(new_note_path(cfg, rel), rel, pdf_id(path))
    tag = a.tag.lstrip("#")
    if tag in note.tags():
        return note
    start = note.body_start()
    for i in range(start, len(note.lines)):
        line = note.lines[i].strip()
        if line.startswith(">"):
            break
        if TAG_LINE_RE.match(line):
            note.lines[i] = note.lines[i].rstrip() + f" #{tag}"
            note.save()
            return note
    # After the title.
    at = start
    while at < len(note.lines) and not note.lines[at].startswith("# "):
        at += 1
    at = at + 1 if at < len(note.lines) else start
    note.lines[at:at] = ["", f"#{tag}"]
    note.save()
    return note


def cmd_days(cfg: dict) -> dict:
    """Each day a paper was marked, from the reading notes' own days: the
    papers, their names, how many highlights and questions that day — what
    the day page shows as read (plan.md item 15, step 3). Read from the
    notes alone: no PDF is opened."""
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    days: dict[str, dict] = {}
    for f in sorted(folder.glob("*.md")) if folder.is_dir() else []:
        try:
            note = Note(f, f.read_text().split("\n"))
        except OSError:
            continue
        pdf = ""
        for line in note.lines[:12]:
            m = PDF_FIELD_RE.match(line.strip())
            if m:
                pdf = m.group("target").strip()
                break
        if not pdf:
            continue
        for m in note.marks():
            if not m["day"]:
                continue
            row = days.setdefault(m["day"], {}).setdefault(pdf, {"pdf": pdf, "title": Path(pdf).stem, "name": paper_name(cfg, pdf), "h": 0, "q": 0,
                                                                  "note": str(f.relative_to(Path(cfg["vault"])))})
            row[m["kind"]] += 1
    return {"days": {d: sorted(v.values(), key=lambda r: r["name"].lower()) for d, v in sorted(days.items())}}


def answered_marks(cfg: dict, rel: str) -> set[str]:
    """The marks a paper's conversation has answered: pointed at by a
    message that has an answer (the agent's notes/<md5 of the path>.json,
    as the page reads it)."""
    where = Path(cfg["vault"]) / str(cfg.get("agentDir") or "agents/longhand") / "notes" / \
        (hashlib.md5(rel.encode("utf-8")).hexdigest()[:16] + ".json")
    try:
        turns = json.loads(where.read_text()).get("turns") or []
    except (OSError, ValueError):
        return set()
    out = set()
    for a, b in zip(turns, turns[1:]):
        if a.get("role") == "student" and a.get("marks") and b.get("role") == "agent" and not b.get("error"):
            out.update(a["marks"])
    return out


def cmd_reading(cfg: dict, days: int, today: dt.date | None = None) -> dict:
    """What the person is reading, for the day's agent and the planner
    (plan.md item 15, after step 5): each paper marked in the last `days`
    days or with questions still waiting — its project, the days it was
    marked on, and the questions no answer has come to. From the reading
    notes and the papers' conversations; no PDF is opened. A paper in a
    private folder is never listed."""
    today = today or dt.date.today()
    since = (today - dt.timedelta(days=days - 1)).isoformat()
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    papers = []
    for f in sorted(folder.glob("*.md")) if folder.is_dir() else []:
        try:
            note = Note(f, f.read_text().split("\n"))
        except OSError:
            continue
        pdf = next((m.group("target").strip() for line in note.lines[:12] for m in [PDF_FIELD_RE.match(line.strip())] if m), "")
        if not pdf or is_private(cfg, pdf):
            continue
        marks = note.marks()
        answered = answered_marks(cfg, pdf)
        recent: dict[str, dict] = {}
        for m in marks:
            if m["day"] >= since:
                recent.setdefault(m["day"], {"h": 0, "q": 0})[m["kind"]] += 1
        waiting = [{"id": m["id"], "page": m["page"], "text": m["text"][:240], "note": m["note"][:240]}
                   for m in marks if m["kind"] == "q" and m["id"] not in answered]
        if not recent and not waiting:
            continue
        papers.append({"pdf": pdf, "title": Path(pdf).stem, "name": paper_name(cfg, pdf), "tags": note.tags(),
                       "days": [{"day": d, **c} for d, c in sorted(recent.items())],
                       "last": max((m["day"] for m in marks if m["day"]), default=""), "waiting": waiting})
    papers.sort(key=lambda r: r["last"], reverse=True)
    return {"since": since, "papers": papers}


def cmd_papers(cfg: dict, tag: str, folder_rel: str = "") -> dict:
    """A project's papers (plan.md item 5's first part, 2026-11-16): every
    reading note carrying its tag, with its marks counted, the questions
    still waiting, and the last day it was marked — the newest first."""
    tag = tag.lstrip("#").lower()
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    # A paper moved into the project's folder finds its note again (by the
    # file's id only: quotes are too slow to look for in every PDF here).
    if folder_rel and orphans(cfg):
        vault = Path(cfg["vault"])
        for f in sorted((vault / folder_rel).rglob("*.pdf")) if (vault / folder_rel).is_dir() else []:
            r = str(f.relative_to(vault))
            if not is_private(cfg, r) and not find_note(cfg, r):
                settle(cfg, r, f, marks=False)
    out = []
    for f in sorted(folder.glob("*.md")) if folder.is_dir() else []:
        try:
            note = Note(f, f.read_text().split("\n"))
        except OSError:
            continue
        if tag not in [t.lower() for t in note.tags()]:
            continue
        pdf = next((m.group("target").strip() for line in note.lines[:12] for m in [PDF_FIELD_RE.match(line.strip())] if m), "")
        if not pdf:
            continue
        out.append(paper_row(cfg, pdf, note, folder_rel))
    # With the project's folder: its PDFs too, those never marked as well
    # (a reading list not yet begun), and those marked under no tag.
    if folder_rel:
        vault = Path(cfg["vault"])
        have = {r["pdf"] for r in out}
        for f in sorted((vault / folder_rel).rglob("*.pdf")) if (vault / folder_rel).is_dir() else []:
            rel = str(f.relative_to(vault))
            if rel in have or is_private(cfg, rel) or "/archive/" in f"/{rel}" or "/build/" in f"/{rel}" \
                    or any(part.startswith(".") for part in Path(rel).parts):
                continue
            out.append(paper_row(cfg, rel, load_note(cfg, rel), folder_rel))
    # The marked first, the newest marked first; then those not begun, A to Z.
    marked = sorted((r for r in out if r["last"]), key=lambda r: (r["last"], r["title"]), reverse=True)
    return {"tag": tag, "papers": marked + sorted((r for r in out if not r["last"]), key=lambda r: r["title"].lower())}


LITERATURE = {"literature", "papers", "paper", "readings", "reading", "references", "refs", "bibliography", "sources"}


_BIBS: dict = {}


def bibs(cfg: dict) -> "namelib.Bibs":
    """The vault's bibliographies (agent/names.py), read once a run: a
    paper named by its key (`moser2026identifying.pdf`, as the thesis keeps
    them) is shown as its authors, year and title (2026-11-16; every place
    one is shown since 2026-11-19)."""
    v = str(cfg["vault"])
    if v not in _BIBS:
        _BIBS[v] = namelib.Bibs(Path(v))
    return _BIBS[v]


def paper_name(cfg: dict, pdf: str, near: str = "") -> str:
    """ "Moser et al. 2023", else the file's stem."""
    return bibs(cfg).paper(pdf, near)[0]


def paper_row(cfg: dict, pdf: str, note: "Note | None", near: str = "") -> dict:
    marks = note.marks() if note else []
    answered = answered_marks(cfg, pdf)
    waiting = [m for m in marks if m["kind"] == "q" and m["id"] not in answered]
    # Literature (a folder named so on its way, or a paper already marked)
    # or one of the project's own documents (a proposal, a chart).
    lit = bool(marks) or any(p.lower() in LITERATURE for p in Path(pdf).parts[:-1])
    return {"pdf": pdf, "title": Path(pdf).stem, "kind": "paper" if lit else "document",
            "missing": not (Path(cfg["vault"]) / pdf).is_file(),
            "note": str(note.path.relative_to(Path(cfg["vault"]))) if note else "",
            "h": sum(1 for m in marks if m["kind"] == "h"), "q": sum(1 for m in marks if m["kind"] == "q"),
            "waiting": len(waiting), "questions": [{"id": m["id"], "page": m["page"], "text": m["text"][:240], "note": m["note"][:240]}
                                                   for m in waiting],
            "last": max((m["day"] for m in marks if m["day"]), default=""),
            # Each day it was marked, and what: the project's stream shows
            # reading by the day it was done.
            "days": {d: {"h": sum(1 for m in marks if m["day"] == d and m["kind"] == "h"),
                         "q": sum(1 for m in marks if m["day"] == d and m["kind"] == "q")}
                     for d in sorted({m["day"] for m in marks if m["day"]})},
            "cite": bibs(cfg).cite(pdf, near), "name": paper_name(cfg, pdf, near)}


def main() -> int:
    ap = argparse.ArgumentParser(prog="longhand-read", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("days")
    rp = sub.add_parser("reading")
    rp.add_argument("--days", type=int, default=7)
    pp = sub.add_parser("papers")
    pp.add_argument("--tag", required=True)
    pp.add_argument("--dir", default="", help="the project's folder in the vault: its PDFs too, marked or not")
    for name in ("state", "mark", "remove", "kind", "note", "tag", "find", "search", "ocr", "move", "acronyms"):
        p = sub.add_parser(name)
        p.add_argument("--pdf", required=True)
        if name == "move":
            p.add_argument("--to", required=True, help="its new path in the vault (a folder: the same name there)")
        if name == "find":
            p.add_argument("--page", type=int, required=True)
            p.add_argument("--text", required=True)
        if name == "search":
            p.add_argument("--text", required=True)
        if name == "mark":
            p.add_argument("--page", type=int, required=True)
            p.add_argument("--text", required=True)
            p.add_argument("--kind", choices=("h", "q"), default="h")
            p.add_argument("--y", type=float)
            p.add_argument("--tag", default="")
            p.add_argument("--day", default="")
        if name in ("remove", "kind", "note"):
            p.add_argument("--id", required=True)
        if name == "kind":
            p.add_argument("--kind", choices=("h", "q"), required=True)
        if name == "note":
            p.add_argument("--text", default="")
        if name == "tag":
            p.add_argument("--tag", required=True)
    a = ap.parse_args()
    cfg = load_config()
    if a.cmd == "days":
        print(json.dumps(cmd_days(cfg), ensure_ascii=False))
        return 0
    if a.cmd == "papers":
        print(json.dumps(cmd_papers(cfg, a.tag, a.dir.strip("/")), ensure_ascii=False))
        return 0
    if a.cmd == "reading":
        print(json.dumps(cmd_reading(cfg, max(1, a.days)), ensure_ascii=False))
        return 0
    if a.cmd == "move":
        print(json.dumps(cmd_move(cfg, a.pdf, a.to), ensure_ascii=False))
        return 0
    rel, path = rel_of(cfg, a.pdf)
    if a.cmd == "acronyms":
        # Read only: nothing settled or written in the vault.
        print(json.dumps(cmd_acronyms(cfg, rel, path), ensure_ascii=False))
        return 0
    if a.cmd == "search":
        # Read only, as `find`: nothing settled or written.
        print(json.dumps({"pdf": rel, "search": a.text, **search(words_of(path), a.text)}, ensure_ascii=False))
        return 0
    if a.cmd != "find":
        settle(cfg, rel, path)
    if a.cmd == "ocr":
        cmd_ocr(cfg, path)
        print(json.dumps(state(cfg, rel, path, load_note(cfg, rel)), ensure_ascii=False))
        return 0
    if a.cmd == "find":
        # Words quoted by the agent, shown where they are: found as a mark's
        # are, loosely, on their page or around it; nothing written.
        at = place(words_of(path), clean_quote(a.text), a.page - 1)
        print(json.dumps({"pdf": rel, "found": at["page"] + 1 if at else 0, "boxes": at["boxes"] if at else []}))
        return 0
    if a.cmd == "state":
        note = load_note(cfg, rel)
    else:
        note = {"mark": cmd_mark, "remove": cmd_remove, "kind": cmd_kind, "note": cmd_note, "tag": cmd_tag}[a.cmd](cfg, rel, path, a)
    print(json.dumps(state(cfg, rel, path, note), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
