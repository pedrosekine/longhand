#!/usr/bin/env python3
"""longhand-read — a paper's highlights, kept in its reading note.

Reading papers (docs/plan.md, item 15): a PDF opened in the page can be
marked — a highlight, or a question — and every mark is kept in a markdown
**reading note** in the vault, one per paper, in one folder (`readings` in
the config, else `<notes>/Readings`). The PDF itself is never written to.
A mark in the note is a quote block, in page order:

    > the quoted words
    > — [[path/to/paper.pdf#page=3|p. 3]] · 2026-11-15 ^h1

    the person's own note, if any

and a question the same, opened by `> [!question]` on a line of its own
(Obsidian draws it as a question callout). The `^hN` is the mark's name,
as `^dN` names a task: Obsidian reads it as a block id.

No coordinates are kept. The words are found on their page again each time
(`pdftotext -bbox-layout`, cached by the file's size and time), loosely:
letters and digits only, ligatures and accents undone, so hyphens, line
breaks and spacing never stop a match. A phrase that is on its page more
than once keeps a few words from before it (`· after “…”`); a mark not on
its page is looked for on the pages around it, then everywhere; one found
nowhere is reported as not placed, never dropped.

    longhand-read state  --pdf P
    longhand-read mark   --pdf P --page N --text T [--kind h|q] [--y Y] [--tag T]
    longhand-read remove --pdf P --id hN
    longhand-read kind   --pdf P --id hN --kind h|q
    longhand-read note   --pdf P --id hN --text T      (empty: the note goes)
    longhand-read tag    --pdf P --tag T
    longhand-read find   --pdf P --page N --text T     (where words are, to show them; nothing kept)
    longhand-read days                                 (what was marked on each day, every paper)
    longhand-read reading [--days N]                   (papers read lately and their waiting questions, for the agent)
    longhand-read papers --tag T                       (a project's papers, by their reading notes' tags)
    longhand-read ocr    --pdf P                       (a scan read into a copy with words; one line a page)

P is the PDF's path in the vault (or a whole path). Pages are counted from
1, as the link says. `--y` is where on the page the selection began, in
points from the top: which of several equal phrases was meant. Every
command prints the paper's state as JSON: its note, its tags, its marks,
each with the rectangles to draw (page from 0, points from the top left).

A PDF in a private folder (`private` in the config, else `<notes>/Personal`)
is read but takes no marks, and the agent is never given it (`private` in
the state says so).
"""
import argparse
import datetime as dt
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from pathlib import Path

CONFIG_PATH = Path(os.environ.get("LONGHAND_CONFIG")
                   or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "longhand" / "config.json")
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "longhand"
CACHE = STATE_HOME / "reading"

LINK_RE = re.compile(
    r"^>\s*— \[\[(?P<target>[^\]|#]+)#page=(?P<page>\d+)(?:\|[^\]]*)?\]\]"
    r"(?: · (?P<day>\d{4}-\d{2}-\d{2}))?"
    r"(?: · after “(?P<after>[^”]*)”)?"
    r"(?:\s+\^(?P<id>h\d+))?\s*$")
QUESTION_RE = re.compile(r"^>\s*\[!question\][-+]?\s*$", re.I)
PDF_FIELD_RE = re.compile(r"^pdf:\s*\"?\[\[(?P<target>[^\]|#]+)(?:\|[^\]]*)?\]\]\"?\s*$")
TAG_LINE_RE = re.compile(r"^(?:#[\w/-]+\s*)+$")
TAG_RE = re.compile(r"#([\w/-]+)")


def fail(msg: str) -> None:
    print(f"longhand-read: {msg}", file=sys.stderr)
    sys.exit(1)


def load_config() -> dict:
    try:
        cfg = json.loads(CONFIG_PATH.read_text())
    except (OSError, ValueError) as e:
        fail(f"cannot read {CONFIG_PATH}: {e}")
    if not cfg.get("vault"):
        fail("config.json has no vault")
    return cfg


def notes_root(cfg: dict) -> str:
    notes = cfg.get("notes")
    if notes is None:
        parts = str((cfg.get("daily") or {}).get("dir", "")).strip("/").split("/")
        notes = parts[0] if len(parts) > 1 else ""
    return str(notes).strip("/")


def private_dirs(cfg: dict) -> list[str]:
    """Folders whose PDFs are read but never marked nor talked about with
    the agent: `private` in the config, else the person's Personal folder
    (bank statements, contracts)."""
    if "private" in cfg:
        return [str(d).strip("/") for d in cfg["private"] if str(d).strip("/")]
    notes = notes_root(cfg)
    return [f"{notes}/Personal" if notes else "Personal"]


def is_private(cfg: dict, rel: str) -> bool:
    return any(rel == d or rel.startswith(d + "/") for d in private_dirs(cfg))


def readings_dir(cfg: dict) -> str:
    """The reading notes' folder, from the vault: `readings`, else the
    person's notes (`notes`, else the daily folder's first part) + Readings."""
    if cfg.get("readings"):
        return str(cfg["readings"]).strip("/")
    notes = notes_root(cfg)
    return f"{notes}/Readings" if notes else "Readings"


# ------------------------------------------------------------- the words

def key(s: str) -> str:
    """Letters and digits only, lower case, ligatures and accents undone."""
    s = unicodedata.normalize("NFKD", s).casefold()
    return "".join(c for c in s if c.isalnum())


def ocr_copy(pdf: Path) -> Path:
    """Where a scanned PDF's copy with a text layer is kept: the state
    folder, by the original's path, size and time (plan.md item 15, step 5).
    The original is never written."""
    st = pdf.stat()
    key = hashlib.sha1(f"{pdf.resolve()}|{st.st_size}|{st.st_mtime_ns}".encode()).hexdigest()
    return CACHE / "ocr" / f"{key}.pdf"


def words_of(pdf: Path) -> list[list[dict]]:
    """Every page's words with their boxes — the PDF's own, else, for a scan
    read with `ocr`, its copy's."""
    pages = own_words(pdf)
    if not any(pages):
        copy = ocr_copy(pdf)
        if copy.is_file():
            return own_words(copy)
    return pages


TESSERACT = {"english": "eng", "german": "deu", "portuguese": "por", "spanish": "spa", "french": "fra", "italian": "ita"}


def ocr_languages(cfg: dict) -> str:
    """The person's languages (`languages` in the config) that tesseract
    has, English when none of them is there."""
    try:
        have = set(subprocess.run(["tesseract", "--list-langs"], capture_output=True, text=True, timeout=20).stdout.split()[1:])
    except (OSError, subprocess.TimeoutExpired):
        have = set()
    want = [TESSERACT.get(str(x).lower()) for x in cfg.get("languages") or ["English"]]
    langs = [c for c in want if c and c in have]
    return "+".join(langs or (["eng"] if "eng" in have or not have else sorted(have - {"osd"})[:1]))


def cmd_ocr(cfg: dict, path: Path) -> None:
    """A scanned PDF read: each page drawn (pdftoppm, 300 dpi) and read by
    tesseract into an invisible text layer, laid over the original pages in
    a copy (qpdf) — so the copy looks as the scan does and its words can be
    selected, found and marked. One JSON line per page read, as it goes."""
    if any(own_words(path)):
        fail("this PDF has words already")
    out = ocr_copy(path)
    if out.is_file():
        return
    for tool in ("pdftoppm", "tesseract", "qpdf"):
        if not shutil.which(tool):
            fail(f"{tool} is not installed: a scan cannot be read")
    n = int(subprocess.run(["qpdf", "--show-npages", str(path)], capture_output=True, text=True, timeout=60).stdout.strip() or 0)
    langs = ocr_languages(cfg)
    work = Path(tempfile.mkdtemp(prefix="longhand-ocr-"))
    try:
        layers = []
        for i in range(1, n + 1):
            print(json.dumps({"ocr": {"page": i, "pages": n, "languages": langs}}), flush=True)
            img = work / f"p{i:04d}"
            subprocess.run(["pdftoppm", "-r", "300", "-f", str(i), "-l", str(i), "-singlefile", "-png", str(path), str(img)],
                           capture_output=True, timeout=300, check=True)
            subprocess.run(["tesseract", f"{img}.png", str(img), "-l", langs, "-c", "textonly_pdf=1", "pdf"],
                           capture_output=True, timeout=600, check=True)
            layers.append(f"{img}.pdf")
        text = work / "text.pdf"
        subprocess.run(["qpdf", "--empty", "--pages", *layers, "--", str(text)], capture_output=True, timeout=300, check=True)
        out.parent.mkdir(parents=True, exist_ok=True)
        tmp = out.with_suffix(".tmp")
        subprocess.run(["qpdf", str(path), "--overlay", str(text), "--", str(tmp)], capture_output=True, timeout=300, check=True)
        os.replace(tmp, out)
    except subprocess.CalledProcessError as e:
        fail(f"{e.cmd[0]} failed: {(e.stderr or b'').decode(errors='replace').strip()[:200]}")
    finally:
        shutil.rmtree(work, ignore_errors=True)


def own_words(pdf: Path) -> list[list[dict]]:
    """Every page's words with their boxes, in reading order, from
    `pdftotext -bbox-layout` — kept by the file's size and time."""
    st = pdf.stat()
    sig = f"2|{pdf.resolve()}|{st.st_size}|{st.st_mtime_ns}"
    cached = CACHE / (hashlib.sha1(str(pdf.resolve()).encode()).hexdigest() + ".json")
    try:
        c = json.loads(cached.read_text())
        if c.get("sig") == sig:
            WIDTHS[:] = c.get("widths", [])
            return c["pages"]
    except (OSError, ValueError):
        pass
    try:
        out = subprocess.run(["pdftotext", "-bbox-layout", str(pdf), "-"],
                             capture_output=True, text=True, timeout=120).stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        fail(f"pdftotext: {e}")
    pages: list[list[dict]] = []
    widths: list[float] = []
    line = 0
    for m in re.finditer(r"<page width=\"([\d.]+)\"|<line\b|<word xMin=\"([\d.]+)\" yMin=\"([\d.]+)\" xMax=\"([\d.]+)\" yMax=\"([\d.]+)\">(.*?)</word>", out):
        tok = m.group(0)
        if tok.startswith("<page"):
            pages.append([])
            widths.append(float(m.group(1)))
        elif tok == "<line":
            line += 1
        elif pages:
            pages[-1].append({"t": html.unescape(m.group(6)), "x0": float(m.group(2)), "y0": float(m.group(3)),
                              "x1": float(m.group(4)), "y1": float(m.group(5)), "l": line})
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        tmp = cached.with_suffix(".tmp")
        tmp.write_text(json.dumps({"sig": sig, "pages": pages, "widths": widths}))
        os.replace(tmp, cached)
    except OSError:
        pass
    WIDTHS[:] = widths
    return pages


# Each page's width in points, from the last words_of.
WIDTHS: list[float] = []


def text_span(pages: list[list[dict]]) -> dict | None:
    """Where the text stands across the page, left and right, in points: the
    words' edges, leaving out the outermost few (a page number, a line
    number in the margin), so the page can be fitted by its text rather than
    its paper."""
    x0s = sorted(w["x0"] for p in pages for w in p)
    x1s = sorted(w["x1"] for p in pages for w in p)
    if len(x0s) < 20 or not WIDTHS:
        return None
    left, right = x0s[len(x0s) // 50], x1s[len(x1s) - 1 - len(x1s) // 50]
    width = max(set(WIDTHS), key=WIDTHS.count)
    if right - left < width * 0.3:
        return None
    return {"x0": round(left, 1), "x1": round(right, 1), "w": round(width, 1)}


def page_keys(words: list[dict]) -> tuple[str, list[int]]:
    """A page's words as one key string, and for each of its characters the
    word it came from."""
    s, owner = [], []
    for i, w in enumerate(words):
        k = key(w["t"])
        s.append(k)
        owner.extend([i] * len(k))
    return "".join(s), owner


def occurrences(hay: str, needle: str) -> list[int]:
    out, at = [], hay.find(needle)
    while at >= 0:
        out.append(at)
        at = hay.find(needle, at + 1)
    return out


def rects(words: list[dict], first: int, last: int) -> list[list[float]]:
    """One rectangle per line the words first..last stand on."""
    out: list[list[float]] = []
    cur = None
    for w in words[first:last + 1]:
        if cur and cur[4] == w["l"]:
            cur[0], cur[1] = min(cur[0], w["x0"]), min(cur[1], w["y0"])
            cur[2], cur[3] = max(cur[2], w["x1"]), max(cur[3], w["y1"])
        else:
            cur = [w["x0"], w["y0"], w["x1"], w["y1"], w["l"]]
            out.append(cur)
    # Lines set close together have boxes that cross (each as tall as its
    # font); drawn see-through, the crossing showed darker. Two lines that
    # cross meet halfway instead.
    for a, b in zip(out, out[1:]):
        if b[1] < a[3] and b[3] > a[3]:
            a[3] = b[1] = (a[3] + b[1]) / 2
    return [[round(r[0], 2), round(r[1], 2), round(r[2] - r[0], 2), round(r[3] - r[1], 2)] for r in out]


def place(pages: list[list[dict]], text: str, page: int, after: str = "", y: float | None = None) -> dict | None:
    """Where `text` is: on its page (from 0), else the pages around it, else
    anywhere; across a page's foot into the next if need be. None when it is
    nowhere. With several on one page: the one after `after`, else the one
    nearest `y`, else the first."""
    q = key(text)
    if not q or not pages:
        return None
    n = len(pages)
    order = [p for d in (0, -1, 1, -2, 2) for p in [page + d] if 0 <= p < n]
    order += [p for p in range(n) if p not in order]
    keys = {}

    def k(p):
        if p not in keys:
            keys[p] = page_keys(pages[p])
        return keys[p]

    for p in order:
        s, owner = k(p)
        hits = occurrences(s, q)
        if hits:
            if len(hits) > 1:
                a = key(after)
                if a:
                    fit = [h for h in hits if s[:h].endswith(a)]
                    hits = fit or hits
                if len(hits) > 1 and y is not None:
                    hits.sort(key=lambda h: abs(pages[p][owner[h]]["y0"] - y))
            h = hits[0]
            first, last = owner[h], owner[h + len(q) - 1]
            return {"page": p, "first": first, "last": last, "many": len(occurrences(s, q)) > 1,
                    "boxes": [{"page": p, "rects": rects(pages[p], first, last)}]}
        # Over the foot of this page into the next.
        if p + 1 < n:
            s2, owner2 = k(p + 1)
            joined = s + s2
            for h in occurrences(joined, q):
                if h < len(s) < h + len(q):
                    first, last = owner[h], owner2[h + len(q) - 1 - len(s)]
                    return {"page": p, "first": first, "last": len(pages[p]) - 1, "many": False,
                            "boxes": [{"page": p, "rects": rects(pages[p], first, len(pages[p]) - 1)},
                                      {"page": p + 1, "rects": rects(pages[p + 1], 0, last)}]}
    return None


def before_words(words: list[dict], first: int, count: int = 3) -> str:
    return " ".join(w["t"] for w in words[max(0, first - count):first])


def clean_quote(text: str) -> str:
    """The selection as one line: Qt marks a hyphen it broke a line at with
    U+FFFE (or a soft hyphen); the word is joined again."""
    text = re.sub("[\ufffe\u00ad]\\s*", "", text)
    text = re.sub(r"(\w)-\r?\n(\w)", r"\1\2", text)
    return re.sub(r"\s+", " ", text).strip()


# -------------------------------------------------------------- the note

class Note:
    """A reading note: its lines, and the marks found in them."""

    def __init__(self, path: Path, lines: list[str]):
        self.path = path
        self.lines = lines

    @staticmethod
    def blank(path: Path, rel: str) -> "Note":
        return Note(path, ["---", f'pdf: "[[{rel}]]"', "---", f"# {Path(rel).stem}", ""])

    def marks(self) -> list[dict]:
        """Each mark: where its block starts and ends (its note included)."""
        out, i, L = [], 0, self.lines
        while i < len(L):
            if not L[i].startswith(">"):
                i += 1
                continue
            start = i
            while i < len(L) and L[i].startswith(">"):
                i += 1
            block = L[start:i]
            m = LINK_RE.match(block[-1])
            if not m:
                continue
            kind = "q" if QUESTION_RE.match(block[0]) else "h"
            body = block[1:-1] if kind == "q" else block[:-1]
            text = " ".join(re.sub(r"^>\s?", "", b).strip() for b in body).strip()
            # The person's note: what follows, up to the next quote or heading.
            j = i
            while j < len(L) and not L[j].startswith(">") and not L[j].startswith("#"):
                j += 1
            note = "\n".join(L[i:j]).strip()
            while j > i and L[j - 1].strip() == "":
                j -= 1
            out.append({"id": m.group("id") or "", "kind": kind, "page": int(m.group("page")),
                        "day": m.group("day") or "", "after": m.group("after") or "", "text": text,
                        "note": note, "start": start, "end": j, "target": m.group("target")})
        return out

    def tags(self) -> list[str]:
        body = self.body_start()
        out = []
        for line in self.lines[body:]:
            if line.startswith(">"):
                break
            if TAG_LINE_RE.match(line.strip()):
                out += TAG_RE.findall(line)
        return out

    def body_start(self) -> int:
        if self.lines and self.lines[0] == "---":
            for i in range(1, len(self.lines)):
                if self.lines[i] == "---":
                    return i + 1
        return 0

    def save(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        text = "\n".join(self.lines).rstrip("\n") + "\n"
        fd, tmp = tempfile.mkstemp(dir=self.path.parent, prefix=".longhand-read-")
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, self.path)


def block_lines(kind: str, text: str, rel: str, page: int, day: str, after: str, mid: str) -> list[str]:
    link = f"> — [[{rel}#page={page}|p. {page}]] · {day}" + (f" · after “{after}”" if after else "") + f" ^{mid}"
    return (["> [!question]"] if kind == "q" else []) + [f"> {text}", link]


def find_note(cfg: dict, rel: str) -> Path | None:
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    if not folder.is_dir():
        return None
    for p in sorted(folder.glob("*.md")):
        try:
            with p.open() as f:
                head = [next(f, "") for _ in range(12)]
        except OSError:
            continue
        for line in head:
            m = PDF_FIELD_RE.match(line.strip())
            if m and m.group("target").strip() == rel:
                return p
    return None


def new_note_path(cfg: dict, rel: str) -> Path:
    """The PDF's own name; when that is taken, with its folder added, then a
    number."""
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    stem = Path(rel).stem
    parent = Path(rel).parent.name
    names = [stem] + ([f"{stem} ({parent})"] if parent else [])
    for name in names:
        if not (folder / f"{name}.md").exists():
            return folder / f"{name}.md"
    n = 2
    while (folder / f"{names[-1]} {n}.md").exists():
        n += 1
    return folder / f"{names[-1]} {n}.md"


# -------------------------------------------------------------- commands

def rel_of(cfg: dict, pdf: str) -> tuple[str, Path]:
    vault = Path(cfg["vault"])
    path = Path(pdf) if pdf.startswith("/") else vault / pdf
    try:
        rel = str(path.resolve().relative_to(vault.resolve()))
    except ValueError:
        rel = str(path)
    if not path.is_file():
        fail(f"no PDF at {path}")
    return rel, path


def state(cfg: dict, rel: str, path: Path, note: Note | None) -> dict:
    pages = words_of(path)
    has_text = any(pages)
    scanned = not any(own_words(path))
    copy = ocr_copy(path) if scanned else None
    out = {"pdf": rel, "note": "", "tags": [], "marks": [], "unplaced": 0, "text": has_text, "pages": len(pages),
           "span": text_span(pages), "private": is_private(cfg, rel), "scanned": scanned,
           "ocr": str(copy) if copy and copy.is_file() else ""}
    if not note:
        return out
    out["note"] = str(note.path.relative_to(Path(cfg["vault"]))) if note.path.is_relative_to(Path(cfg["vault"])) else str(note.path)
    out["tags"] = note.tags()
    for m in note.marks():
        at = place(pages, m["text"], m["page"] - 1, m["after"]) if has_text else None
        out["marks"].append({"id": m["id"], "kind": m["kind"], "page": m["page"], "day": m["day"], "text": m["text"],
                             "note": m["note"], "placed": at is not None,
                             "found": at["page"] + 1 if at else 0, "boxes": at["boxes"] if at else []})
        if not at:
            out["unplaced"] += 1
    return out


def load_note(cfg: dict, rel: str) -> Note | None:
    p = find_note(cfg, rel)
    return Note(p, p.read_text().split("\n")) if p else None


def next_id(note: Note) -> str:
    nums = [int(m["id"][1:]) for m in note.marks() if m["id"]]
    return f"h{max(nums, default=0) + 1}"


def by_id(note: Note, mid: str) -> dict:
    for m in note.marks():
        if m["id"] == mid:
            return m
    fail(f"no mark {mid} in {note.path.name}")


def cmd_mark(cfg, rel, path, a) -> Note:
    if is_private(cfg, rel):
        fail("private: a PDF in a private folder takes no marks")
    text = clean_quote(a.text)
    if not key(text):
        fail("nothing to mark: no words selected")
    pages = words_of(path)
    at = place(pages, text, a.page - 1, y=a.y)
    after = ""
    if at and at["many"]:
        after = before_words(pages[at["page"]], at["first"])
    page = at["page"] + 1 if at else a.page
    note = load_note(cfg, rel)
    if note is None:
        note = Note.blank(new_note_path(cfg, rel), rel)
        if a.tag:
            note.lines += [f"#{a.tag.lstrip('#')}", ""]
    mid = next_id(note)
    day = a.day or dt.date.today().isoformat()
    lines = block_lines(a.kind, text, rel, page, day, after, mid)
    # In page order: after every mark on an earlier page, and those on the
    # same page that stand above it.
    marks = note.marks()
    y_new = pages[at["page"]][at["first"]]["y0"] if at else None
    insert = None
    for m in marks:
        if m["page"] < page:
            insert = m["end"]
        elif m["page"] == page:
            mat = place(pages, m["text"], m["page"] - 1, m["after"]) if y_new is not None else None
            y_m = pages[mat["page"]][mat["first"]]["y0"] if mat else None
            if y_new is None or y_m is None or y_m <= y_new:
                insert = m["end"]
    if insert is None:
        if marks:
            insert = marks[0]["start"]
            lines = lines + [""]
        else:
            insert = len(note.lines)
            while insert > 0 and note.lines[insert - 1].strip() == "":
                insert -= 1
            lines = [""] + lines
    else:
        lines = [""] + lines
    note.lines[insert:insert] = lines
    note.save()
    return note


def cmd_remove(cfg, rel, path, a) -> Note:
    note = load_note(cfg, rel) or fail("no reading note")
    m = by_id(note, a.id)
    start, end = m["start"], m["end"]
    while end < len(note.lines) and note.lines[end].strip() == "":
        end += 1
    if start > 0 and note.lines[start - 1].strip() == "" and end >= len(note.lines):
        start -= 1
    del note.lines[start:end]
    note.save()
    return note


def cmd_kind(cfg, rel, path, a) -> Note:
    note = load_note(cfg, rel) or fail("no reading note")
    m = by_id(note, a.id)
    if m["kind"] != a.kind:
        if a.kind == "q":
            note.lines.insert(m["start"], "> [!question]")
        else:
            del note.lines[m["start"]]
        note.save()
    return note


def cmd_note(cfg, rel, path, a) -> Note:
    note = load_note(cfg, rel) or fail("no reading note")
    m = by_id(note, a.id)
    # The block's quote lines end where its link is.
    link = m["start"]
    while not LINK_RE.match(note.lines[link]):
        link += 1
    new = [""] + a.text.strip().split("\n") if a.text.strip() else []
    note.lines[link + 1:m["end"]] = new
    note.save()
    return note


def cmd_tag(cfg, rel, path, a) -> Note:
    note = load_note(cfg, rel)
    if note is None:
        note = Note.blank(new_note_path(cfg, rel), rel)
    tag = a.tag.lstrip("#")
    if tag in note.tags():
        return note
    start = note.body_start()
    for i in range(start, len(note.lines)):
        line = note.lines[i].strip()
        if line.startswith(">"):
            break
        if TAG_LINE_RE.match(line):
            note.lines[i] = note.lines[i].rstrip() + f" #{tag}"
            note.save()
            return note
    # After the title.
    at = start
    while at < len(note.lines) and not note.lines[at].startswith("# "):
        at += 1
    at = at + 1 if at < len(note.lines) else start
    note.lines[at:at] = ["", f"#{tag}"]
    note.save()
    return note


def cmd_days(cfg: dict) -> dict:
    """Each day a paper was marked, from the reading notes' own days: the
    papers, their names, how many highlights and questions that day — what
    the day page shows as read (plan.md item 15, step 3). Read from the
    notes alone: no PDF is opened."""
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    days: dict[str, dict] = {}
    for f in sorted(folder.glob("*.md")) if folder.is_dir() else []:
        try:
            note = Note(f, f.read_text().split("\n"))
        except OSError:
            continue
        pdf = ""
        for line in note.lines[:12]:
            m = PDF_FIELD_RE.match(line.strip())
            if m:
                pdf = m.group("target").strip()
                break
        if not pdf:
            continue
        for m in note.marks():
            if not m["day"]:
                continue
            row = days.setdefault(m["day"], {}).setdefault(pdf, {"pdf": pdf, "title": Path(pdf).stem, "h": 0, "q": 0,
                                                                  "note": str(f.relative_to(Path(cfg["vault"])))})
            row[m["kind"]] += 1
    return {"days": {d: sorted(v.values(), key=lambda r: r["title"].lower()) for d, v in sorted(days.items())}}


def answered_marks(cfg: dict, rel: str) -> set[str]:
    """The marks a paper's conversation has answered: pointed at by a
    message that has an answer (the agent's notes/<md5 of the path>.json,
    as the page reads it)."""
    where = Path(cfg["vault"]) / str(cfg.get("agentDir") or "agents/longhand") / "notes" / \
        (hashlib.md5(rel.encode("utf-8")).hexdigest()[:16] + ".json")
    try:
        turns = json.loads(where.read_text()).get("turns") or []
    except (OSError, ValueError):
        return set()
    out = set()
    for a, b in zip(turns, turns[1:]):
        if a.get("role") == "student" and a.get("marks") and b.get("role") == "agent" and not b.get("error"):
            out.update(a["marks"])
    return out


def cmd_reading(cfg: dict, days: int, today: dt.date | None = None) -> dict:
    """What the person is reading, for the day's agent and the planner
    (plan.md item 15, after step 5): each paper marked in the last `days`
    days or with questions still waiting — its project, the days it was
    marked on, and the questions no answer has come to. From the reading
    notes and the papers' conversations; no PDF is opened. A paper in a
    private folder is never listed."""
    today = today or dt.date.today()
    since = (today - dt.timedelta(days=days - 1)).isoformat()
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    papers = []
    for f in sorted(folder.glob("*.md")) if folder.is_dir() else []:
        try:
            note = Note(f, f.read_text().split("\n"))
        except OSError:
            continue
        pdf = next((m.group("target").strip() for line in note.lines[:12] for m in [PDF_FIELD_RE.match(line.strip())] if m), "")
        if not pdf or is_private(cfg, pdf):
            continue
        marks = note.marks()
        answered = answered_marks(cfg, pdf)
        recent: dict[str, dict] = {}
        for m in marks:
            if m["day"] >= since:
                recent.setdefault(m["day"], {"h": 0, "q": 0})[m["kind"]] += 1
        waiting = [{"id": m["id"], "page": m["page"], "text": m["text"][:240], "note": m["note"][:240]}
                   for m in marks if m["kind"] == "q" and m["id"] not in answered]
        if not recent and not waiting:
            continue
        papers.append({"pdf": pdf, "title": Path(pdf).stem, "tags": note.tags(),
                       "days": [{"day": d, **c} for d, c in sorted(recent.items())],
                       "last": max((m["day"] for m in marks if m["day"]), default=""), "waiting": waiting})
    papers.sort(key=lambda r: r["last"], reverse=True)
    return {"since": since, "papers": papers}


def cmd_papers(cfg: dict, tag: str) -> dict:
    """A project's papers (plan.md item 5's first part, 2026-11-16): every
    reading note carrying its tag, with its marks counted, the questions
    still waiting, and the last day it was marked — the newest first."""
    tag = tag.lstrip("#").lower()
    folder = Path(cfg["vault"]) / readings_dir(cfg)
    out = []
    for f in sorted(folder.glob("*.md")) if folder.is_dir() else []:
        try:
            note = Note(f, f.read_text().split("\n"))
        except OSError:
            continue
        if tag not in [t.lower() for t in note.tags()]:
            continue
        pdf = next((m.group("target").strip() for line in note.lines[:12] for m in [PDF_FIELD_RE.match(line.strip())] if m), "")
        if not pdf:
            continue
        marks = note.marks()
        answered = answered_marks(cfg, pdf)
        out.append({"pdf": pdf, "title": Path(pdf).stem, "h": sum(1 for m in marks if m["kind"] == "h"),
                    "q": sum(1 for m in marks if m["kind"] == "q"),
                    "waiting": sum(1 for m in marks if m["kind"] == "q" and m["id"] not in answered),
                    "last": max((m["day"] for m in marks if m["day"]), default="")})
    out.sort(key=lambda r: (r["last"], r["title"]), reverse=True)
    return {"tag": tag, "papers": out}


def main() -> int:
    ap = argparse.ArgumentParser(prog="longhand-read", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("days")
    rp = sub.add_parser("reading")
    rp.add_argument("--days", type=int, default=7)
    pp = sub.add_parser("papers")
    pp.add_argument("--tag", required=True)
    for name in ("state", "mark", "remove", "kind", "note", "tag", "find", "ocr"):
        p = sub.add_parser(name)
        p.add_argument("--pdf", required=True)
        if name == "find":
            p.add_argument("--page", type=int, required=True)
            p.add_argument("--text", required=True)
        if name == "mark":
            p.add_argument("--page", type=int, required=True)
            p.add_argument("--text", required=True)
            p.add_argument("--kind", choices=("h", "q"), default="h")
            p.add_argument("--y", type=float)
            p.add_argument("--tag", default="")
            p.add_argument("--day", default="")
        if name in ("remove", "kind", "note"):
            p.add_argument("--id", required=True)
        if name == "kind":
            p.add_argument("--kind", choices=("h", "q"), required=True)
        if name == "note":
            p.add_argument("--text", default="")
        if name == "tag":
            p.add_argument("--tag", required=True)
    a = ap.parse_args()
    cfg = load_config()
    if a.cmd == "days":
        print(json.dumps(cmd_days(cfg), ensure_ascii=False))
        return 0
    if a.cmd == "papers":
        print(json.dumps(cmd_papers(cfg, a.tag), ensure_ascii=False))
        return 0
    if a.cmd == "reading":
        print(json.dumps(cmd_reading(cfg, max(1, a.days)), ensure_ascii=False))
        return 0
    rel, path = rel_of(cfg, a.pdf)
    if a.cmd == "ocr":
        cmd_ocr(cfg, path)
        print(json.dumps(state(cfg, rel, path, load_note(cfg, rel)), ensure_ascii=False))
        return 0
    if a.cmd == "find":
        # Words quoted by the agent, shown where they are: found as a mark's
        # are, loosely, on their page or around it; nothing written.
        at = place(words_of(path), clean_quote(a.text), a.page - 1)
        print(json.dumps({"pdf": rel, "found": at["page"] + 1 if at else 0, "boxes": at["boxes"] if at else []}))
        return 0
    if a.cmd == "state":
        note = load_note(cfg, rel)
    else:
        note = {"mark": cmd_mark, "remove": cmd_remove, "kind": cmd_kind, "note": cmd_note, "tag": cmd_tag}[a.cmd](cfg, rel, path, a)
    print(json.dumps(state(cfg, rel, path, note), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
