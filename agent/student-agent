#!/usr/bin/env python3
"""student-agent — the loop between today's note and the model.

    student-agent run --trigger <kind> [--hash <block>[,<block>…]] [--date YYYY.MM.DD]
    student-agent chat --hash <block> --message <text>         # dive in: continue that block's session
    student-agent ack --hash <block>                           # the student has seen the reply
    student-agent accept --hash <block> --index <n>            # run a proposal through the CLI
    student-agent tasks [--days 7]                             # open checkboxes across daily notes, JSON
    student-agent next [--days 7]                              # tasks + open suggestions/observations, JSON
    student-agent dismiss --date D --kind suggestion|observation --index <n>
    student-agent curriculum                                   # convert PDFs in the curriculum folder to .md
    student-agent context --trigger <kind> [--hash <block>]   # payload only, no model
    student-agent state [--date YYYY.MM.DD]                    # today's state JSON
    student-agent stats [--days 14 | --since YYYY-MM-DD] [--json]   # how the tool is used
    student-agent projects                                     # the tags that exist, with their next session
    student-agent install                                      # opencode agent def + dirs

One pass, then exit. Nothing is resident. The model gets no tools: everything
it may see is assembled here from an allowlist (today's note minus private
blocks, the agent's own knowledge files, the curriculum folder, the timer and
deadline report), logged verbatim to the payload log before inference, and
everything it says back is applied here — transcript, state file, knowledge
files, cost ledger. No code path in this file opens anything under the daily
notes folder for writing; `guard_write` enforces that.

Config: ~/.config/omarchy-student/config.json (see config.example.json).
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import blocks as blocklib  # noqa: E402

TRIGGERS = ("checkbox", "mention", "question", "tick", "open")
LINK_LINE = re.compile(r"^\[\[[^\]\n]*\|agent\]\]$")
KNOWLEDGE_FILE = re.compile(r"^(profile\.md|patterns\.md|projects/[A-Za-z0-9._ -]{1,64}\.md)$")

CONFIG_PATH = Path(os.environ.get("OMARCHY_STUDENT_CONFIG")
                   or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "omarchy-student" / "config.json")
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "omarchy-student"


class Fail(Exception):
    pass


# ----------------------------------------------------------------- config

def load_config() -> dict:
    try:
        cfg = json.loads(CONFIG_PATH.read_text())
    except FileNotFoundError:
        raise Fail(f"no config at {CONFIG_PATH}")
    except json.JSONDecodeError as e:
        raise Fail(f"config is not valid JSON: {e}")
    if not cfg.get("vault") or not cfg.get("daily", {}).get("dir"):
        raise Fail("config needs vault and daily.dir")
    return cfg


def moment_to_strftime(fmt: str) -> str:
    return (fmt.replace("YYYY", "%Y").replace("YY", "%y").replace("MM", "%m")
            .replace("DD", "%d").replace("HH", "%H").replace("mm", "%M"))


def day_stamp(cfg: dict, date: dt.date) -> str:
    return date.strftime(moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD")))


class Paths:
    def __init__(self, cfg: dict, date: dt.date):
        self.vault = Path(cfg["vault"])
        self.stamp = day_stamp(cfg, date)
        self.daily_dir = self.vault / cfg["daily"]["dir"]
        self.note = self.daily_dir / f"{self.stamp}.md"
        self.agent_dir = self.vault / cfg.get("agentDir", "agents/student")
        self.transcript = self.agent_dir / "daily" / f"{self.stamp}.md"
        self.state = self.agent_dir / "daily" / f"{self.stamp}.json"
        self.knowledge = self.agent_dir / "knowledge"
        # System-owned memory of the student's decisions: the one file under
        # knowledge/ the model never writes. It reads it, so a dismissed
        # suggestion stays dismissed.
        self.dismissed = self.agent_dir / "knowledge" / "dismissed.md"
        self.curriculum = (self.vault / cfg["curriculum"]) if cfg.get("curriculum") else None
        self.payloads = STATE_HOME / "payloads"
        self.ledger = STATE_HOME / "cost.tsv"
        self.cwd = STATE_HOME / "agent-cwd"


# ------------------------------------------------------------------ writes

def guard_write(paths: Paths, target: Path) -> None:
    """The one rule that lets the agent say 'I never touched your prose'."""
    t = target.resolve()
    d = paths.daily_dir.resolve()
    if t == d or d in t.parents:
        raise Fail(f"refusing to write under the daily folder: {target}")


def write_atomic(paths: Paths, target: Path, text: str) -> None:
    guard_write(paths, target)
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, target)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def append_text(paths: Paths, target: Path, text: str) -> None:
    guard_write(paths, target)
    target.parent.mkdir(parents=True, exist_ok=True)
    with open(target, "a") as f:
        f.write(text)


# ----------------------------------------------------------------- context

def note_is_private(blks: list[dict]) -> bool:
    for b in blks:
        if b["kind"] == "frontmatter":
            return re.search(r"^agent:\s*false\s*$", b["text"], re.M) is not None
    return False


def visible_blocks(blks: list[dict]) -> list[dict]:
    return [b for b in blks if not b["private"] and not LINK_LINE.match(b["text"])]


def read_tree(root: Path | None, suffix: str = ".md") -> list[tuple[str, str]]:
    if root is None or not root.is_dir():
        return []
    out = []
    for p in sorted(root.rglob(f"*{suffix}")):
        if p.is_file():
            out.append((str(p.relative_to(root)), p.read_text(errors="replace")))
    return out


def pomo_report() -> str:
    try:
        r = subprocess.run(["pomo", "report", "--json"], capture_output=True, text=True, timeout=10)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def load_state(paths: Paths) -> dict:
    try:
        return json.loads(paths.state.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {"date": paths.stamp, "blocks": {}, "suggestions": [], "runs": []}


# Stopwords that tell the student's languages apart. Only the languages in
# the config are candidates; the first is the default when a block is too
# short or too ambiguous to tell. The model is then *told* the language, so
# it never has to guess — a guess is how an English note got a Dutch reply.
STOPWORDS = {
    "English": {"the", "and", "is", "are", "to", "of", "in", "on", "what", "this", "that", "with", "for", "it",
                "was", "have", "has", "not", "do", "did", "does", "my", "you", "i", "we", "about", "week", "how"},
    "German": {"der", "die", "das", "und", "ist", "sind", "nicht", "ich", "du", "wir", "mit", "für", "auf", "ein",
               "eine", "wie", "was", "habe", "hat", "haben", "noch", "auch", "diese", "dieser", "über", "zu", "im"},
    "Portuguese": {"o", "a", "os", "as", "e", "é", "são", "não", "eu", "você", "nós", "com", "para", "um", "uma",
                   "que", "como", "tenho", "tem", "esta", "este", "sobre", "semana", "mais", "muito", "isso", "está"},
    "Spanish": {"el", "la", "los", "las", "y", "es", "son", "no", "yo", "tú", "nosotros", "con", "para", "un", "una",
                "que", "cómo", "tengo", "tiene", "esta", "este", "sobre", "semana", "más", "muy", "esto", "está"},
    "Dutch": {"de", "het", "een", "en", "is", "zijn", "niet", "ik", "je", "wij", "met", "voor", "op", "wat", "hoe",
              "heb", "heeft", "hebben", "nog", "ook", "deze", "over", "naar", "van"},
    "French": {"le", "la", "les", "et", "est", "sont", "pas", "je", "tu", "nous", "avec", "pour", "un", "une",
               "que", "comment", "ai", "a", "avons", "cette", "sur", "semaine", "plus", "très", "dans", "du"},
    "Italian": {"il", "la", "gli", "le", "e", "è", "sono", "non", "io", "tu", "noi", "con", "per", "un", "una",
                "che", "come", "ho", "ha", "abbiamo", "questa", "questo", "sulla", "settimana", "più", "molto"},
}


def languages(cfg: dict) -> list[str]:
    ls = cfg.get("languages")
    if isinstance(ls, list) and ls:
        return [str(x) for x in ls]
    return [str(cfg.get("language") or "English")]


def detect_language(text: str, candidates: list[str]) -> str:
    words = re.findall(r"[\w']+", text.lower())
    best, best_n = candidates[0], 0
    for lang in candidates:
        sw = STOPWORDS.get(lang)
        if not sw:
            continue
        n = sum(1 for w in words if w in sw)
        if n > best_n:
            best, best_n = lang, n
    return best if best_n >= 2 else candidates[0]


def language_line(cfg: dict, sample: str = "") -> str:
    ls = languages(cfg)
    chosen = detect_language(sample, ls) if sample else ls[0]
    others = ", ".join(l for l in ls if l != chosen)
    line = f"The student wrote this in {chosen}. Answer in {chosen}."
    if others:
        line += f" The student also uses {others}; never answer in any other language than these."
    return line


CHECKBOX_ANY = re.compile(r"^\s*[-*+] \[([ xX])\] (.*\S)")


def outcomes(cfg: dict, days: int = 14) -> list[dict]:
    """Intention → outcome, computed here, never guessed: every checkbox in
    the last `days` daily notes with whether it was ticked."""
    fmt = moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD"))
    daily = Path(cfg["vault"]) / cfg["daily"]["dir"]
    today = dt.date.today()
    out = []
    for f in sorted(daily.glob("*.md"), reverse=True):
        try:
            d = dt.datetime.strptime(f.stem, fmt).date()
        except ValueError:
            continue
        age = (today - d).days
        if age < 0 or age >= days:
            continue
        try:
            lines = f.read_text().split("\n")
        except OSError:
            continue
        for i, line in enumerate(lines):
            m = CHECKBOX_ANY.match(line)
            if m:
                out.append({"date": f.stem, "file": str(f), "line": i, "text": m.group(2),
                            "done": m.group(1) != " ", "age": age})
    return out


def outcomes_section(cfg: dict) -> list[str]:
    rows = outcomes(cfg)
    if not rows:
        return ["(no checkboxes in the last 14 days)"]
    parts = []
    by_day: dict[str, list[dict]] = {}
    for r in rows:
        by_day.setdefault(r["date"], []).append(r)
    for day, items in by_day.items():
        done = [i["text"] for i in items if i["done"]]
        open_ = [i["text"] for i in items if not i["done"]]
        parts.append(f"{day}: {len(done)} done, {len(open_)} open")
        for t in done:
            parts.append(f"  ✓ {t}")
        for t in open_:
            parts.append(f"  ○ {t}")
    return parts


def read_dismissed(paths: Paths) -> list[str]:
    try:
        return [l[2:].strip() for l in paths.dismissed.read_text().split("\n") if l.startswith("- ")]
    except FileNotFoundError:
        return []


def norm(text: str) -> str:
    return re.sub(r"\W+", " ", text.lower()).strip()


FILLER = {"the", "and", "or", "is", "are", "was", "be", "it", "its", "a", "an", "on", "in", "as", "so", "that", "this",
          "with", "for", "of", "to", "at", "by", "if", "not", "now", "still", "yet", "whether", "which", "what", "into",
          "from", "one", "your", "you", "can", "will", "has", "have", "needs", "need", "means", "counts", "count",
          "ask", "check", "find", "out", "confirm", "add", "enter", "list", "entry", "task", "tasks", "note", "there",
          "der", "die", "das", "und", "ist", "ein", "eine", "o", "a", "e", "que", "el", "la", "y", "es", "de", "um", "uma"}


def words(text: str) -> set[str]:
    return {w for w in norm(text).split() if len(w) > 1 and w not in FILLER}


def similar(a: str, b: str) -> bool:
    """Same suggestion in other words: the content words mostly coincide."""
    wa, wb = words(a), words(b)
    if not wa or not wb:
        return norm(a) == norm(b)
    return len(wa & wb) / min(len(wa), len(wb)) >= 0.5


def is_known(text: str, known: list[str]) -> bool:
    return any(similar(text, k) for k in known)


def earlier_today(paths: Paths, fired: list[dict]) -> list[str]:
    """What the agent already said today, compact: one line of the block,
    then the reply. Lets the next call refer back instead of repeating."""
    state = load_state(paths)
    skip = {b["hash"] for b in fired}
    seen_groups: set[str] = set()
    out = []
    for h, rec in state.get("blocks", {}).items():
        if rec.get("state") != "reply" or not rec.get("reply") or h in skip:
            continue
        key = ",".join(rec["group"]) if isinstance(rec.get("group"), list) else h
        if key in seen_groups:
            continue
        seen_groups.add(key)
        head = (rec.get("head") or "").strip()
        reply = " ".join(rec["reply"].split())
        if len(reply) > 240:
            reply = reply[:237] + "…"
        out.append(f"- {rec.get('at', '')[11:16]} on \"{head[:80]}\": {reply}"
                   + (f" [then a chat of {len(rec['chat'])} turns]" if rec.get("chat") else ""))
    raised: list[str] = []
    for x in state.get("suggestions", []) + state.get("observations", []):
        text = " ".join(str(x.get("text", "")).split())
        if text and not is_known(text, raised):
            raised.append(text[:160])
    if raised:
        out.append("Already raised today (do not raise again): " + " | ".join(raised))
    return out


def build_payload(paths: Paths, trigger: str, fired: list[dict], visible: list[dict], cfg: dict | None = None) -> str:
    sample = "\n".join(b["text"] for b in fired) if fired else "\n".join(b["text"] for b in visible[-3:])
    parts = ["# Language", language_line(cfg or {}, sample), "", "# Trigger", f"kind: {trigger}"]
    if fired:
        parts.append("block: " + ",".join(b["hash"] for b in fired)
                     + (" (a list; treat the items as one submission)" if len(fired) > 1 else ""))
        parts.append("")
        parts.append("\n".join("> " + l for b in fired for l in b["text"].split("\n")))
    parts += ["", "# Today's note (private parts removed)", ""]
    parts.append("\n\n".join(b["text"] for b in visible) or "(empty)")

    knowledge = read_tree(paths.knowledge)
    parts += ["", "# Your knowledge files", ""]
    if knowledge:
        for name, text in knowledge:
            parts += [f"## {name}", "", text.rstrip(), ""]
    else:
        parts.append("(none yet)")

    curriculum = read_tree(paths.curriculum)
    if curriculum:
        parts += ["", "# Curriculum (student-provided, read-only)", ""]
        for name, text in curriculum:
            parts += [f"## {name}", "", text.rstrip(), ""]

    earlier = earlier_today(paths, fired)
    if earlier:
        parts += ["", "# What you already said today (refer back, do not repeat)", ""] + earlier

    parts += ["", "# Intentions and outcomes (last 14 days, computed from the notes)", ""]
    parts += outcomes_section(cfg or {})

    dismissed = read_dismissed(paths)
    if dismissed:
        parts += ["", "# Suggestions the student has dismissed (do not raise again unless the evidence changed)", ""]
        parts += [f"- {d}" for d in dismissed]

    report = pomo_report()
    parts += ["", "# Timer and deadlines (pomo report --json)", "", report or "(unavailable)"]
    return "\n".join(parts) + "\n"


# ------------------------------------------------------------------- model

def project_of(prop: dict) -> str:
    """A proposal's project. Models that learned the old word say "subject"."""
    return str(prop.get("project") or prop.get("subject") or "")


def run_model(cfg: dict, paths: Paths, payload: str, session: str = "", message: str = "Context follows on stdin.") -> dict:
    """Run one opencode pass. Returns {text, session, cost, tokens, events, error}.

    With `session`, continues an existing opencode session (dive-in), so the
    model keeps what it already said about that block."""
    paths.cwd.mkdir(parents=True, exist_ok=True)
    cmd = [cfg.get("opencode", "opencode"), "run", "--pure", "--format", "json",
           "--agent", cfg.get("agent", "student"), "--dir", str(paths.cwd)]
    if cfg.get("model"):
        cmd += ["--model", cfg["model"]]
    # Reasoning effort, as opencode names it per model (low / high / max);
    # absent means the provider's default.
    if cfg.get("variant"):
        cmd += ["--variant", cfg["variant"]]
    if session:
        cmd += ["--session", session]
    cmd.append(message)
    try:
        proc = subprocess.run(cmd, input=payload, capture_output=True, text=True, timeout=600)
    except FileNotFoundError:
        raise Fail(f"opencode not found ({cmd[0]})")
    except subprocess.TimeoutExpired:
        raise Fail("opencode timed out after 600s")

    out = {"text": "", "session": "", "cost": 0.0,
           "tokens": {"input": 0, "output": 0, "reasoning": 0, "total": 0},
           "events": proc.stdout, "error": ""}
    texts = []
    for line in proc.stdout.splitlines():
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            continue
        out["session"] = ev.get("sessionID") or out["session"]
        part = ev.get("part") or {}
        if ev.get("type") == "text":
            texts.append(part.get("text", ""))
        elif ev.get("type") == "step_finish":
            out["cost"] += float(part.get("cost") or 0)
            tk = part.get("tokens") or {}
            for k in ("input", "output", "reasoning", "total"):
                out["tokens"][k] += int(tk.get(k) or 0)
        elif ev.get("type") == "error":
            err = ev.get("error")
            out["error"] = json.dumps(err) if not isinstance(err, str) else err
    out["text"] = "\n".join(texts)
    if proc.returncode != 0 and not out["error"]:
        out["error"] = (proc.stderr or "").strip()[-2000:] or f"opencode exited {proc.returncode}"
    return out


def parse_reply(text: str) -> dict:
    """The contract is one fenced JSON block; anything else becomes the reply."""
    empty = {"reply": "", "proposals": [], "suggestions": [], "knowledge": []}
    m = None
    for m in re.finditer(r"```(?:json)?\s*\n(.*?)\n```", text, re.S):
        pass
    candidates = [m.group(1)] if m else []
    candidates.append(text.strip())
    for c in candidates:
        try:
            obj = json.loads(c)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict):
            out = dict(empty)
            out["reply"] = str(obj.get("reply") or "")
            for k in ("proposals", "suggestions", "knowledge"):
                v = obj.get(k)
                out[k] = [x for x in v if isinstance(x, dict)] if isinstance(v, list) else []
            return out
    out = dict(empty)
    out["reply"] = text.strip()
    return out


# ------------------------------------------------------------------- apply

def group_of(state: dict, hash_: str) -> list[str]:
    """A list submission shares one record across its items."""
    rec = state["blocks"].get(hash_) or {}
    g = rec.get("group")
    return [h for h in g if h in state["blocks"]] if isinstance(g, list) and hash_ in g else [hash_]


def apply(cfg: dict, paths: Paths, trigger: str, fired: list[dict], visible: list[dict],
          result: dict, reply: dict, payload_file: Path, hash_: str = "", message: str = "") -> dict:
    now = dt.datetime.now()
    at = now.isoformat(timespec="seconds")
    state = load_state(paths)
    hashes = [b["hash"] for b in fired] if fired else ([hash_] if hash_ else [])
    if fired:
        hash_ = fired[0]["hash"]
    chat = trigger == "chat"

    # Every block the model saw is now "seen"; the fired ones get the reply.
    for b in visible:
        state["blocks"].setdefault(b["hash"], {"state": "seen", "at": at})
    if chat:
        for h in group_of(state, hash_):
            rec = state["blocks"].setdefault(h, {"state": "seen", "at": at})
            turns = rec.setdefault("chat", [])
            turns.append({"role": "student", "text": message, "at": at})
            turns.append({"role": "agent", "text": reply["reply"], "at": at, "cost": result["cost"]})
            rec["session"] = result["session"] or rec.get("session", "")
            rec["read"] = False
            if rec.get("state") != "reply":
                rec["state"] = "reply"
                rec["reply"] = rec.get("reply") or ""
            rec["proposals"] = rec.get("proposals", []) + reply["proposals"]
    elif fired:
        head = " / ".join(b["text"].split("\n")[0] for b in fired)
        for h in hashes:
            rec = state["blocks"].setdefault(h, {})
            rec.update({"state": "reply" if reply["reply"] else "seen", "trigger": trigger,
                        "reply": reply["reply"], "proposals": reply["proposals"], "read": False,
                        "session": result["session"], "at": at, "cost": result["cost"], "head": head})
            if len(hashes) > 1:
                rec["group"] = hashes
            else:
                rec.pop("group", None)
    elif reply["reply"]:
        state.setdefault("observations", []).append({"text": reply["reply"], "at": at, "trigger": trigger,
                                                     "session": result["session"], "read": False})
    known = read_dismissed(paths) + [x.get("text", "") for x in state["suggestions"]]
    for s in reply["suggestions"]:
        text = str(s.get("text") or "").strip()
        if not text or is_known(text, known):
            continue
        known.append(text)
        state["suggestions"].append({"text": text, "evidence": str(s.get("evidence") or ""),
                                     "block": hash_, "at": at, "dismissed": False})
    written = []
    for k in reply["knowledge"]:
        name = str(k.get("file") or "")
        if not KNOWLEDGE_FILE.match(name) or name == "dismissed.md":
            continue
        write_atomic(paths, paths.knowledge / name, str(k.get("content") or "").rstrip() + "\n")
        written.append(name)
    state["runs"].append({"at": at, "trigger": trigger, "block": hash_, "session": result["session"],
                          "cost": result["cost"], "tokens": result["tokens"], "payload": str(payload_file),
                          "knowledge": written, "error": result["error"]})
    write_atomic(paths, paths.state, json.dumps(state, indent=2, ensure_ascii=False) + "\n")

    # Transcript: for the student, one section per run.
    if not paths.transcript.exists():
        append_text(paths, paths.transcript,
                    f"# {paths.stamp} — agent\n\nNote: [[{paths.daily_dir.relative_to(paths.vault)}/{paths.stamp}]]\n")
    sec = [f"\n## {now.strftime('%H:%M')} · {trigger}" + (f" · `{','.join(hashes)}`" if hashes else ""), ""]
    if fired and not chat:
        sec += ["> " + l for b in fired for l in b["text"].split("\n")] + [""]
    if chat:
        sec += [f"**you:** {message}", "", f"**agent:** {reply['reply'] or '_(nothing to add)_'}"]
    else:
        sec.append(reply["reply"] if reply["reply"] else "_(nothing to add)_")
    for p in reply["proposals"]:
        if p.get("kind") == "deadline":
            sec.append(f"- [ ] add deadline: {p.get('title', '')} — {p.get('when', '')}"
                       + (f" · {project_of(p)}" if project_of(p) else ""))
    for s in reply["suggestions"]:
        sec.append(f"- suggestion: {s.get('text', '')} _(evidence: {s.get('evidence', '')})_")
    if result["error"]:
        sec.append(f"- error: {result['error']}")
    tk = result["tokens"]
    sec.append(f"\n<small>${result['cost']:.4f} · {tk['total']} tokens · {cfg.get('model') or 'agent default'}{' · ' + cfg['variant'] if cfg.get('variant') else ''}</small>\n")
    append_text(paths, paths.transcript, "\n".join(sec))

    # Ledger: one line per run, never synced.
    paths.ledger.parent.mkdir(parents=True, exist_ok=True)
    if not paths.ledger.exists():
        paths.ledger.write_text("at\tdate\ttrigger\tblock\tcost\tinput\toutput\treasoning\tsession\n")
    with open(paths.ledger, "a") as f:
        f.write(f"{at}\t{paths.stamp}\t{trigger}\t{hash_}\t{result['cost']:.6f}\t{tk['input']}\t{tk['output']}\t{tk['reasoning']}\t{result['session']}\n")
    return state


