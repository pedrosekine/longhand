def prepare(cfg: dict, args) -> tuple[Paths, list[dict], list[dict]]:
    date = dt.datetime.strptime(args.date, moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD"))).date() \
        if args.date else dt.date.today()
    paths = Paths(cfg, date)
    try:
        text = paths.note.read_text()
    except FileNotFoundError:
        raise Fail(f"no note for {paths.stamp}")
    blks = blocklib.split(text)
    if note_is_private(blks):
        raise Fail("today is marked agent: false")
    visible = visible_blocks(blks)
    fired = []
    if args.hash:
        for h in [x for x in args.hash.split(",") if x]:
            b = next((b for b in visible if b["hash"] == h), None)
            if b is None:
                raise Fail(f"block {h} is not in the visible note (edited, private, or gone)")
            fired.append(b)
    elif args.trigger != "open":
        raise Fail("--hash is required for every trigger except open")
    return paths, visible, fired


def cmd_context(cfg: dict, args) -> int:
    paths, visible, fired = prepare(cfg, args)
    sys.stdout.write(build_payload(paths, args.trigger, fired, visible, cfg))
    return 0


def cmd_run(cfg: dict, args) -> int:
    paths, visible, fired = prepare(cfg, args)
    if args.trigger == "open":
        known = load_state(paths)["blocks"]
        if all(b["hash"] in known for b in visible):
            print("open: nothing new since the last pass")
            return 0
    payload = build_payload(paths, args.trigger, fired, visible, cfg)
    paths.payloads.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    payload_file = paths.payloads / f"{stamp}-{args.trigger}-{fired[0]['hash'] if fired else 'open'}.md"
    payload_file.write_text(payload)
    result = run_model(cfg, paths, payload)
    payload_file.with_suffix(".events.jsonl").write_text(result["events"])
    reply = parse_reply(result["text"]) if not result["error"] else \
        {"reply": "", "proposals": [], "suggestions": [], "knowledge": []}
    apply(cfg, paths, args.trigger, fired, visible, result, reply, payload_file)
    if result["error"]:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    print(f"{args.trigger} {','.join(b['hash'] for b in fired)}: "
          f"{'reply' if reply['reply'] else 'silent'} · ${result['cost']:.4f} · {result['tokens']['total']} tokens")
    return 0


def cmd_chat(cfg: dict, args) -> int:
    """Dive in: the student talks to the agent about one block."""
    message = (args.message or "").strip()
    if not message:
        raise Fail("--message is empty")
    date = dt.datetime.strptime(args.date, moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD"))).date() \
        if args.date else dt.date.today()
    paths = Paths(cfg, date)
    state = load_state(paths)
    rec = state["blocks"].get(args.hash) or {}
    session = rec.get("session", "")
    try:
        text = paths.note.read_text()
    except FileNotFoundError:
        raise Fail(f"no note for {paths.stamp}")
    blks = blocklib.split(text)
    if note_is_private(blks):
        raise Fail("today is marked agent: false")
    visible = visible_blocks(blks)
    block = next((b for b in visible if b["hash"] == args.hash), None)
    paths.payloads.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    payload_file = paths.payloads / f"{stamp}-chat-{args.hash}.md"
    if session:
        # The session already holds the context and the first reply; only the
        # student's words travel. Logged all the same.
        payload = (f"{language_line(cfg, message)}\n\nThe student replies about block {args.hash}:\n\n{message}\n\n"
                   "Answer with the same JSON contract.\n")
        payload_file.write_text(payload)
        result = run_model(cfg, paths, "", session=session, message=payload)
    else:
        if block is None:
            raise Fail(f"block {args.hash} has no session and is not in the visible note")
        payload = build_payload(paths, "mention", [block], visible, cfg)
        payload += f"\n# The student says\n\n{message}\n"
        payload_file.write_text(payload)
        result = run_model(cfg, paths, payload)
    payload_file.with_suffix(".events.jsonl").write_text(result["events"])
    reply = parse_reply(result["text"]) if not result["error"] else \
        {"reply": "", "proposals": [], "suggestions": [], "knowledge": []}
    apply(cfg, paths, "chat", [], visible, result, reply, payload_file, hash_=args.hash, message=message)
    if result["error"]:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    print(f"chat {args.hash}: {'reply' if reply['reply'] else 'silent'} · ${result['cost']:.4f} · {result['tokens']['total']} tokens")
    return 0


def run_pomo(argv: list[str]) -> tuple[int, str]:
    try:
        r = subprocess.run(["pomo", *argv], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)
    return r.returncode, (r.stdout + r.stderr).strip()


def twin_deadline(title: str, when: list[str]) -> dict | None:
    """An open deadline in the store with the same words (or mostly) due
    the same day: the one a proposal would duplicate."""
    try:
        code, out = run_pomo(["deadline", "when", *when])
        day = dt.datetime.fromtimestamp(int(out.split("\t")[0])).date() if code == 0 else None
        code, out = run_pomo(["deadline", "list", "--json"])
        items = json.loads(out)["deadlines"] if code == 0 and day else []
    except (ValueError, KeyError, TypeError):
        return None
    for d in items:
        if d.get("status") == "open" and dt.datetime.fromtimestamp(d["due"]).date() == day \
                and (norm(d["title"]) == norm(title) or similar(d["title"], title)):
            return d
    return None


def cmd_accept(cfg: dict, args) -> int:
    """The student ticked a proposal: local code runs it, the model never does."""
    date = dt.datetime.strptime(args.date, moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD"))).date() \
        if args.date else dt.date.today()
    paths = Paths(cfg, date)
    state = load_state(paths)
    rec = state["blocks"].get(args.hash)
    if not rec:
        raise Fail(f"no record for block {args.hash}")
    props = rec.get("proposals") or []
    if not 0 <= args.index < len(props):
        raise Fail(f"block {args.hash} has no proposal #{args.index}")
    prop = props[args.index]
    if prop.get("accepted"):
        return 0
    at = dt.datetime.now().isoformat(timespec="seconds")
    if prop.get("kind") == "deadline":
        when = str(prop.get("when") or "").split() or ["today"]
        twin = twin_deadline(str(prop.get("title") or ""), when)
        if twin:
            # Already there (the page bound the line itself a moment ago):
            # this is the same deadline, not a second one.
            code, out = 0, f"pomo: deadline #{twin['id']} · already there · {twin['title']}"
            if project_of(prop) and not twin.get("project"):
                run_pomo(["deadline", "set", str(twin["id"]), "--project", project_of(prop)])
        else:
            argv = ["deadline", "add", str(prop.get("title") or "untitled")]
            if project_of(prop):
                argv += ["--project", project_of(prop)]
            if prop.get("link"):
                argv += ["--link", str(prop["link"])]
            code, out = run_pomo(argv + when)
        if code != 0:
            prop["error"] = out
            write_atomic(paths, paths.state, json.dumps(state, indent=2, ensure_ascii=False) + "\n")
            raise Fail(out or "pomo failed")
        m = re.search(r"#(\d+)", out)
        accepted = {"at": at, "id": int(m.group(1)) if m else 0, "result": out}
        # A list submission keeps a copy of the proposals on every item:
        # accepted on one is accepted on all, or the next item offers it again.
        for h in group_of(state, args.hash):
            other = (state["blocks"][h].get("proposals") or [])
            if args.index < len(other) and all(other[args.index].get(k) == prop.get(k) for k in ("kind", "title", "when")):
                other[args.index]["accepted"] = accepted
                other[args.index].pop("error", None)
        prop["accepted"] = accepted
        prop.pop("error", None)
        write_atomic(paths, paths.state, json.dumps(state, indent=2, ensure_ascii=False) + "\n")
        append_text(paths, paths.transcript,
                    f"\n- [x] accepted {dt.datetime.now().strftime('%H:%M')}: {out}\n")
        print(out)
        return 0
    raise Fail(f"unknown proposal kind {prop.get('kind')!r}")


CHECKBOX = re.compile(r"^(\s*[-*+] )\[ \] (.*\S)")


def cmd_tasks(cfg: dict, args) -> int:
    """Every unticked checkbox across the daily notes, newest day first.
    Read-only; ticking is the page's job because the page is the one writer."""
    fmt = moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD"))
    daily = Path(cfg["vault"]) / cfg["daily"]["dir"]
    today = dt.date.today()
    out = []
    for f in sorted(daily.glob("*.md"), reverse=True):
        try:
            d = dt.datetime.strptime(f.stem, fmt).date()
        except ValueError:
            continue
        age = (today - d).days
        if age < 0:
            continue
        try:
            lines = f.read_text().split("\n")
        except OSError:
            continue
        for i, line in enumerate(lines):
            m = CHECKBOX.match(line)
            if m:
                out.append({"date": f.stem, "file": str(f), "line": i, "text": m.group(2),
                            "age": age, "recent": age < int(args.days)})
    print(json.dumps(out, ensure_ascii=False))
    return 0


def state_days(cfg: dict, days: int) -> list[tuple[str, Paths, dict]]:
    out = []
    for back in range(days):
        d = dt.date.today() - dt.timedelta(days=back)
        p = Paths(cfg, d)
        if p.state.exists():
            out.append((p.stamp, p, load_state(p)))
    return out


def cmd_next(cfg: dict, args) -> int:
    """What's next: open tasks plus what the agent has raised and the
    student has not yet dealt with, across the last days."""
    tasks = [r for r in outcomes(cfg, days=3650) if not r["done"]]
    for r in tasks:
        r["recent"] = r["age"] < int(args.days)
    raised = []
    days = state_days(cfg, int(args.days))
    dismissed = read_dismissed(days[0][1]) if days else []
    seen: list[str] = []
    for stamp, p, st in days:
        for i, sg in enumerate(st.get("suggestions", [])):
            text = sg.get("text", "")
            if sg.get("dismissed") or is_known(text, dismissed) or is_known(text, seen):
                continue
            seen.append(text)
            raised.append({"date": stamp, "kind": "suggestion", "index": i, "text": text,
                           "evidence": sg.get("evidence", ""), "at": sg.get("at", "")})
        for i, ob in enumerate(st.get("observations", [])):
            if not ob.get("dismissed") and not ob.get("read"):
                raised.append({"date": stamp, "kind": "observation", "index": i, "text": ob.get("text", ""),
                               "evidence": "", "at": ob.get("at", "")})
    print(json.dumps({"tasks": tasks, "raised": raised}, ensure_ascii=False))
    return 0


def cmd_dismiss(cfg: dict, args) -> int:
    """The student waved a suggestion off. Remembered in a file the model
    reads and never writes, so it stays waved off."""
    date = dt.datetime.strptime(args.date, moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD"))).date()
    paths = Paths(cfg, date)
    state = load_state(paths)
    key = "suggestions" if args.kind == "suggestion" else "observations"
    items = state.get(key, [])
    if not 0 <= args.index < len(items):
        raise Fail(f"no {args.kind} #{args.index} on {paths.stamp}")
    item = items[args.index]
    if item.get("dismissed"):
        return 0
    item["dismissed"] = True
    item["read"] = True
    write_atomic(paths, paths.state, json.dumps(state, indent=2, ensure_ascii=False) + "\n")
    if args.kind == "suggestion":
        if not paths.dismissed.exists():
            append_text(paths, paths.dismissed, "# Dismissed suggestions\n\nWritten by the runner when the student "
                        "waves a suggestion off. The agent reads this and does not raise these again.\n\n")
        append_text(paths, paths.dismissed, f"- {item.get('text', '')}  ({paths.stamp})\n")
    return 0


def cmd_curriculum(cfg: dict, args) -> int:
    """Student-provided material: PDFs become markdown once, next to the
    original, so payloads are always text and always logged."""
    paths = Paths(cfg, dt.date.today())
    if paths.curriculum is None:
        raise Fail("no curriculum folder in config")
    paths.curriculum.mkdir(parents=True, exist_ok=True)
    n = 0
    for pdf in sorted(paths.curriculum.rglob("*.pdf")):
        md = pdf.with_suffix(".md")
        if md.exists() and md.stat().st_mtime >= pdf.stat().st_mtime:
            continue
        try:
            r = subprocess.run(["pdftotext", "-layout", str(pdf), "-"], capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired) as e:
            print(f"skip {pdf.name}: {e}", file=sys.stderr)
            continue
        if r.returncode != 0:
            print(f"skip {pdf.name}: {r.stderr.strip()[-200:]}", file=sys.stderr)
            continue
        write_atomic(paths, md, f"# {pdf.stem}\n\n(converted from {pdf.name})\n\n" + r.stdout)
        n += 1
    print(f"{n} converted · folder {paths.curriculum}")
    return 0


def cmd_ack(cfg: dict, args) -> int:
    date = dt.datetime.strptime(args.date, moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD"))).date() \
        if args.date else dt.date.today()
    paths = Paths(cfg, date)
    state = load_state(paths)
    changed = False
    for h in group_of(state, args.hash):
        rec = state["blocks"].get(h)
        if rec and not rec.get("read"):
            rec["read"] = True
            changed = True
    if changed:
        write_atomic(paths, paths.state, json.dumps(state, indent=2, ensure_ascii=False) + "\n")
    return 0


def cmd_state(cfg: dict, args) -> int:
    date = dt.datetime.strptime(args.date, moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD"))).date() \
        if args.date else dt.date.today()
    print(json.dumps(load_state(Paths(cfg, date)), indent=2, ensure_ascii=False))
    return 0


# ------------------------------------------------------------------- stats

TAG_RE = re.compile(r"(?:^|\s)#([\w/-]+)")
BOUND_RE = re.compile(r"^\s*[-*+] \[[ xX]\] .*\s\^d\d+\s*$", re.M)
BOX_RE = re.compile(r"^\s*[-*+] \[([ xX])\] ", re.M)
LANG_CODE = {"English": "en", "German": "de", "Portuguese": "pt", "Spanish": "es", "Dutch": "nl",
             "French": "fr", "Italian": "it"}
LOG_RE = re.compile(r"^(\d{4}-\d{2}-\d{2}) \d{2}:\d{2}:\d{2} (.*)$")


def sure_language(text: str, candidates: list[str]) -> str:
    """A block's language when the stopwords say so clearly, else ""."""
    words = re.findall(r"[\w']+", text.lower())
    counts = {lang: sum(1 for w in words if w in STOPWORDS.get(lang, ())) for lang in candidates}
    best = max(counts, key=counts.get) if counts else ""
    return best if best and counts[best] >= 2 else ""


def cmd_stats(cfg: dict, args) -> int:
    """How the tool is being used, day by day, read from what is already on
    disk: the notes, the deadline store and pomo's log, the agent's cost
    ledger, and the page's usage log. Read-only, local, never in a payload.
    The point is to judge the tool after a stretch of real use — whether
    the habit forms and intentions close — not to score the student."""
    today = dt.date.today()
    start = (dt.datetime.strptime(args.since, "%Y-%m-%d").date() if args.since
             else today - dt.timedelta(days=int(args.days) - 1))
    span = [start + dt.timedelta(days=i) for i in range((today - start).days + 1)]
    day = {d: {"words": 0, "written": 0, "ticked": 0, "bound": 0, "tags": [], "langs": {},
               "opens": 0, "minutes": 0.0, "features": {}, "runs": 0, "cost": 0.0, "triggers": {},
               "focus": 0, "added": 0, "done": 0} for d in span}
    langs = languages(cfg)

    # Notes: what was written, intended (checkboxes) and closed (ticked).
    for d in span:
        note = Path(cfg["vault"]) / cfg["daily"]["dir"] / f"{day_stamp(cfg, d)}.md"
        try:
            text = note.read_text()
        except OSError:
            continue
        body = re.sub(r"^\[\[[^\]\n]*\|agent\]\]\n?", "", text)
        r = day[d]
        r["words"] = len(re.findall(r"\w+", re.sub(r"📅 \S+( \d{1,2}:\d{2})?|\^d\d+", "", body)))
        boxes = BOX_RE.findall(body)
        r["written"] = len(boxes)
        r["ticked"] = sum(1 for b in boxes if b != " ")
        r["bound"] = len(BOUND_RE.findall(body))
        r["tags"] = sorted(set(TAG_RE.findall(body)))
        for b in blocklib.split(body):
            if b["kind"] in ("frontmatter",) or b["private"]:
                continue
            lang = sure_language(b["text"], langs)
            if lang:
                r["langs"][lang] = r["langs"].get(lang, 0) + 1

    # The page: opens, time open, what was reached for.
    usage = STATE_HOME / "usage.tsv"
    if usage.exists():
        for line in usage.read_text().splitlines():
            f = line.split("\t")
            if len(f) < 2 or not f[0].isdigit():
                continue
            d = dt.date.fromtimestamp(int(f[0]))
            if d not in day:
                continue
            ev, detail = f[1], f[2] if len(f) > 2 else ""
            if ev == "open":
                day[d]["opens"] += 1
            elif ev == "close" and detail.isdigit():
                day[d]["minutes"] += int(detail) / 60
            else:
                key = ev if ev not in ("prompt", "day") else (f"{ev}:{detail}" if ev == "prompt"
                                                              else ("day:past" if detail not in ("", "0") else "day:today"))
                day[d]["features"][key] = day[d]["features"].get(key, 0) + 1

    # The agent: runs, triggers, cost.
    ledger = STATE_HOME / "cost.tsv"
    if ledger.exists():
        for line in ledger.read_text().splitlines()[1:]:
            f = line.split("\t")
            try:
                d = dt.date.fromisoformat(f[0][:10])
            except (ValueError, IndexError):
                continue
            if d in day:
                day[d]["runs"] += 1
                day[d]["cost"] += float(f[4] or 0)
                day[d]["triggers"][f[2]] = day[d]["triggers"].get(f[2], 0) + 1

    # pomo: focus sessions, deadlines made and closed.
    seen = set()
    log = STATE_HOME / "pomo.log"
    if log.exists():
        for line in log.read_text().splitlines():
            m = LOG_RE.match(line)
            if not m:
                continue
            d = dt.date.fromisoformat(m.group(1))
            msg = m.group(2)
            first = re.match(r"deadline #(\d+) · ", msg)
            if first and first.group(1) not in seen:
                seen.add(first.group(1))
                if d in day:
                    day[d]["added"] += 1
            if d not in day:
                continue
            if "focus completed" in msg:
                day[d]["focus"] += 1
            if re.match(r"deadline #\d+ done", msg):
                day[d]["done"] += 1

    # Deadlines in the window: met on time or late, made from a note or not.
    store = STATE_HOME / "deadlines.tsv"
    on_time = late = from_note = closed = 0
    if store.exists():
        for line in store.read_text().splitlines():
            f = line.split("\t")
            if len(f) < 5 or not f[1].isdigit():
                continue
            due, status = int(f[1]), f[3]
            done_at = int(f[4]) if f[4].isdigit() else 0
            if status != "open" and done_at and dt.date.fromtimestamp(done_at) >= start:
                closed += 1
                on_time += done_at <= due
                late += done_at > due
                from_note += len(f) > 7 and "#^d" in f[7]

    rows = [{"date": d.isoformat(), **day[d]} for d in span]
    totals = {
        "days": len(span),
        "days_written": sum(1 for r in rows if r["words"] > 0),
        "days_opened": sum(1 for r in rows if r["opens"] > 0),
        "words": sum(r["words"] for r in rows),
        "checkboxes_written": sum(r["written"] for r in rows),
        "checkboxes_ticked": sum(r["ticked"] for r in rows),
        "bound_lines": sum(r["bound"] for r in rows),
        "tags": sorted({t for r in rows for t in r["tags"]}),
        "languages": {l: sum(r["langs"].get(l, 0) for r in rows) for l in langs},
        "page_opens": sum(r["opens"] for r in rows),
        "page_minutes": round(sum(r["minutes"] for r in rows)),
        "features": {},
        "agent_runs": sum(r["runs"] for r in rows),
        "agent_cost": round(sum(r["cost"] for r in rows), 4),
        "focus_sessions": sum(r["focus"] for r in rows),
        "deadlines_added": sum(r["added"] for r in rows),
        "deadlines_closed": closed, "closed_on_time": on_time, "closed_late": late, "closed_from_a_note": from_note,
    }
    for r in rows:
        for k, v in r["features"].items():
            totals["features"][k] = totals["features"].get(k, 0) + v

    if args.json:
        print(json.dumps({"days": rows, "totals": totals}, indent=2, ensure_ascii=False))
        return 0
    print(f"{'day':<11} {'words':>5} {'☐→✓':>7} {'bound':>5} {'opens':>5} {'min':>4} {'agent':>5} {'focus':>5}  tags · languages · page")
    for r in rows:
        feats = " ".join(f"{k}×{v}" for k, v in sorted(r["features"].items()))
        lang = " ".join(f"{LANG_CODE.get(k, k[:2].lower())}{v}" for k, v in r["langs"].items())
        print(f"{r['date']:<11} {r['words']:>5} {str(r['written']) + '→' + str(r['ticked']):>7} {r['bound']:>5} "
              f"{r['opens']:>5} {round(r['minutes']):>4} {r['runs']:>5} {r['focus']:>5}  "
              f"{' '.join('#' + t for t in r['tags'])} · {lang} · {feats}".rstrip(" ·"))
    t = totals
    rate = f"{t['checkboxes_ticked']}/{t['checkboxes_written']}" if t["checkboxes_written"] else "—"
    print(f"\n{t['days_written']}/{t['days']} days written in, {t['days_opened']} with the page opened "
          f"({t['page_opens']} opens, {t['page_minutes']} min). {t['words']} words.")
    print(f"Checkboxes closed: {rate}. Bound lines: {t['bound_lines']}. Deadlines: {t['deadlines_added']} added, "
          f"{t['deadlines_closed']} closed ({t['closed_on_time']} by their time, {t['closed_late']} marked done after it, "
          f"{t['closed_from_a_note']} from a note line).")
    print(f"Agent: {t['agent_runs']} runs, ${t['agent_cost']:.4f}. Focus sessions: {t['focus_sessions']}.")
    print(f"Tags: {' '.join('#' + x for x in t['tags']) or '—'}. Languages (blocks): "
          + (", ".join(f"{k} {v}" for k, v in t["languages"].items() if v) or "—") + ".")
    print("Page: " + (", ".join(f"{k} {v}" for k, v in sorted(t["features"].items())) or "—") + ".")
    return 0


# ------------------------------------------------------------------ projects

SESSION_RE = re.compile(r"^\s*- (?:\w{3}) (\d{1,2}) (\w{3}): (.*)$", re.M)
SLOT_RE = re.compile(r"(\d{1,2}):(\d{2})\s*[–-]\s*(\d{1,2}):(\d{2})")
ROOM_RE = re.compile(r"\(([^)]*)\)\s*$")


def nearest_year(month: int, day: int, now: dt.datetime) -> dt.date | None:
    """A session line carries no year: take the year that puts it closest
    to now (in January, "12 Oct" is last October, not next)."""
    best = None
    for y in (now.year - 1, now.year, now.year + 1):
        try:
            d = dt.date(y, month, day)
        except ValueError:
            continue
        if best is None or abs((d - now.date()).days) < abs((best - now.date()).days):
            best = d
    return best
MONTH_NUM = {m: i + 1 for i, m in enumerate(["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"])}


def project_list(cfg: dict, now: dt.datetime) -> list[dict]:
    """The projects the student keeps notes on, from knowledge/projects/:
    the tag (a `Tag: #x` line, else the file name), the name (its H1), and
    the next session listed there (`- Mon 12 Oct: 10:45–12:15 (Gold)`).
    These are the tags that exist; the page offers them instead of new
    ones being invented."""
    folder = Paths(cfg, now.date()).knowledge / "projects"
    out = []
    for f in sorted(folder.glob("*.md")) if folder.is_dir() else []:
        try:
            text = f.read_text()
        except OSError:
            continue
        name = next((l[2:].strip() for l in text.splitlines() if l.startswith("# ")), f.stem)
        m = re.search(r"Tag:\s*`?#([\w/-]+)", text)
        nxt = None
        for s in SESSION_RE.finditer(text):
            mon = MONTH_NUM.get(s.group(2))
            day = nearest_year(mon, int(s.group(1)), now) if mon else None
            if day is None:
                continue
            room = ROOM_RE.search(s.group(3))
            # The next slot is the first that has not ended yet; one under
            # way is the next too, and says so.
            for a_h, a_m, b_h, b_m in SLOT_RE.findall(s.group(3)):
                start = dt.datetime.combine(day, dt.time(int(a_h), int(a_m)))
                end = dt.datetime.combine(day, dt.time(int(b_h), int(b_m)))
                if end > now and (nxt is None or start < nxt["at"]):
                    nxt = {"at": start, "end": end, "room": room.group(1).strip() if room else ""}
        out.append({"tag": m.group(1) if m else f.stem, "name": name, "file": f.name,
                    "next": {"at": nxt["at"].isoformat(timespec="minutes"), "end": nxt["end"].isoformat(timespec="minutes"),
                             "now": nxt["at"] <= now, "room": nxt["room"]} if nxt else None})
    out.sort(key=lambda p: (p["next"] is None, p["next"]["at"] if p["next"] else "", p["name"].lower()))
    return out


def cmd_projects(cfg: dict, args) -> int:
    now = dt.datetime.fromisoformat(args.now) if args.now else dt.datetime.now()
    print(json.dumps(project_list(cfg, now), ensure_ascii=False))
    return 0


def cmd_install(cfg: dict, args) -> int:
    here = Path(__file__).resolve().parent
    src = here / "opencode" / "student.md"
    dst = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "opencode" / "agent" / "student.md"
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(src.read_text())
    paths = Paths(cfg, dt.date.today())
    for d in (paths.agent_dir / "daily", paths.knowledge, paths.payloads, paths.cwd, paths.curriculum):
        if d is not None:
            d.mkdir(parents=True, exist_ok=True)
    print(f"agent definition → {dst}\nagent folder → {paths.agent_dir}\npayload log → {paths.payloads}")
    return 0


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="student-agent")
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("run", "context"):
        p = sub.add_parser(name)
        p.add_argument("--trigger", required=True, choices=TRIGGERS)
        p.add_argument("--hash", default="")
        p.add_argument("--date", default="")
    p = sub.add_parser("chat")
    p.add_argument("--hash", required=True)
    p.add_argument("--message", required=True)
    p.add_argument("--date", default="")
    p = sub.add_parser("ack")
    p.add_argument("--hash", required=True)
    p.add_argument("--date", default="")
    p = sub.add_parser("accept")
    p.add_argument("--hash", required=True)
    p.add_argument("--index", type=int, required=True)
    p.add_argument("--date", default="")
    p = sub.add_parser("tasks")
    p.add_argument("--days", default="7")
    p = sub.add_parser("next")
    p.add_argument("--days", default="7")
    p = sub.add_parser("dismiss")
    p.add_argument("--date", required=True)
    p.add_argument("--kind", required=True, choices=("suggestion", "observation"))
    p.add_argument("--index", type=int, required=True)
    sub.add_parser("curriculum")
    sub.add_parser("state").add_argument("--date", default="")
    sub.add_parser("install")
    sub.add_parser("projects").add_argument("--now", default="", help="YYYY-MM-DDTHH:MM (tests)")
    p = sub.add_parser("stats")
    p.add_argument("--days", default="14")
    p.add_argument("--since", default="", help="YYYY-MM-DD; overrides --days")
    p.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)
    try:
        cfg = load_config()
        return {"run": cmd_run, "chat": cmd_chat, "ack": cmd_ack, "accept": cmd_accept, "tasks": cmd_tasks,
                "next": cmd_next, "dismiss": cmd_dismiss, "curriculum": cmd_curriculum,
                "context": cmd_context, "state": cmd_state, "install": cmd_install, "stats": cmd_stats,
                "projects": cmd_projects}[args.cmd](cfg, args)
    except Fail as e:
        print(f"student-agent: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
