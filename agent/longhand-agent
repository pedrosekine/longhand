def cmd_notebook(cfg: dict, args) -> int:
    """What the agent knows, for Settings, and the student's word on it:
    forget a line, correct it, or take a correction back (notebook.py)."""
    paths = Paths(cfg, dt.date.today())
    write = lambda f, text: write_atomic(paths, f, text)  # noqa: E731
    try:
        if args.how == "forget":
            out = nb.forget(paths.knowledge, args.file, args.text, write)
        elif args.how == "correct":
            out = nb.correct(paths.knowledge, args.file, args.text, args.to, write)
        elif args.how == "take-back":
            out = nb.take_back(paths.knowledge, args.n, write)
        else:
            out = nb.read(paths.knowledge)
    except ValueError as e:
        raise Fail(str(e))
    print(json.dumps(out, ensure_ascii=False))
    return 0


