def cmd_horizon(cfg: dict, args) -> int:
    """For the page: the agent's horizon, whether the person set it, what it
    falls back to, and how many daily notes fall on each side of it."""
    chosen, fallback = agent_horizon(cfg)
    daily = Path(cfg["vault"]) / cfg["daily"]["dir"]
