class Fail(Exception):
    pass


# ----------------------------------------------------------------- config

# What the page's Settings sheet may set (settings.json, beside the config,
# written by the page only). Read over config.json, and nothing else: a
# file the page writes never moves the vault or the daily folder.
SETTABLE = ("timetable", "calendars", "autonomy", "searchFolders", "horizon")


def load_config() -> dict:
    try:
        cfg = json.loads(CONFIG_PATH.read_text())
    except FileNotFoundError:
        raise Fail(f"no config at {CONFIG_PATH}")
    except json.JSONDecodeError as e:
        raise Fail(f"config is not valid JSON: {e}")
    if not cfg.get("vault") or not cfg.get("daily", {}).get("dir"):
        raise Fail("config needs vault and daily.dir")
    try:
        settings = json.loads(CONFIG_PATH.with_name("settings.json").read_text())
    except (OSError, ValueError):
        settings = {}
    if isinstance(settings, dict):
        cfg.update({k: settings[k] for k in SETTABLE if k in settings})
    return cfg


def moment_to_strftime(fmt: str) -> str:
    return (fmt.replace("YYYY", "%Y").replace("YY", "%y").replace("MM", "%m")
            .replace("DD", "%d").replace("HH", "%H").replace("mm", "%M"))


def day_stamp(cfg: dict, date: dt.date) -> str:
    return date.strftime(moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD")))


class Paths:
    def __init__(self, cfg: dict, date: dt.date):
        self.vault = Path(cfg["vault"])
        self.stamp = day_stamp(cfg, date)
        self.daily_dir = self.vault / cfg["daily"]["dir"]
        self.note = self.daily_dir / f"{self.stamp}.md"
        self.agent_dir = self.vault / cfg.get("agentDir", "agents/longhand")
        self.notes_root = notes_root(cfg)
        self.transcript = self.agent_dir / "daily" / f"{self.stamp}.md"
        self.state = self.agent_dir / "daily" / f"{self.stamp}.json"
        self.knowledge = self.agent_dir / "knowledge"
        # System-owned memory of the student's decisions: the one file under
        # knowledge/ the model never writes. It reads it, so a dismissed
        # suggestion stays dismissed.
        self.dismissed = self.agent_dir / "knowledge" / "dismissed.md"
        self.curriculum = (self.vault / cfg["curriculum"]) if cfg.get("curriculum") else None
        self.payloads = STATE_HOME / "payloads"
        self.ledger = STATE_HOME / "cost.tsv"
        self.cwd = STATE_HOME / "agent-cwd"


# ------------------------------------------------------------------ writes

def notes_root(cfg: dict) -> str:
    """The person's notes, vault-relative (docs/files.md, 2026-10-26):
    `notes` in the config, else the folder the daily notes sit in when they
    are nested (`human/Daily` → `human`), else the vault itself ("")."""
    if cfg.get("notes") is not None:
        return str(cfg["notes"]).strip("/")
    parts = Path(str(cfg["daily"]["dir"]).strip("/")).parts
    return parts[0] if len(parts) > 1 else ""


def guard_write(paths: Paths, target: Path) -> None:
    """The one rule that lets the agent say 'I never touched your prose':
    nothing under the daily folder, and nothing under the notes root unless
    it is the agent's own folder. (A vault whose notes are the vault itself
    keeps the daily folder's rule only: the agent's other places — the
    projects' documents — sit beside the notes there.)"""
    t = target.resolve()
    d = paths.daily_dir.resolve()
    if t == d or d in t.parents:
        raise Fail(f"refusing to write under the daily folder: {target}")
    if paths.notes_root:
        n, a = (paths.vault / paths.notes_root).resolve(), paths.agent_dir.resolve()
        if (t == n or n in t.parents) and not (t == a or a in t.parents):
            raise Fail(f"refusing to write under the notes: {target}")


def write_atomic(paths: Paths, target: Path, text: str) -> None:
    guard_write(paths, target)
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, target)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_knowledge(paths: Paths, files: list, written: list) -> None:
    """The knowledge files the model rewrote, with the student's corrections
    applied again (notebook.py), so a correction made once stays made. Only
    its own files: answers, dismissals and corrections are never the model's.
    A project's file it may add to but not make — a new project is the
    person's, proposed to them (projects.py) — and its name and tag stay."""
    record = nb.corrections(paths.knowledge)
    for k in files:
        name = str((k or {}).get("file") or "")
        if not KNOWLEDGE_FILE.match(name) or name in nb.NOT_THE_MODELS:
            continue
        # The whole record, whichever file a correction was made in: a fact
        # forgotten in one file does not come back by moving to another.
        content = nb.enforce(str(k.get("content") or "").rstrip(), record)
        target = paths.knowledge / name
        if name.startswith("projects/"):
            try:
                old = target.read_text()
            except FileNotFoundError:
                continue
            content = projlib.keep_identity(old, content, target.stem).rstrip()
        write_atomic(paths, target, content + "\n")
        written.append(name)


def knowledge_parts(paths: Paths) -> list[str]:
    """The notebook as every payload carries it: the agent's own files, the
    student's answers to its questions, and the student's corrections."""
    parts = ["", "# Your knowledge files", ""]
    own = [(n, t) for n, t in read_tree(paths.knowledge)
           if Path(n).name not in nb.NOT_THE_MODELS and not n.startswith(BRIEFS_DIR + "/")]
    if own:
        for name, text in own:
            parts += [f"## {name}", "", text.rstrip(), ""]
    else:
        parts.append("(none yet)")
    answers = paths.knowledge / nb.ANSWERS
    if answers.exists() and answers.read_text().strip():
        parts += ["", "# The student's answers to your questions (true; never ask them again)", "",
                  answers.read_text().rstrip()]
    return parts + brief_parts(paths) + nb.payload_section(paths.knowledge)


# The day's brief (docs/agent.md, "The day conversation", slice 4): the
# morning after, a small run writes what a day's conversation came to into
# the notebook, `days/<date>.md`; every payload carries the last few.
BRIEFS_DIR = "days"
BRIEFS_SHOWN = 3      # the last few briefs a payload carries
BRIEF_DAYS = 7        # how far back a missing brief is still written
BRIEF_CHARS = 1500


def brief_parts(paths: Paths) -> list[str]:
    folder = paths.knowledge / BRIEFS_DIR
    today = dt.date.today().isoformat()
    files = sorted(f for f in folder.glob("????-??-??.md") if f.stem < today) if folder.is_dir() else []
    if not files:
        return []
    parts = ["", "# The last days, in brief (what each day's conversation came to, written the morning after; "
             "the student may have corrected them)", ""]
    for f in files[-BRIEFS_SHOWN:]:
        parts += [f"## {BRIEFS_DIR}/{f.name}", "", f.read_text(errors="replace").rstrip(), ""]
    return parts


def append_text(paths: Paths, target: Path, text: str) -> None:
    guard_write(paths, target)
    target.parent.mkdir(parents=True, exist_ok=True)
    with open(target, "a") as f:
        f.write(text)


# ----------------------------------------------------------------- context

def note_is_private(blks: list[dict]) -> bool:
    for b in blks:
        if b["kind"] == "frontmatter":
            return re.search(r"^agent:\s*false\s*$", b["text"], re.M) is not None
    return False


# The agent's horizon (docs/files.md, 2026-10-26): a daily note from before
# it is private, whatever its frontmatter says. Years of journaling were in
# the agent's search until then. The date is the person's, in settings.json
# (`horizon`, Settings → what the agent may search); unset, it is the first
# day the agent kept a state file — the day Longhand began on this vault —
# or today on a vault it has never run in.
_HORIZON: dict = {}
OLDER_STAMPS = ("%Y-%m-%d", "%Y.%m.%d", "%Y_%m_%d", "%Y%m%d")


def agent_horizon(cfg: dict) -> tuple[dt.date, dt.date]:
    """(the horizon in force, the one it falls back to when unset)."""
    key = (str(cfg.get("vault")), str(cfg.get("agentDir")), str(cfg.get("horizon")))
    if key not in _HORIZON:
        fmt = moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD"))
        folder = Path(cfg["vault"]) / cfg.get("agentDir", "agents/longhand") / "daily"
        kept = []
        for f in folder.glob("*.json") if folder.is_dir() else []:
            try:
                kept.append(dt.datetime.strptime(f.stem, fmt).date())
            except ValueError:
                continue
        fallback = min(kept) if kept else dt.date.today()
        try:
            chosen = dt.date.fromisoformat(str(cfg.get("horizon") or "").strip())
        except ValueError:
            chosen = fallback
        _HORIZON[key] = (chosen, fallback)
    return _HORIZON[key]


def stamp_date(cfg: dict, stamp: str) -> dt.date | None:
    """A daily note's date from its name: the configured format, else the
    common older ones (the page's Days.js reads those too)."""
    fmt = moment_to_strftime(cfg["daily"].get("format", "YYYY-MM-DD"))
    for f in (fmt,) + OLDER_STAMPS:
        try:
            return dt.datetime.strptime(stamp, f).date()
        except ValueError:
            continue
    return None


def before_horizon(cfg: dict, day: dt.date | str | None) -> bool:
    if isinstance(day, str):
        day = stamp_date(cfg, day)
    return day is not None and day < agent_horizon(cfg)[0]


def horizon_hide(cfg: dict):
    """For search.py: true for a daily note (by its path in the vault) from
    before the horizon."""
    daily = str(cfg["daily"]["dir"]).strip("/")

    def hide(rel: str) -> bool:
        p = Path(rel)
        return str(p.parent) == daily and p.suffix.lower() == ".md" and before_horizon(cfg, p.stem)
    return hide


def visible_blocks(blks: list[dict]) -> list[dict]:
    return [b for b in blks if not b["private"] and not LINK_LINE.match(b["text"])]


def read_tree(root: Path | None, suffix: str = ".md") -> list[tuple[str, str]]:
    if root is None or not root.is_dir():
        return []
    out = []
    for p in sorted(root.rglob(f"*{suffix}")):
        if p.is_file():
            out.append((str(p.relative_to(root)), p.read_text(errors="replace")))
    return out


def pomo_report() -> str:
    try:
        r = subprocess.run(["pomo", "report", "--json"], capture_output=True, text=True, timeout=10)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
