def cmd_day(cfg: dict, args) -> int:
    """The day conversation (docs/agent.md, "The day conversation",
    2026-10-21): the student talks to the day, not to a line. One model
    session a day, kept in the day's state (`day`); the first message
    carries the day's context, the later ones only what is new. A private
    day still talks — it sees nothing of the note. Only today's is talked
    in; a past day's is read in the page."""
    message = (args.message or "").strip()
    if not message:
        raise Fail("--message is empty")
    ensure_briefs(cfg)
    today = dt.date.today()
    paths = Paths(cfg, today)
    try:
        blks = blocklib.split(paths.note.read_text())
    except FileNotFoundError:
        blks = []
    private = note_is_private(blks)
    visible = [] if private else visible_blocks(blks)
    state = load_state(paths)
    day = day_of(state)
    at = dt.datetime.now().isoformat(timespec="seconds")
    paths.payloads.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    payload_file = paths.payloads / f"{stamp}-day.md"
    day_cfg = dict(cfg, agent=cfg.get("dayAgent", "longhand-day"))
    proposable, digest = day_proposable(cfg, today)
    if day.get("session"):
        last = next((t["at"] for t in reversed(day["turns"]) if t["role"] == "agent"), "")
        payload = day_followup(cfg, paths, visible, last, message, args.block,
                               proposable if digest != day.get("proposable") else None)
        payload_file.write_text(payload)                 # logged before inference
        result = run_model(day_cfg, paths, "", session=day["session"], message=payload)
    else:
        payload = day_payload(cfg, paths, visible, private, message, args.block, proposable)
        payload_file.write_text(payload)
        result = run_model(day_cfg, paths, payload, message="Context follows on stdin.")
    payload_file.with_suffix(".events.jsonl").write_text(result["events"])
    reply = parse_reply(result["text"]) if not result["error"] else \
        {"reply": "", "proposals": [], "suggestions": [], "knowledge": [], "read": []}
    fetched = {"searched": [], "files": [], "documents": [], "withheld": {}}
    if not result["error"]:
        tag = project_of_block(visible, next((b for b in visible if b["hash"] == args.block), None)) \
            if args.block and any(b["hash"] == args.block for b in visible) else ""
        result, reply, fetched = day_follow(cfg, paths, tag, result, reply, payload_file)

    proposed = day_proposals(cfg, reply, result, payload_file, at) if not result["error"] else []

    state = load_state(paths)                            # the page or a margin run may have written meanwhile
    day = day_of(state)
    day["session"] = result["session"] or day.get("session", "")
    if not result["error"]:
        day["proposable"] = digest
    turn = {"role": "student", "text": message, "at": at}
    if args.block:
        turn["block"] = args.block
    day["turns"].append(turn)
    if result["error"]:
        day["turns"].append({"role": "agent", "text": "", "error": result["error"], "at": at})
    else:
        day["turns"].append({"role": "agent", "text": reply["reply"], "at": dt.datetime.now().isoformat(timespec="seconds"),
                             "cost": result["cost"], "prompt": result.get("prompt", ""), "model": result.get("model", ""),
                             "payload": str(payload_file), "documents": fetched["documents"],
                             "searched": fetched["searched"], "files": fetched["files"], "withheld": fetched["withheld"],
                             "proposals": proposed, "read": False})
    written = []
    write_knowledge(paths, reply.get("knowledge") or [], written)
    state.setdefault("runs", []).append({"at": at, "trigger": "day", "block": args.block or "", "session": result["session"],
                                         "cost": result["cost"], "tokens": result["tokens"], "payload": str(payload_file),
                                         "prompt": result.get("prompt", ""), "model": result.get("model", ""),
                                         "knowledge": written, "error": result["error"]})
    write_atomic(paths, paths.state, json.dumps(state, indent=2, ensure_ascii=False) + "\n")
    tk = result["tokens"]
    paths.ledger.parent.mkdir(parents=True, exist_ok=True)
    if not paths.ledger.exists():
        paths.ledger.write_text("at\tdate\ttrigger\tblock\tcost\tinput\toutput\treasoning\tsession\tprompt\tmodel\n")
    with open(paths.ledger, "a") as f:
        f.write(f"{at}\t{paths.stamp}\tday\t{args.block or ''}\t{result['cost']:.6f}\t{tk.get('input', 0)}\t{tk.get('output', 0)}"
                f"\t{tk.get('reasoning', 0)}\t{result['session']}\t{result.get('prompt', '')}\t{result.get('model', '')}\n")
    if result["error"]:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    print(f"day: {'reply' if reply['reply'] else 'silent'}" + (f" · {len(proposed)} proposed" if proposed else "")
          + f" · ${result['cost']:.4f} · {tk.get('total', 0)} tokens")
    return 0


# A note's own conversation (docs/files.md, "Talking about a note",
# 2026-10-27): the student opens a file of their notes (or a day the agent
# does not otherwise see) and asks about it. One conversation per note, kept
# in the agent's folder by the note's path; the note is never written.
# Asking is the consent: a note marked private, or a day before the
# horizon, is shown for this conversation only. Never what is never shared
# (search.py's rules), never a `[!private]` block, and what gitleaks flags
# is withheld. The day agent answers, told in the payload what this is.
NOTES_DIR = "notes"


def note_key(rel: str) -> str:
    """The conversation's file name: the md5 of the note's path (the page
    computes the same with Qt.md5)."""
    return hashlib.md5(rel.encode("utf-8")).hexdigest()[:16]


def note_talk(paths: Paths, rel: str) -> tuple[str, list[dict], str]:
    """(the path as the vault has it, the note's blocks as they may be
    shown, a hash of what was shown)."""
    rel = rel.strip().lstrip("/")
    root = paths.vault.resolve()
    p = (root / rel).resolve()
    if root not in p.parents or not p.is_file() or p.suffix.lower() != ".md":
        raise Fail(f"not a note in the vault: {rel}")
    rel = str(p.relative_to(root))
    if searchlib._never(rel):
        raise Fail(f"never shared: {rel}")
    shown = [b for b in visible_blocks(blocklib.split(p.read_text(errors="replace"))) if b["kind"] != "frontmatter"]
    bad = searchlib.leaks([b["text"] for b in shown])
    shown = [dict(b, text="[withheld: looked like a secret]" if i in bad else searchlib.mask(b["text"]))
             for i, b in enumerate(shown)]
    seen = hashlib.sha1("\n\n".join(b["text"] for b in shown).encode()).hexdigest()[:16]
    return rel, shown, seen


def note_payload(cfg: dict, paths: Paths, rel: str, shown: list[dict], message: str, block: str, first: bool,
                 changed: bool = False) -> str:
    """The first message: what this conversation is, the note whole, the
    notebook, what may be searched. A later one: the note again only when
    it `changed`. Either way the block pointed at, and the message."""
    parts = [language_line(cfg, message), ""]
    if first:
        on = [f for f, y in searchlib.switched(paths.vault, cfg).items() if y]
        parts += ["# This conversation", "",
                  "The student opened a note of theirs and asks you about it. It is not today's note and this is not "
                  "the day's conversation: answer about this note, with it as your evidence, and say where in it. "
                  "Propose nothing: `proposals` stays empty. You may search and read as the day does.", "",
                  f"# The note: `{rel}`", "", "(its private callouts are left out)", ""]
        parts += ["\n\n".join(b["text"] for b in shown) or "(empty)"]
        parts += knowledge_parts(paths)
        parts += ["", "# What you may search", "",
                  "The folders the student switched on: " + (", ".join(f"`{f}`" for f in on) or "none") + ". "
                  "Private notes and blocks, and documents of identity, money, health, contracts or secrets, are never "
                  "shown to you, whatever you ask."]
    elif changed:
        parts += [f"# The note as it reads now: `{rel}`", "", "\n\n".join(b["text"] for b in shown) or "(empty)"]
    b = next((x for x in shown if x["hash"] == block), None) if block else None
    if b:
        parts += ["", "# The part the student points at", "", "\n".join("> " + l for l in b["text"].split("\n"))]
    parts += ["", "# The student says", "", message]
    if not first:
        parts += ["", "Answer with the same JSON contract."]
    return "\n".join(parts) + "\n"


def cmd_note(cfg: dict, args) -> int:
    """Talk about one note: `--file` its path in the vault, `--block` a
    block of it pointed at. The first message carries the note whole; a
    later one carries it again only when it changed."""
    message = (args.message or "").strip()
    if not message:
        raise Fail("--message is empty")
    today = dt.date.today()
    paths = Paths(cfg, today)
    rel, shown, seen = note_talk(paths, args.file)
    where = paths.agent_dir / NOTES_DIR / f"{note_key(rel)}.json"
    try:
        talk = json.loads(where.read_text())
    except (OSError, ValueError):
        talk = {}
    talk = {"path": rel, "session": talk.get("session", ""), "turns": talk.get("turns") or [], "seen": talk.get("seen", "")}
    at = dt.datetime.now().isoformat(timespec="seconds")
    paths.payloads.mkdir(parents=True, exist_ok=True)
    payload_file = paths.payloads / f"{dt.datetime.now():%Y%m%d-%H%M%S-%f}-note.md"
    day_cfg = dict(cfg, agent=cfg.get("dayAgent", "longhand-day"))
    if talk["session"]:
        payload = note_payload(cfg, paths, rel, shown, message, args.block, False, changed=seen != talk["seen"])
        payload_file.write_text(payload)                 # logged before inference
        result = run_model(day_cfg, paths, "", session=talk["session"], message=payload)
    else:
        payload = note_payload(cfg, paths, rel, shown, message, args.block, True)
        payload_file.write_text(payload)
        result = run_model(day_cfg, paths, payload, message="Context follows on stdin.")
    payload_file.with_suffix(".events.jsonl").write_text(result["events"])
    reply = parse_reply(result["text"]) if not result["error"] else \
        {"reply": "", "proposals": [], "suggestions": [], "knowledge": [], "read": []}
    fetched = {"searched": [], "files": [], "documents": [], "withheld": {}}
    if not result["error"]:
        result, reply, fetched = day_follow(cfg, paths, "", result, reply, payload_file)

    try:
        talk["turns"] = (json.loads(where.read_text()).get("turns") or talk["turns"])
    except (OSError, ValueError):
        pass
    talk["session"] = result["session"] or talk["session"]
    if not result["error"]:
        talk["seen"] = seen
    turn = {"role": "student", "text": message, "at": at}
    if args.block:
        turn["block"] = args.block
    talk["turns"].append(turn)
    if result["error"]:
        talk["turns"].append({"role": "agent", "text": "", "error": result["error"], "at": at})
    else:
        talk["turns"].append({"role": "agent", "text": reply["reply"], "at": dt.datetime.now().isoformat(timespec="seconds"),
                              "cost": result["cost"], "prompt": result.get("prompt", ""), "model": result.get("model", ""),
                              "payload": str(payload_file), "documents": fetched["documents"],
                              "searched": fetched["searched"], "files": fetched["files"], "withheld": fetched["withheld"]})
    written = []
    write_knowledge(paths, reply.get("knowledge") or [], written)
    write_atomic(paths, where, json.dumps(talk, indent=2, ensure_ascii=False) + "\n")
    tk = result["tokens"]
    paths.ledger.parent.mkdir(parents=True, exist_ok=True)
    if not paths.ledger.exists():
        paths.ledger.write_text("at\tdate\ttrigger\tblock\tcost\tinput\toutput\treasoning\tsession\tprompt\tmodel\n")
    with open(paths.ledger, "a") as f:
        f.write(f"{at}\t{paths.stamp}\tnote\t{args.block or ''}\t{result['cost']:.6f}\t{tk.get('input', 0)}\t{tk.get('output', 0)}"
                f"\t{tk.get('reasoning', 0)}\t{result['session']}\t{result.get('prompt', '')}\t{result.get('model', '')}\n")
    if result["error"]:
        print(f"error: {result['error']}", file=sys.stderr)
        return 1
    print(f"note: {'reply' if reply['reply'] else 'silent'} · ${result['cost']:.4f} · {tk.get('total', 0)} tokens")
    return 0


def brief_payload(cfg: dict, date: dt.date, turns: list[dict]) -> str:
    """What a day's brief is written from: that day's conversation and
    what came of what it proposed — not the note, which stays the note."""
    ledger = planlib.load_ledger(PROPOSALS)
    status = {x["id"]: x["status"] for x in ledger["items"]}
    parts = ["# Brief", f"date: {date.isoformat()} ({date:%A})", "",
             "Write this day's brief, as \"Writing a day's brief\" in your instructions says: in `reply`, three to "
             "six short lines, each its own line starting `- ` (never a paragraph: the student corrects or forgets "
             "it line by line); `reply` empty if nothing is worth carrying.", "",
             "# The day's conversation", ""]
    for t in turns:
        if t.get("error") or not t.get("text"):
            continue
        parts.append(f"{'Longhand' if t['role'] == 'agent' else 'student'}: {t['text']}")
        for c in t.get("proposals") or []:
            what = c.get("date") or c.get("priority") or " · ".join(c.get("steps") or []) or ""
            parts.append(f"  (proposed {c.get('kind')}: {c.get('title', '')} {what} — {status.get(c.get('id'), 'unknown')})")
    return "\n".join(parts) + "\n"


def ensure_briefs(cfg: dict) -> list[str]:
    """The first run of a day writes the briefs the days before it are
    missing: each of the last BRIEF_DAYS days whose conversation the agent
    answered in, and that has no brief yet. Once a day: its state says so,
    so a brief the student forgot line by line is not written again. A
    day whose note is marked private gets none — what was said there does
    not travel into the days after. Runs that start together (the page's
    plan and the morning pass) wait for each other."""
    STATE_HOME.mkdir(parents=True, exist_ok=True)
    written = []
    today = dt.date.today()
    with open(STATE_HOME / "briefs.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for back in range(BRIEF_DAYS, 0, -1):
            date = today - dt.timedelta(days=back)
            paths = Paths(cfg, date)
            if not paths.state.exists():
                continue
            state = load_state(paths)
            day = state.get("day") or {}
            if day.get("brief") or not any(t["role"] == "agent" and t.get("text") for t in day.get("turns") or []):
                continue
            at = dt.datetime.now().isoformat(timespec="seconds")
            try:
                private = note_is_private(blocklib.split(paths.note.read_text()))
            except FileNotFoundError:
                private = False
            private = private or before_horizon(cfg, date)
            if private:
                day["brief"] = {"at": at, "skipped": "the note is private"}
                write_atomic(paths, paths.state, json.dumps(state, indent=2, ensure_ascii=False) + "\n")
                continue
            payload = brief_payload(cfg, date, day["turns"])
            now = Paths(cfg, today)
            now.payloads.mkdir(parents=True, exist_ok=True)
            payload_file = now.payloads / f"{dt.datetime.now():%Y%m%d-%H%M%S}-brief-{date.isoformat()}.md"
            payload_file.write_text(payload)               # logged before inference
            result = run_model(dict(cfg, agent=cfg.get("dayAgent", "longhand-day")), now, payload,
                               message="Write the day's brief. The context follows on stdin.")
            payload_file.with_suffix(".events.jsonl").write_text(result["events"])
            text = "" if result["error"] else parse_reply(result["text"])["reply"].strip()[:BRIEF_CHARS]
            state = load_state(paths)                      # read again: the page may have written meanwhile
            day = day_of(state)
            if text:
                target = paths.knowledge / BRIEFS_DIR / f"{date.isoformat()}.md"
                body = nb.enforce(text, nb.corrections(paths.knowledge))
                write_atomic(paths, target, f"# {date:%A} {date.day} {date:%B} — the day in brief\n\n{body.rstrip()}\n")
                written.append(target.name)
            # An error is tried again by the next run; an empty answer is the agent's word that
            # nothing in the day is worth carrying.
            if not result["error"]:
                day["brief"] = {"at": at, "file": f"{BRIEFS_DIR}/{date.isoformat()}.md" if text else "",
                                "cost": result["cost"], "payload": str(payload_file),
                                "prompt": result.get("prompt", ""), "model": result.get("model", "")}
                write_atomic(paths, paths.state, json.dumps(state, indent=2, ensure_ascii=False) + "\n")
            tk = result["tokens"]
            if not now.ledger.exists():
                now.ledger.write_text("at\tdate\ttrigger\tblock\tcost\tinput\toutput\treasoning\tsession\tprompt\tmodel\n")
            with open(now.ledger, "a") as f:
                f.write(f"{at}\t{paths.stamp}\tbrief\t\t{result['cost']:.6f}\t{tk.get('input', 0)}\t{tk.get('output', 0)}"
                        f"\t{tk.get('reasoning', 0)}\t{result['session']}\t{result.get('prompt', '')}\t{result.get('model', '')}\n")
    return written


def talk_payload(cfg: dict, item: dict, ledger: dict, key: str, tasks: list[dict], fresh: str, message: str) -> str:
    """The plan the proposal came from (its logged payload; today's inputs
    when that is gone), then the conversation about it."""
    try:
        base = Path(item.get("payload") or "").read_text() if item.get("payload") else fresh
    except OSError:
        base = fresh
    show = {k: v for k, v in item.items() if k in ("id", "kind", "key", "date", "title", "project", "why", "priority",
                                                   "steps", "source", "was", "question", "recommended")}
    if item["status"] == "told":
        show["done_already"] = True
    parts = [base.rstrip(), "", "# The proposal the student wants to talk about", "", "```json",
             json.dumps(show, indent=1, ensure_ascii=False), "```"]
    others = [x for x in ledger["items"] if x["id"] != item["id"] and x["kind"] != "question"
              and planlib.thread_key(x, tasks) == key][-10:]
    if others:
        parts += ["", "# Your other proposals about this box, and what came of them", ""]
        parts += [f"- #{x['id']} {x['kind']}" + (f" {x['date']}" if x.get("date") else "")
                  + f": {x['status']}" + (f" — they said: {x['reason']}" if x.get("reason") else "") for x in others]
    task = next((t for t in tasks if t["key"] == item.get("key")), None) if item.get("key") else None
    parts += ["", "# The box as it stands", ""]
    parts.append(f"{task['text']} (in the note of {task['date']})" if task
                 else "(a question about no box in particular)" if item["kind"] == "question"
                 else "(no box yet: a deadline found in the writing)")
    margin = margin_talk(cfg, task)
    if margin:
        parts += ["", "# What was said about this box in the margin of its note (read-only)", ""] + margin
    parts += day_tail(Paths(cfg, dt.date.today()))
    turns = planlib.thread(ledger, key)["turns"][-planlib.TALK_TURNS:]
    if turns:
        parts += ["", "# Your conversation about this box so far", ""]
        parts += [f"{'you' if t['role'] == 'agent' else 'student'}: {t['text']}" for t in turns]
    parts += ["", "# The student says now", "", message, "", TALK_TAIL]
    return "\n".join(parts) + "\n"


def cmd_talk(cfg: dict, args) -> int:
    """The student talks with the planner about one of its proposals, its
    questions, or what it did on its own (2026-10-20). The box's one
    conversation grows by two turns; a revision is checked like any plan and
    replaces the proposal; an agreement is settled — here when nothing in a
    note changes (a decline; an answered question; a done thing let stand),
    else by the page (an accept it writes, an undo it makes). Prints what
    happened, for the page: `resolved` says whether it is settled already."""
    message = (args.message or "").strip()
    if not message:
        raise Fail("--message is empty")
    ledger = planlib.load_ledger(PROPOSALS)
    item = next((x for x in ledger["items"] if x["id"] == args.id), None)
    if item is None:
        raise Fail(f"no proposal #{args.id}")
    if item["status"] not in ("open", "told") or item["kind"] == "file":
        raise Fail(f"#{args.id} is not open, nor the planner's ({item['kind']}, {item['status']})")
    today = dt.date.today()
    paths = Paths(cfg, today)
    tasks, deadlines, days, cands, boxes, notes, allowed = plan_inputs(cfg, today)
    key = planlib.thread_key(item, tasks)
    title = (next((t["title"] for t in tasks if t["key"] == key), "") if item.get("key") else item.get("title", "")) \
        or item.get("title", "")
    fresh = plan_payload(cfg, paths, today, {"today": today.isoformat(), "fortnight": days, "candidates": cands,
                                              "open_boxes": boxes}, notes)
    payload = talk_payload(cfg, item, ledger, key, tasks, fresh, message)
    paths.payloads.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    payload_file = paths.payloads / f"{stamp}-talk-{item['id']}.md"
    payload_file.write_text(payload)          # logged before inference
    result, reply = talk_run(plan_cfg_of(cfg), paths, payload, talk_message(item))
    payload_file.with_suffix(".events.jsonl").write_text(result["events"])

    at = dt.datetime.now().isoformat(timespec="seconds")
    lock = planlib.hold(PROPOSALS)
    ledger = planlib.load_ledger(PROPOSALS)   # the page may have answered something meanwhile
    item = next(x for x in ledger["items"] if x["id"] == args.id)
    current, revised, settled, resolved = item, None, "", False
    if item["status"] == "open" and item["kind"] != "question" and reply["revise"] is not None:
        closed = planlib.store_deadlines(STATE_HOME / "deadlines.tsv", ("done", "cancelled"))
        kept, _ = planlib.validate({"proposals": [reply["revise"]]}, cands, days, ledger, today, boxes, deadlines,
                                   allowed, closed, project_tags(cfg))
        new = planlib.check_revision(item, reply["revise"], kept)
        if new is not None:
            new.pop("auto", None)             # a revision waits for the person, whatever the level
            current = revised = planlib.revise(ledger, item, dict(new, prompt=result.get("prompt", ""),
                                                                  model=result.get("model", ""), payload=str(payload_file)), at)
    if current["status"] in ("open", "told") and reply["settle"] in planlib.SETTLE:
        settled = reply["settle"]
        current["agreed"] = {"how": settled, "at": at}
        current["settled_by"] = "conversation"
        if current["kind"] == "question":
            # Answered (with what was agreed, else the recommended answer),
            # or not wanted: nothing in a note changes, so settled here.
            answer = (reply["answer"] or current.get("recommended", "")) if settled == "accept" else ""
            planlib.resolve(ledger, current["id"], "answered" if settled == "accept" else "declined", at, answer)
            if answer:
                keep_answer(cfg, current, answer)
            resolved = True
        elif current["status"] == "told":
            if settled == "accept":            # let stand; an undo is the page's to make
                current["status"], current["resolved"] = "accepted", at
                resolved = True
        elif settled == "decline":
            planlib.resolve(ledger, current["id"], "declined", at)
            resolved = True
        if not (current["kind"] == "question" and settled == "accept"):
            current["reason"] = message       # an answered question keeps its answer instead
    th = planlib.add_turns(ledger, key, title, [
        {"role": "student", "text": message, "at": at, "about": item["id"]},
        {"role": "agent", "text": reply["reply"] or ("(the planner could not answer: " + result["error"][:120] + ")"
                                                     if result["error"] else
                                                     "(the planner answered with a plan, not a reply — it is logged; "
                                                     "say it again, or use the keys)" if reply.get("plan") else
                                                     "(nothing to add)"),
         "at": at, "about": current["id"], "revised": str(revised["id"]) if revised else "", "settled": settled,
         "cost": result["cost"], "prompt": result.get("prompt", ""), "model": result.get("model", ""),
         "payload": str(payload_file)}])
    planlib.save_ledger(PROPOSALS, ledger)
    lock.close()
    written = []
    if not result["error"]:
        write_knowledge(paths, reply["knowledge"], written)
    tk = result["tokens"]
    paths.ledger.parent.mkdir(parents=True, exist_ok=True)
    if not paths.ledger.exists():
        paths.ledger.write_text("at\tdate\ttrigger\tblock\tcost\tinput\toutput\treasoning\tsession\tprompt\tmodel\n")
    with open(paths.ledger, "a") as f:
        f.write(f"{at}\t{paths.stamp}\ttalk\t{item['id']}\t{result['cost']:.6f}\t{tk['input']}\t{tk['output']}\t{tk['reasoning']}\t{result['session']}\t{result.get('prompt', '')}\t{result.get('model', '')}\n")
    print(json.dumps({"id": item["id"], "current": current["id"], "thread": key, "reply": reply["reply"],
                      "revised": bool(revised), "settle": settled, "kind": current["kind"], "resolved": resolved,
                      # The conversation as it stands, for the margin: once settled, the
                      # proposal leaves the list, and its turns with it.
                      "turns": [{"role": u["role"], "text": u["text"], "about": u.get("about"), "revised": u.get("revised", ""),
                                 "settled": u.get("settled", "")} for u in th["turns"]],
                      "error": result["error"]}, ensure_ascii=False))
    return 0 if not result["error"] else 1


def talk_run(cfg: dict, paths: Paths, payload: str, message: str, env: dict | None = None) -> tuple[dict, dict]:
    """One talk with the planner: its answer, asked for once more in the
    same session when it came back as a plan (TALK_TAIL says why). The
    result adds up both passes."""
    result = run_model(cfg, paths, payload, message=message, env=env)
    reply = parse_talk(result["text"]) if not result["error"] else dict(parse_talk(""), reply="")
    if reply.get("plan") and result["session"]:
        again = run_model(cfg, paths, "", session=result["session"], message=TALK_AGAIN, env=env)
        result = dict(again, events=result["events"] + again["events"], cost=result["cost"] + again["cost"],
                      tokens={k: result["tokens"][k] + again["tokens"][k] for k in result["tokens"]})
        if not again["error"]:
            reply = parse_talk(again["text"])
    return result, reply


def parse_talk(text: str) -> dict:
    """The talk's one JSON block. `plan` says it came back in the plan's
    shape instead — no `reply`, but proposals or questions — which is a
    failure to answer, not "nothing to add"."""
    out = {"reply": "", "revise": None, "settle": None, "answer": "", "knowledge": [], "plan": False}
    m = None
    for m in re.finditer(r"```(?:json)?\s*\n(.*?)\n```", text, re.S):
        pass
    for c in ([m.group(1)] if m else []) + [text.strip()]:
        try:
            obj = json.loads(c)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict):
            out["reply"] = str(obj.get("reply") or "").strip()
            out["revise"] = obj.get("revise") if isinstance(obj.get("revise"), dict) else None
            out["settle"] = obj.get("settle") if obj.get("settle") in planlib.SETTLE else None
            out["answer"] = re.sub(r"\s+", " ", str(obj.get("answer") or "")).strip()[:300]
            out["knowledge"] = [x for x in obj.get("knowledge") or [] if isinstance(x, dict)] \
                if isinstance(obj.get("knowledge"), list) else []
            out["plan"] = "reply" not in obj and ("proposals" in obj or "questions" in obj)
            return out
    out["reply"] = text.strip()
    return out


