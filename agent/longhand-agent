def cmd_proposals(cfg: dict, args) -> int:
    """What the agent proposes or asks, open, for the dashboard — each with
    where its box is — and the do-dates accepted lately (their pills carry
    the agent's tint). A do-date whose box got a date some other way, is
    done, or is gone, is settled as moot first."""
    tasks = plan_tasks(cfg)
    lock = planlib.hold(PROPOSALS)
    ledger = planlib.load_ledger(PROPOSALS)
    at = dt.datetime.now().isoformat(timespec="seconds")
    changed = planlib.settle_moot(ledger, tasks, at)
    changed += planlib.settle_projects(ledger, project_tags(cfg), at)
    changed += inbox_pass(cfg, ledger, at)
    if changed:
        planlib.save_ledger(PROPOSALS, ledger)
    lock.close()
    by_key = {t["key"]: t for t in tasks}
    out = []
    for x in planlib.open_items(ledger):
        t = by_key.get(x["key"]) if x["key"] else None
        out.append(dict(x, thread=planlib.thread_key(x, tasks),
                        where={"date": t["date"], "line": t["line"], "text": t["text"]} if t else None))
    # Every box's conversation with the planner, settled or not: the note's
    # margin shows it with the box's own (one conversation per task).
    threads = {k: [{"role": u["role"], "text": u["text"], "at": u.get("at", ""), "about": u.get("about"),
                    "revised": u.get("revised", ""), "settled": u.get("settled", "")} for u in th.get("turns") or []]
               for k, th in (ledger.get("threads") or {}).items()}
    since = (dt.date.today() - dt.timedelta(days=planlib.DAYS)).isoformat()
    accepted = [{"key": x["key"], "date": x["date"]} for x in ledger["items"]
                if x["kind"] == "do-date" and x["status"] == "accepted" and x.get("resolved", "") >= since]
    told = [dict(x, where=None) for x in planlib.told(ledger)]
    print(json.dumps({"open": out, "told": told, "accepted": accepted, "threads": threads,
                      "count": len(out) + len(told)}, ensure_ascii=False))
    return 0


def cmd_proposal(cfg: dict, args) -> int:
    with planlib.hold(PROPOSALS):
        return answer_proposal(cfg, args)


def answer_proposal(cfg: dict, args) -> int:
    """The person's answer to one proposal or question. Accepting a do-date
    is recorded here; the do-date itself is written into the note by the
    page, the one writer of notes. An answered question is kept in the
    agent's knowledge as `answers.md`, which it reads every time and never
    writes, so it does not ask again."""
    ledger = planlib.load_ledger(PROPOSALS)
    at = dt.datetime.now().isoformat(timespec="seconds")
    item = next((x for x in ledger["items"] if x["id"] == args.id), None)
    if item is None:
        raise Fail(f"no proposal #{args.id}")
    # What the agent did on its own (do it and tell me): the page did it and
    # says so ("applied"); the person then lets it stand ("accept") or takes
    # it back ("undo" — the page undoes a note's edit; a filed document is
    # moved back here).
    if item["status"] == "told" and args.how in ("accept", "undo"):
        if args.how == "undo" and item["kind"] == "file" and item.get("filed"):
            try:
                os.replace(item["filed"], item["src"])
            except OSError as e:
                raise Fail(f"could not move it back: {e}")
        item["status"], item["resolved"] = ("accepted" if args.how == "accept" else "undone"), at
        planlib.save_ledger(PROPOSALS, ledger)
        print(json.dumps({"id": args.id, "status": item["status"], "changed": True}))
        return 0
    if item["status"] != "open":
        print(json.dumps({"id": args.id, "status": item["status"], "changed": False}))
        return 0
    if args.how == "applied":
        if not item.get("auto"):
            raise Fail(f"#{args.id} was not the agent's to do")
        item["status"], item["told_at"] = "told", at
        planlib.save_ledger(PROPOSALS, ledger)
        print(json.dumps({"id": args.id, "status": "told", "changed": True}))
        return 0
    if args.how == "undo":
        raise Fail(f"#{args.id} was not done, so there is nothing to undo")
    if args.how == "answer" or (args.how == "accept" and item["kind"] == "question"):
        answer = (args.answer or "").strip() or item.get("recommended", "")
        if item["kind"] != "question" or not answer:
            raise Fail("only a question takes an answer")
        planlib.resolve(ledger, args.id, "answered", at, answer)
        keep_answer(cfg, item, answer)
    elif args.how == "accept" and item["kind"] == "project":
        # Accepting makes it, as the person would from the page; one made
        # meanwhile (by its tag) leaves nothing to accept.
        try:
            item["made"] = make_project(cfg, item["project"], item["title"])["file"]
            planlib.resolve(ledger, args.id, "accepted", at)
        except Fail:
            planlib.resolve(ledger, args.id, "moot", at)
    elif args.how == "accept" and item["kind"] == "file":
        paths = Paths(cfg, dt.date.today())
        try:
            item["filed"] = doclib.file_one(item, paths.vault, cfg.get("projectsDir", "projects"),
                                            lambda d: guard_write(paths, d))
            planlib.resolve(ledger, args.id, "accepted", at)
        except FileNotFoundError:
            planlib.resolve(ledger, args.id, "moot", at)
    else:
        planlib.resolve(ledger, args.id, "accepted" if args.how == "accept" else "declined", at)
    # Talked about first: what the person last said is the reason kept with
    # the answer — more for the review and the evals than a silent key.
    words = planlib.last_words(ledger, item)
    if words and item["kind"] != "question":
        item["reason"] = words
    planlib.save_ledger(PROPOSALS, ledger)
    print(json.dumps({"id": args.id, "status": next(x for x in ledger["items"] if x["id"] == args.id)["status"],
                      "changed": True}))
    return 0


def keep_answer(cfg: dict, item: dict, answer: str) -> None:
    """An answered question, kept in the agent's knowledge as answers.md,
    which it reads every time and never writes, so it does not ask again."""
    paths = Paths(cfg, dt.date.today())
    f = paths.knowledge / "answers.md"
    head = "" if f.exists() else "# The student's answers\n\nWhat the student told the agent when it asked. True; never to be asked again.\n\n"
    about = f"{item['title']}: " if item.get("title") else ""
    line = f"- {dt.date.today().isoformat()} · {about}{item['question']} → {answer}\n"
    write_atomic(paths, f, head + (f.read_text() if f.exists() else "") + line)


TALK_MESSAGE = """The student wants to talk with you about one of your proposals. On stdin: the plan as you made it, \
then the proposal, what came of your others about the same box, the box as it stands, and your conversation so far \
