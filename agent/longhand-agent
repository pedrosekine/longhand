def course_codes(cfg: dict, today: dt.date) -> list[tuple[str, str, str]]:
    """(code, name, tag) for each project whose knowledge file names a
    course code; code "" for those that do not."""
    out = []
    folder = Paths(cfg, today).knowledge / "projects"
    for f in sorted(folder.glob("*.md")) if folder.is_dir() else []:
        try:
            text = f.read_text()
        except OSError:
            continue
        code, tag = CODE_RE.search(text), re.search(r"Tag:\s*`?#([\w/-]+)", text)
        name = next((l[2:].strip() for l in text.splitlines() if l.startswith("# ")), f.stem)
        out.append((code.group(1) if code else "", name, tag.group(1) if tag else ""))
    return out


def cmd_timetable(cfg: dict, args) -> int:
    """For the Settings sheet: each calendar — what came of it, and what the
    agent may see of it — and which courses the calendars know. `--fetch`
    asks now, whatever a copy's age (`--index` for one calendar). Copies of
    calendars no longer in Settings are dropped."""
    timetable.prune(cfg, STATE_HOME)
    now = dt.datetime.now()
    codes = course_codes(cfg, now.date())
    known = [c for c, _, _ in codes if c]
    cals, everything = [], []
    for n, cal in enumerate(timetable.calendars(cfg)):
        cache = timetable.cache_path(STATE_HOME, cal["url"])
        result = timetable.refresh(cal["url"], cache, max_age=0) \
            if args.fetch and (args.index < 0 or args.index == n) else ""
        events = timetable.read(cal, STATE_HOME)
        meta = timetable.meta_of(cache)
        ahead = [e for e in events or [] if e["end"] > now]
        classes = [e for e in ahead if any(timetable.matches(e, c) for c in known)]
        try:
            title = timetable.calname(cache.read_text(errors="replace")) if events is not None else ""
        except OSError:
            title = ""
        cals.append({"index": n, "name": cal["name"], "title": title, "address": timetable.masked(cal["url"]),
                     "agent": cal["agent"], "copy": events is not None, "result": result,
                     "fetched": int(meta.get("fetched", 0)), "error": meta.get("error", ""),
                     "events": len(ahead), "classes": len(classes)})
        everything += ahead
    courses = [{"name": name, "code": code,
                "sessions": sum(1 for e in everything if code and timetable.matches(e, code))}
               for code, name, _ in codes]
    nxt = min((e["start"] for e in everything), default=None)
    print(json.dumps({"configured": bool(cals), "calendars": cals, "courses": courses,
                      "next": nxt.isoformat(timespec="minutes") if nxt else ""}, ensure_ascii=False))
    return 0


def timetable_section(cfg: dict, now: dt.datetime, days: int = 14) -> list[str]:
    """The next fortnight from the calendars, for the payload, from the
    copies kept (no fetch inside a pass): every class session, named by its
    course; and, from a calendar the student chose to share whole,
    everything else in it — title, time and place, never its description.
    Then the weekdays with nothing on in what was sent, which is what makes
    "the 24th is free" a fact.

    What the agent sees of each calendar is the student's choice in
    Settings (2026-10-17): a calendar can be a whole personal one, and
    widening what the agent sees is a decision taken deliberately, not a
    side effect of which link was pasted."""
    events = timetable.sessions(cfg, STATE_HOME, fetch=False)
    if not events:
        return []
    names = {code: name + (f" #{tag}" if tag else "") for code, name, tag in course_codes(cfg, now.date()) if code}
    horizon = now + dt.timedelta(days=days)
    out, busy = [], set()
    for e in events:
        if e["end"] <= now or e["start"] >= horizon:
            continue
        course = next((n for c, n in names.items() if timetable.matches(e, c)), None)
        if course is None and e.get("agent") != "all":
            continue
        what = course or f"{e['summary']} — from your {e['calendar']} calendar"
        busy.add(e["start"].date())
        out.append(f"- {e['start']:%a %d %b} {e['start']:%H:%M}–{e['end']:%H:%M} {what}"
                   + (f" ({e['location']})" if e["location"] else ""))
    free = [d for d in (now.date() + dt.timedelta(days=i) for i in range(days))
            if d.weekday() < 5 and d not in busy]
    if free:
        out.append("Weekdays with nothing on: " + ", ".join(f"{d:%a %d %b}" for d in free))
    return out


# ------------------------------------------------------------------ planning

def plan_tasks(cfg: dict) -> list[dict]:
    """Every open box the agent may see — private notes and blocks left out
    — with its silence clock (lifespan) and its key."""
    rows = [r for r in outcomes(cfg, days=3650, visible_only=True) if not r["done"] and not r["cancelled"]]
    return lifespan.apply(rows, SILENCE)


def plan_events(cfg: dict, today: dt.date) -> list[dict]:
    """The fortnight's events the agent may see: classes (named by their
    course) and everything in a calendar shared whole."""
    events = timetable.sessions(cfg, STATE_HOME, fetch=False) or []
    codes = course_codes(cfg, today)
    horizon = dt.datetime.combine(today + dt.timedelta(days=planlib.DAYS), dt.time())
    out = []
    for e in events:
        if e["end"] <= dt.datetime.combine(today, dt.time()) or e["start"] >= horizon:
            continue
        course = next((name for code, name, _ in codes if code and timetable.matches(e, code)), None)
        if course is None and e.get("agent") != "all":
            continue
        out.append(dict(e, label=course or e["summary"]))
    return out


NOTES_DAYS = 7
NOTES_MAX = 24_000          # characters of the week's notes a plan carries


def plan_notes(cfg: dict, today: dt.date) -> list[str]:
    """The last week's notes, newest first, as the margin sees today's: a
    note marked private left out whole, private blocks left out of the
    rest. What the planner reads to notice a deadline in the writing, or a
    box the writing says is done."""
    out, size = [], 0
    for i in range(NOTES_DAYS):
        day = today - dt.timedelta(days=i)
        try:
            text = Paths(cfg, day).note.read_text()
        except OSError:
            continue
        blks = blocklib.split(text)
        if note_is_private(blks) or before_horizon(cfg, day):
            continue
        body = "\n\n".join(b["text"] for b in visible_blocks(blks)).strip()
        if not body:
            continue
        chunk = f"## {day.isoformat()} ({day:%A})\n\n{body}\n"
        if size + len(chunk) > NOTES_MAX:
            chunk = chunk[:max(0, NOTES_MAX - size)] + "\n…(cut)\n"
        out.append(chunk)
        size += len(chunk)
        if size >= NOTES_MAX:
            break
    return out


def plan_payload(cfg: dict, paths: Paths, today: dt.date, data: dict, notes: list[str] | None = None) -> str:
    parts = ["# Plan", f"today: {today.isoformat()} ({today:%A})", "",
             "# Data (computed by local code; trust the numbers)", "",
             "```json", json.dumps(data, indent=1, ensure_ascii=False), "```"]
    if notes:
        parts += ["", "# The student's notes, the last seven days (private parts removed; read-only)", ""] + notes
    parts += knowledge_parts(paths)
    dismissed = read_dismissed(paths)
    if dismissed:
        parts += ["", "# Suggestions the student dismissed", ""] + [f"- {d}" for d in dismissed]
    return "\n".join(parts) + "\n"


def parse_plan(text: str) -> dict:
    empty = {"proposals": [], "questions": [], "knowledge": []}
    m = None
    for m in re.finditer(r"```(?:json)?\s*\n(.*?)\n```", text, re.S):
        pass
    for c in ([m.group(1)] if m else []) + [text.strip()]:
        try:
            obj = json.loads(c)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict):
            return {k: obj.get(k) if isinstance(obj.get(k), list) else [] for k in empty}
    return empty


def plan_inputs(cfg: dict, today: dt.date) -> tuple:
    """What a plan is made from, and a proposal is checked against: the
    open boxes, the store's deadlines, the fortnight, the candidates for a
    do-date, the boxes for the other actions, the week's notes, and what
    the student allows."""
    tasks = plan_tasks(cfg)
    deadlines = planlib.store_deadlines(STATE_HOME / "deadlines.tsv")
    days = planlib.fortnight(today, plan_events(cfg, today), deadlines, tasks)
    return (tasks, deadlines, days, planlib.candidates(tasks, deadlines, today),
            planlib.open_boxes(tasks, deadlines, today), plan_notes(cfg, today), planlib.autonomy(cfg))


def plan_cfg_of(cfg: dict) -> dict:
    """The planner may reach a model of its own (docs/agent.md, "Reaching a
    model"): `planModel` in the config, with `planVariant` if that model
    names one; otherwise the same model as the margin."""
    out = dict(cfg, agent=cfg.get("planAgent", "longhand-plan"))
    if cfg.get("planModel"):
        out["model"], out["variant"] = cfg["planModel"], cfg.get("planVariant", "")
    return out


def cmd_plan(cfg: dict, args) -> int:
    """The planning job (docs/agent.md): at most once a day, again when what
    it plans around changed, and whenever asked (--force). The arithmetic is
    local (plan.py); the model brings judgement; what it says is checked
    before it reaches the ledger, and nothing is written into a note — the
    page writes a do-date when the person accepts it."""
    ensure_briefs(cfg)
    today = dt.date.today()
    paths = Paths(cfg, today)
    tasks, deadlines, days, cands, boxes, notes, allowed = plan_inputs(cfg, today)
    digest = planlib.inputs_hash(cands, days) + hashlib.sha256(
        json.dumps([boxes, notes, allowed], sort_keys=True, default=str).encode()).hexdigest()[:8]
    try:
        last = json.loads(PLAN_STATE.read_text())
    except (OSError, ValueError):
        last = {}
    at = dt.datetime.now().isoformat(timespec="seconds")
    if not args.force and last.get("day") == today.isoformat() and last.get("hash") == digest:
        print(json.dumps({"ran": False, "why": "nothing changed since today's plan"}))
        return 0
    state = {"day": today.isoformat(), "hash": digest, "at": at}
    if not cands and not boxes and not notes:
        planlib._write(PLAN_STATE, state)
        print(json.dumps({"ran": False, "why": "nothing to plan"}))
        return 0

    ledger = planlib.load_ledger(PROPOSALS)
    data = {
        "today": today.isoformat(),
        "fortnight": days,
        "candidates": cands,
        "workload": planlib.workload(tasks, deadlines, today),
        "deadlines": [{"title": x["title"], "due": x["due"].strftime("%Y-%m-%d %H:%M"), "project": x["project"]}
                      for x in sorted(deadlines, key=lambda x: x["due"])][:20],
        "your_record": planlib.summary(ledger),
        # Every open box, for the actions that are not about a day, and what
        # the student allows: a kind at "never" is not to be proposed.
        "open_boxes": boxes,
        # What the store has closed (done or cancelled) — a ticked box is in
        # neither list above, and must not come back as a new deadline.
        "closed_deadlines": [{"title": x["title"], "due": x["due"].strftime("%Y-%m-%d %H:%M"), "status": x["status"]}
                             for x in planlib.store_deadlines(STATE_HOME / "deadlines.tsv", ("done", "cancelled"))
                             if abs((x["due"].date() - today).days) <= 183],
        "you_may": sorted(k for k, v in allowed.items() if v != "never" and k != "file"),
        # What the student said when they talked with you about a box's
        # proposals (`talk`): still true for that box and the boxes under it.
        "conversations": planlib.plan_talks(ledger, {planlib.root_key(b["key"], tasks) for b in boxes}
                                            | {planlib.root_key(c["key"], tasks) for c in cands}),
    }
    payload = plan_payload(cfg, paths, today, data, notes)
    paths.payloads.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    payload_file = paths.payloads / f"{stamp}-plan.md"
    payload_file.write_text(payload)          # logged before inference

    result = run_model(plan_cfg_of(cfg), paths, payload, message="Plan the fortnight. The context follows on stdin.")
    reply = parse_plan(result["text"]) if not result["error"] else {"proposals": [], "questions": [], "knowledge": []}
    # What the store has closed, too: a ticked box must not return as a new deadline.
    closed = planlib.store_deadlines(STATE_HOME / "deadlines.tsv", ("done", "cancelled"))
    # Read again once the model has answered: what the page settled while it
    # thought is kept, and checked against.
    lock = planlib.hold(PROPOSALS)
    ledger = planlib.load_ledger(PROPOSALS)
    props, qs = planlib.validate(reply, cands, days, ledger, today, boxes, deadlines, allowed, closed,
                                 project_tags(cfg))
    for item in props + qs:
        item.update({"prompt": result.get("prompt", ""), "model": result.get("model", ""), "payload": str(payload_file)})
    new = planlib.record(ledger, props, qs, at)
    planlib.save_ledger(PROPOSALS, ledger)
    lock.close()

    written = []
    write_knowledge(paths, reply["knowledge"], written)

    tk = result["tokens"]
    paths.ledger.parent.mkdir(parents=True, exist_ok=True)
    if not paths.ledger.exists():
        paths.ledger.write_text("at\tdate\ttrigger\tblock\tcost\tinput\toutput\treasoning\tsession\tprompt\tmodel\n")
    with open(paths.ledger, "a") as f:
        f.write(f"{at}\t{paths.stamp}\tplan\t\t{result['cost']:.6f}\t{tk['input']}\t{tk['output']}\t{tk['reasoning']}\t{result['session']}\t{result.get('prompt', '')}\t{result.get('model', '')}\n")
    # A plan that failed is not today's plan: the next opening tries again,
    # and the page says why it could not (an expired key, no network).
    if result["error"]:
        state.pop("hash", None)
    state["error"] = result["error"]
    planlib._write(PLAN_STATE, state)
    print(json.dumps({"ran": True, "proposals": sum(1 for x in new if x["kind"] != "question"),
                      "questions": sum(1 for x in new if x["kind"] == "question"),
                      "knowledge": written, "cost": result["cost"], "error": result["error"]}, ensure_ascii=False))
    return 0 if not result["error"] else 1


def inbox_pass(cfg: dict, ledger: dict, at: str) -> int:
    """The Downloads inbox (documents.py): its PDFs that belong to a course
    become proposals to file them — local code, no model; nothing else in
    the folder is listed. A proposal whose file has left the inbox is moot.
    Returns how many items changed."""
    n = 0
    for x in planlib.open_items(ledger):
        if x["kind"] == "file" and not Path(x["src"]).is_file():
            x["status"], x["resolved"] = "moot", at
            n += 1
    level = planlib.autonomy(cfg)["file"]
    if not cfg.get("inbox") or level == "never":      # opt-in: config.json's "inbox"
        return n
    inbox = Path(cfg["inbox"]).expanduser()
    now = dt.datetime.now()
    courses = [{"code": c, "name": name, "tag": tag} for c, name, tag in course_codes(cfg, now.date()) if tag]
    if not courses:
        return n
    events = timetable.sessions(cfg, STATE_HOME, fetch=False) or []
    cache = doclib.load_cache(INBOX_CACHE)
    found = doclib.scan(inbox, courses, events, cache, now, timetable.matches)
    doclib.save_cache(INBOX_CACHE, cache)
    paths = Paths(cfg, now.date())
    new = doclib.proposals(found, ledger["items"], paths.vault, cfg.get("projectsDir", "projects"))
    for item in planlib.record(ledger, new, [], at):
        if level != "do":
            continue
        # Do it and tell me: filed now, told in the dashboard, one key moves it back.
        try:
            item["filed"] = doclib.file_one(item, paths.vault, cfg.get("projectsDir", "projects"),
                                            lambda d: guard_write(paths, d))
            item.update(auto=True, status="told", told_at=at)
        except FileNotFoundError:
            item.update(status="moot", resolved=at)
    return n + len(new)


def cmd_autonomy(cfg: dict, args) -> int:
    """For Settings: each kind of action, how far the agent may go with it,
    and its record — of the last ten answered, how many were accepted, and
    whether that is enough to suggest "do it and tell me". The level itself
    is the person's, written by the page into settings.json."""
    ledger = planlib.load_ledger(PROPOSALS)
    levels = planlib.autonomy(cfg)
    print(json.dumps({"kinds": [dict(planlib.record_of(ledger, k), label=label, level=levels[k],
                                     ask_only=k in planlib.ASK_ONLY)
                                for k, label in planlib.KINDS.items()]}, ensure_ascii=False))
    return 0


def cmd_documents(cfg: dict, args) -> int:
    """A course's filed documents (or every course's), for the sidebar."""
    paths = Paths(cfg, dt.date.today())
    pages = doclib.load_cache(DOCS_CACHE)
    tags = [args.tag] if args.tag else [t for _, _, t in course_codes(cfg, dt.date.today()) if t]
    out = {t: doclib.index(paths.vault, cfg.get("projectsDir", "projects"), t, pages) for t in tags}
    doclib.save_cache(DOCS_CACHE, pages)
    print(json.dumps(out, ensure_ascii=False))
