def make_project(cfg: dict, tag: str, name: str) -> dict:
    """A new project's file, `# Name` and its `Tag:` line — the person's
    act, from the page or by accepting the agent's proposal. Never over
    one that exists, by its file or by its tag."""
    t, n = projlib.clean_tag(tag), projlib.clean_name(name)
    if not t:
        raise Fail(f"“{tag}” cannot be a tag: letters, digits, - and / only")
    paths = Paths(cfg, dt.date.today())
    folder = paths.knowledge / "projects"
    if projlib.taken(folder, t):
        raise Fail(f"#{t} is a project already")
    target = folder / projlib.file_name(t)
    write_atomic(paths, target, projlib.stub(n or t, t))
    return {"tag": t, "name": n or t, "file": target.name}


