REPO_PROMPTS = Path(__file__).resolve().parent / "opencode"
# A talk is the planner's, about one of its proposals: its own job in the
# evals (2026-10-23), since the planner's prompt was never checked at it.
JOB_AGENT = {"margin": "longhand", "plan": "longhand-plan", "day": "longhand-day", "talk": "longhand-plan"}


def job_model(cfg: dict, job: str, override: str = "") -> tuple[str, str]:
    """(model, variant) a job runs on: an override, else the config's —
    the planner's own `planModel` for a plan."""
    if override:
        return override, ""
    if job in ("plan", "talk") and cfg.get("planModel"):
        return cfg["planModel"], cfg.get("planVariant", "")
    return cfg.get("model", ""), cfg.get("variant", "")


def eval_env(prompts: Path) -> tuple[dict, Path]:
    """A configuration of opencode's own in which the agents are the ones in
    `prompts` (the candidate), everything else as installed — so a prompt is
    checked before it is ever installed."""
    home = Path(tempfile.mkdtemp(prefix="longhand-eval-"))
    agents = home / "opencode" / "agent"
    agents.mkdir(parents=True)
    real = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "opencode"
    for name in ("opencode.json", "opencode.jsonc", "config.json"):
        if (real / name).exists():
            (home / "opencode" / name).write_text((real / name).read_text())
    for f in prompts.glob("*.md"):
        (agents / f.name).write_text(f.read_text())
    return dict(os.environ, XDG_CONFIG_HOME=str(home)), home


def day_case_payload(cfg: dict, src: Path) -> str:
    """A day payload as one message an eval can send: the day's first
    message carries all the context and is used as it is; a later one went
    to a session that held the rest, so it is joined to the first message of
    its day and the turns between them, from the day's state."""
    text = src.read_text()
    if text.startswith("# Brief") or "# Your knowledge files" in text:
        return text
    firsts = [f for f in sorted(src.parent.glob(src.name[:8] + "-*-day.md"))
              if f.name < src.name and "# Your knowledge files" in f.read_text()]
    if not firsts:
        raise Fail(f"{src.name} continues a conversation whose first message is not in {src.parent}")
    first = firsts[-1].read_text()
    said = lambda t: (re.findall(r"# The student says\n\n(.*?)(?:\n\nAnswer with|\n*$)", t, re.S) or [""])[-1].strip()  # noqa: E731
    turns = (load_state(Paths(cfg, dt.datetime.strptime(src.name[:8], "%Y%m%d").date())).get("day") or {}).get("turns") or []
    begin = next((i for i, t in enumerate(turns) if t["role"] == "student" and t["text"] == said(first)), None)
    end = next((i for i in range(len(turns) - 1, -1, -1) if turns[i]["role"] == "student" and turns[i]["text"] == said(text)), None)
    if begin is None or end is None or end <= begin:
        raise Fail(f"cannot find the turns between {firsts[-1].name} and {src.name} in the day's state")
    between = [f"{'Longhand' if t['role'] == 'agent' else 'student'}: {t.get('text') or '(no answer)'}"
               for t in turns[begin + 1:end]]
    return (first.rstrip() + "\n\n# The conversation since (the same session)\n\n" + "\n".join(between)
            + "\n\n# The next message\n\n" + text)


def cmd_eval(cfg: dict, args) -> int:
    paths = Paths(cfg, dt.date.today())
    if args.what == "add":
        src = Path(args.source)
        if not src.exists():
            raise Fail(f"no payload at {src}")
        job = args.job or ("plan" if src.name.endswith("-plan.md") else
                           "talk" if "-talk-" in src.name else
                           "day" if src.name.endswith("-day.md") or "-brief-" in src.name else "margin")
        payload = day_case_payload(cfg, src) if job == "day" else src.read_text()
        case = evallib.new_case(job, payload, src.name, args.note, args.answer)
        folder = evallib.cases_dir(paths.agent_dir)
        folder.mkdir(parents=True, exist_ok=True)
        cid = args.id or src.stem
        f = folder / f"{cid}.json"
        if f.exists():
            raise Fail(f"a case {cid} exists already ({f})")
        f.write_text(json.dumps(dict(case, id=cid), indent=1, ensure_ascii=False) + "\n")
        print(f"case {cid} → {f}\nwrite its rules and criteria there, then: longhand-agent eval run --case {cid}")
        return 0

    if args.what == "status":
        rows = []
        for job, agent in JOB_AGENT.items():
            model = model_of(dict(cfg, model=job_model(cfg, job)[0], variant=job_model(cfg, job)[1]), agent)
            for which, prompts in (("installed", None), ("repo", REPO_PROMPTS)):
                v = prompt_version(agent, prompts)
                ok = evallib.passed(paths.agent_dir, job, v, model)
                rows.append({"job": job, "prompts": which, "prompt": v, "model": model,
                             "checked": "passed" if ok else ("failed" if ok is False else "never run")})
        n = {j: sum(1 for c in evallib.load_cases(paths.agent_dir) if c["job"] == j) for j in JOB_AGENT}
        reviews = sorted((paths.agent_dir / "reviews").glob("*.md")) if (paths.agent_dir / "reviews").is_dir() else []
        if args.json:
            print(json.dumps({"rows": rows, "cases": n, "latest_review": str(reviews[-1]) if reviews else ""}))
        else:
            for r in rows:
                print(f"{r['job']:7} {r['prompts']:9} prompt {r['prompt']} · {r['model']:28} · {r['checked']}")
            print(f"cases: {n['margin']} margin, {n['plan']} plan, {n['day']} day, {n['talk']} talk")
        return 0

    # run
    cases = evallib.load_cases(paths.agent_dir, args.case or None)
    if not cases:
        raise Fail("no eval cases yet: add one with `longhand-agent eval add <payload> --job margin|plan|day|talk`")
    prompts = Path(args.prompts) if args.prompts else REPO_PROMPTS
    env, home = eval_env(prompts)
    judge_model = args.judge_model or cfg.get("evalJudgeModel") or job_model(cfg, "plan")[0]
    out_cases, jobs = [], {}
    try:
        for case in cases:
            job = case["job"]
            agent = JOB_AGENT[job]
            model, variant = job_model(cfg, job, args.model)
            c = dict(cfg, agent=agent, model=model, variant=variant, _prompts=prompts)
            t0 = dt.datetime.now()
            if job == "talk":
                # As a talk runs now: its format said last (a case from before
                # 2026-10-23 lacks it), asked again once if a plan comes back.
                payload = case["payload"] if TALK_TAIL in case["payload"] else case["payload"].rstrip() + "\n\n" + TALK_TAIL + "\n"
                res, reply = talk_run(c, paths, payload, TALK_MESSAGE + (TALK_QUESTION if evallib.talk_kind(payload) == "question" else ""),
                                      env=env)
            else:
                res = run_model(c, paths, case["payload"], env=env,
                                message="Plan the fortnight. The context follows on stdin." if job == "plan" else
                                "Write the day's brief. The context follows on stdin." if case["payload"].startswith("# Brief")
                                else "Context follows on stdin.")
            secs = round((dt.datetime.now() - t0).total_seconds(), 1)
            if job == "talk":
                rules = evallib.check_talk(case, reply)
                answer = (reply.get("reply") or "(no reply)") + (f"\n(settle: {reply['settle']})" if reply.get("settle") else "") \
                    + (f"\n(answer kept: {reply['answer']})" if reply.get("answer") else "")
            elif job == "plan":
                reply = parse_plan(res["text"]) if not res["error"] else {"proposals": [], "questions": [], "knowledge": []}
                rules, kept = evallib.check_plan(case, reply)
                answer = evallib.render_plan(kept)
            elif job == "day":
                reply = parse_reply(res["text"]) if not res["error"] else {"reply": ""}
                rules, answer = evallib.check_day(case, reply)
            else:
                reply = parse_reply(res["text"]) if not res["error"] else {"reply": ""}
                rules = evallib.check_margin(case, reply)
                answer = reply.get("reply") or "(silence)"
            if res["error"]:
                rules.insert(0, {"check": "the model answered", "pass": False, "why": res["error"][:200]})
            crit = []
            if case.get("criteria") and not args.no_judge and not res["error"]:
                jc = dict(cfg, agent="longhand-judge", model=judge_model, variant="", _prompts=prompts)
                jr = run_model(jc, paths, evallib.judge_payload(case, answer), env=env,
                               message="Grade the answer against the criteria. The material follows on stdin.")
                verdicts = evallib.parse_judge(jr["text"], len(case["criteria"])) if not jr["error"] else \
                    [{"pass": False, "why": "the judge failed: " + jr["error"][:120]} for _ in case["criteria"]]
                crit = [dict(v, criterion=k) for k, v in zip(case["criteria"], verdicts)]
            ok = all(r["pass"] for r in rules) and all(c["pass"] for c in crit)
            out_cases.append({"id": case["id"], "job": job, "pass": ok, "secs": secs, "answer": answer,
                              "rules": rules, "criteria": crit, "prompt": res["prompt"], "model": res["model"]})
            j = jobs.setdefault((job, res["prompt"], res["model"]), {"job": job, "prompt": res["prompt"],
                                                                     "model": res["model"], "cases": 0, "passed": 0})
            j["cases"] += 1
            j["passed"] += ok
            mark = "PASS" if ok else "FAIL"
            print(f"{mark} {case['id']} ({job}, {secs}s)")
            for r in rules + crit:
                if not r["pass"] or args.verbose:
                    print(f"     {'ok ' if r['pass'] else 'no '} {r.get('check') or r.get('criterion')} — {r.get('why', '')}")
            if not ok or args.verbose:
                print("     answer: " + answer.replace("\n", " / ")[:400])
    finally:
        import shutil
        shutil.rmtree(home, ignore_errors=True)
    result = {"at": dt.datetime.now().isoformat(timespec="seconds"), "judge": judge_model,
              "prompts_from": "repo" if prompts == REPO_PROMPTS else str(prompts),
              "jobs": list(jobs.values()), "cases": out_cases}
    f = evallib.save_result(paths.agent_dir, result)
    total, good = len(out_cases), sum(1 for c in out_cases if c["pass"])
    print(f"\n{good}/{total} cases pass · " + " · ".join(f"{j['job']} prompt {j['prompt']} on {j['model']}: {j['passed']}/{j['cases']}"
                                                         for j in jobs.values()) + f"\nkept in {f}")
    return 0 if good == total else 1


# ------------------------------------------------------------------ the weekly review

def review_text(cfg: dict, since: dt.date, until: dt.date) -> str:
    """The week of the agent, for the student to read and act on: which
    prompts and models ran, how the replies were rated, what came of the
    proposals, what missed — each miss with the command that makes it an
    eval case — and whether what runs now has passed its evals. Local
    arithmetic over the records; no model."""
    paths = Paths(cfg, until)
    runs, replies, answers, briefs = [], [], [], []
    d = since
    while d <= until:
        p = Paths(cfg, d)
        if p.state.exists():
            st = load_state(p)
            for r in st.get("runs", []):
                if r.get("trigger") == "day":
                    continue                       # the day's conversation has its own section
                runs.append(dict(r, date=p.stamp))
            day = st.get("day") or {}
            turns = day.get("turns") or []
            for i, t in enumerate(turns):
                if t["role"] == "agent" and not t.get("error"):
                    asked = next((u["text"] for u in reversed(turns[:i]) if u["role"] == "student"), "")
                    answers.append(dict(t, date=p.stamp, asked=asked))
            if (day.get("brief") or {}).get("file"):
                briefs.append(dict(day["brief"], date=p.stamp))
            for h, rec in st.get("blocks", {}).items():
                if rec.get("reply"):
                    replies.append(dict(rec, hash=h, date=p.stamp))
        d += dt.timedelta(days=1)
    ledger = planlib.load_ledger(PROPOSALS)
    items = [x for x in ledger["items"] if since.isoformat() <= (x.get("at") or "")[:10] <= until.isoformat()]

    lines = [f"# The agent, {since.isoformat()} – {until.isoformat()}", "",
             "A week of Longhand's agent, for you to read: what ran, what you said about it, what missed. "
             "Instructions change only by an edit you make, checked by `longhand-agent eval run` first.", ""]
    by = {}
    for r in runs:
        k = (r.get("prompt") or "?", r.get("model") or "?")
        by.setdefault(k, 0)
        by[k] += 1
    lines += ["## What ran", ""]
    if by:
        for (pv, m), n in sorted(by.items(), key=lambda x: -x[1]):
            lines.append(f"- {n} margin run{'s' if n != 1 else ''} · prompt `{pv}` · {m}")
    else:
        lines.append("- no margin runs")
    plans = sum(1 for x in items if x["kind"] == "do-date") + sum(1 for x in items if x["kind"] == "question")
    lines.append(f"- {plans} proposals and questions from the planner")

    up = [r for r in replies if (r.get("rating") or {}).get("value") == "up"]
    down = [r for r in replies if (r.get("rating") or {}).get("value") == "down"]
    lines += ["", "## Replies", "",
              f"- {len(replies)} replies · {len(up)} helpful · {len(down)} not helpful · {len(replies) - len(up) - len(down)} not rated"]
    for r in down:
        lines += ["", f"**Not helpful** — {r['date']}, on “{(r.get('head') or '')[:80]}” (prompt `{r.get('prompt', '?')}`, {r.get('model', '?')})",
                  "", "> " + " ".join((r.get("reply") or "").split())[:400]]
        if r.get("payload"):
            lines += ["", f"Make it a case: `longhand-agent eval add {r['payload']} --job margin --answer \"…\"`"]

    up = [a for a in answers if (a.get("rating") or {}).get("value") == "up"]
    down = [a for a in answers if (a.get("rating") or {}).get("value") == "down"]
    cards = [x for x in items if x.get("from") == "day"]
    lines += ["", "## The day's conversations", "",
              f"- {len(answers)} answers · {len(up)} helpful · {len(down)} not helpful · {len(answers) - len(up) - len(down)} not rated",
              f"- {len(cards)} cards proposed: " + (", ".join(f"{n} {k}" for k, n in sorted(
                  {s: sum(1 for x in cards if x['status'] == s) for s in {x['status'] for x in cards}}.items())) or "none"),
              f"- {len(briefs)} briefs written"]
    for a in down:
        lines += ["", f"**Not helpful** — {a['date']}, asked “{' '.join(a['asked'].split())[:80]}” "
                      f"(prompt `{a.get('prompt', '?')}`, {a.get('model', '?')})",
                  "", "> " + " ".join((a.get("text") or "").split())[:400]]
        if a.get("payload"):
            lines += ["", f"Make it a case: `longhand-agent eval add {a['payload']} --job day --answer \"…\"`"]
    for b in briefs:
        if b.get("payload"):
            lines += ["", f"The brief of {b['date']}, if it reads wrong in Settings: "
                          f"`longhand-agent eval add {b['payload']} --job day`"]

    lines += ["", "## Proposals and questions", ""]
    summ = {}
    for x in items:
        summ.setdefault(x["kind"], {}).setdefault(x["status"], 0)
        summ[x["kind"]][x["status"]] += 1
    if summ:
        for kind, c in sorted(summ.items()):
            lines.append(f"- {kind}: " + ", ".join(f"{v} {k}" for k, v in sorted(c.items())))
    else:
        lines.append("- none")
    for x in items:
        if x["kind"] == "do-date" and x["status"] == "declined":
            lines += ["", f"**Declined** — do {x['date']} for “{x['title']}” ({x.get('model', '?')}): {x.get('why', '')}"]
            if x.get("reason"):
                lines += ["", f"> they said: {x['reason']}"]
            if x.get("payload"):
                lines += ["", f"Make it a case: `longhand-agent eval add {x['payload']} --job plan`"]
    answered = [x for x in items if x["kind"] == "question" and x["status"] == "answered"]
    for x in answered:
        lines += [f"- answered: {x['question']} → {x.get('answer', '')}"]

    lines += ["", "## Is what runs checked?", ""]
    for job, agent in JOB_AGENT.items():
        model, variant = job_model(cfg, job)
        m = model_of(dict(cfg, model=model, variant=variant), agent)
        v = prompt_version(agent)
        ok = evallib.passed(paths.agent_dir, job, v, m)
        lines.append(f"- {job}: prompt `{v}` on {m} — " + ("passed its evals" if ok else
                     "**failed its last eval run**" if ok is False else "**never checked** — run `longhand-agent eval run`"))
    hist = [r for r in evallib.history(paths.agent_dir) if since.isoformat() <= r["at"][:10] <= until.isoformat()]
    for r in hist:
        good = sum(1 for c in r["cases"] if c["pass"])
        lines.append(f"- eval run {r['at'][:16]}: {good}/{len(r['cases'])} cases pass")
    n = len(evallib.load_cases(paths.agent_dir))
    lines += ["", f"{n} eval case{'s' if n != 1 else ''} in `agents/longhand/evals/cases/`.", ""]
    return "\n".join(lines)


def cmd_review(cfg: dict, args) -> int:
    """The weekly review. `--if-due`: written only when no review covers the
    last seven days — what the page asks when it opens (pull, not push:
    nothing runs on a timer)."""
    until = dt.date.today()
    since = dt.date.fromisoformat(args.since) if args.since else until - dt.timedelta(days=6)
    paths = Paths(cfg, until)
    folder = paths.agent_dir / "reviews"
    year, week, _ = until.isocalendar()
    f = folder / f"{year}-W{week:02d}.md"
    if args.if_due:
        latest = max((p.stat().st_mtime for p in folder.glob("*.md")), default=0) if folder.is_dir() else 0
        if latest and dt.date.fromtimestamp(latest) > until - dt.timedelta(days=7):
            print(json.dumps({"written": "", "why": "a review covers this week already"}))
            return 0
    text = review_text(cfg, since, until)
    if args.write or args.if_due:
        write_atomic(paths, f, text)
        print(json.dumps({"written": str(f)}))
    else:
        print(text)
    return 0


def cmd_install(cfg: dict, args) -> int:
    here = Path(__file__).resolve().parent
    agents = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "opencode" / "agent"
    agents.mkdir(parents=True, exist_ok=True)
    # The check before a prompt change (the improvement loop): a changed
    # prompt is installed only once it has passed its eval cases on the
    # model it will run on — or when told to (--force).
    paths0 = Paths(cfg, dt.date.today())
    blocked = []
    for job, name in JOB_AGENT.items():
        if not (agents / f"{name}.md").exists():
            continue                                  # a first install: nothing to compare
        new = prompt_version(name, REPO_PROMPTS)
        if new == prompt_version(name):
            continue
        if not any(c["job"] == job for c in evallib.load_cases(paths0.agent_dir)):
            print(f"note: no {job} eval cases yet, so the changed {name}.md is installed unchecked", file=sys.stderr)
            continue
        model, variant = job_model(cfg, job)
        if not evallib.passed(paths0.agent_dir, job, new, model_of(dict(cfg, model=model, variant=variant), name)):
            blocked.append(f"{name}.md (prompt {new})")
    if blocked and not args.force:
        raise Fail("not installed: " + ", ".join(blocked) + " changed and has not passed its eval cases on the "
                   "model it runs on. Run `longhand-agent eval run`, or install anyway with --force.")
    # The agent that answers in the margin, and the one that plans; both
    # with every tool denied.
    for name in ("longhand.md", "longhand-plan.md", "longhand-judge.md", "longhand-day.md"):
        (agents / name).write_text((here / "opencode" / name).read_text())
    dst = agents / "longhand.md"
    paths = Paths(cfg, dt.date.today())
    for d in (paths.agent_dir / "daily", paths.knowledge, paths.payloads, paths.cwd, paths.curriculum):
        if d is not None:
            d.mkdir(parents=True, exist_ok=True)
    print(f"agent definition → {dst}\nagent folder → {paths.agent_dir}\npayload log → {paths.payloads}")
    return 0


